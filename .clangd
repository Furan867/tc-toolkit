# clangd 的编译参数。
#
# 构建走 `simplexc/tools/build.py`（g++ -std=c++17 -O2 -Wall -Wextra -Wpedantic），没有
# `compile_commands.json`，所以 clangd 不知道 include 路径：`difftrace/` 里的
# `#include <unicorn/unicorn.h>` 会被判成文件不存在，然后级联报出几十个
# 「Unknown type name 'uc_engine'」——那些全是假的，`build.py difftrace` 是 0 error 0 warning。
#
# 这里只补 `-I`。**不补 `-std=` / `-D` / `-W`**：那些由 clangd 按文件推断，写死反而会
# 和实际构建用的参数不一致（两边不一致时诊断结论不可信）。
#
# Unicorn / Capstone 的 SDK 在 `work/tools/difftrace-deps/`，不入 git，由
# `simplexc/tools/difftrace/fetch_deps.py` 准备。尚未准备时这两条 `-I` 指向不存在的目录，
# clangd 只会提示「找不到目录」，不影响其它文件的诊断。
CompileFlags:
  Add:
    - -Isimplexc
    - -Iwork/tools/difftrace-deps/unicorn/include
    - -Iwork/tools/difftrace-deps/capstone/include
