; opt.ini 的模板 —— 复制一份成 opt.ini 再改（`cp opt.ini.example opt.ini`）。
;
; 为什么分成两个文件：opt.ini 是**运行时开关**，每做一次「对照实验」都要改它，
; 留在 git 里会让工作区长期显示为脏；模板则固定不变，适合跟踪。
;
; 产物改写器配置：转发层每次编译都会重新读 opt.ini —— 改完**下次编译生效**，
; 不用重启游戏。
;
; 切换方式：把 `;` 在下面四行之间搬一下，同一时刻只放开一行。
; 若多行都放开：取**第一个匹配行**生效（不报错）—— 转发层与改写器两处读到同一行，
; 与 `optimize_image.py` 的 `rewrite_mode()` 行为一致。
;
; 注意 `short` 是**不带 CSE 的纯缩短**（与已测的 8.05 MHz 同构），
; `short_cse` 才多删重复装载 —— 做前后对照时别把两者混为一谈。

[opt]
; compiler = 选实现：reference（默认；缺失键也兜底它）| ours | ours_with_fallback
;   ours              = 只用我们的实现（进程内调自研 C++ 编译器），失败返回错误、不转交
;   ours_with_fallback= ours 失败则整单转交 compile_real.dll
compiler = reference
; compiler = ours
; compiler = ours_with_fallback

; on        = 等长改写（窗口填一条多字节 nop，零重定位；实测 RV32IM +27.8%）
; short     = 缩短改写（窗口不填充、后续前移 + 重定位；实测 6.84 → 8.05 MHz）
; short_cse = 缩短改写 + 删重复装载（CSE；预期再 +~1.7%，低于主频波动）
; off       = 原样返回（恒等），用来做「对照实验」
rewrite = on
; rewrite = short
; rewrite = short_cse
; rewrite = off
