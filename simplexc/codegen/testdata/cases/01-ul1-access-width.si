// 引 `docs/facts/semantics.md` §U-L1：`load`/`store` 的 `p` 是**字节地址**（`p + Int k` 直接
// `add`，不乘元素宽度），访存宽度按位宽分段（`N ≤ 32` → `ceil(N/8)` 字节，`N > 32` → 8 字节），
// 对齐只声明 1、不插对齐检查/陷阱。
// 期望见 `01-ul1-access-width.irkeys`。
run_sim: while true {
  // N = 24：`ceil(24/8)` = 3 字节读写；地址 4104 + 8 = **4112**（+8 字节，不是 +8 个 24 位元素）
  store(U64 4104, load(<U24>, U64 4104 + 8))
  // N = 5 < 8：整字节访问（读 1 字节再掩到 5 位），写也只写 1 字节
  store(U64 4120, load(<U5>, U64 4112))
  // N = 64 > 32：8 字节读写
  store(U64 4128, load(<U64>, U64 4104))
  break
}
