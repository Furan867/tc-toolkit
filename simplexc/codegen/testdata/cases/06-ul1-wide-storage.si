// 引 `docs/facts/semantics.md` §U-L1：`N > 32` 的整型**一律按 8 字节访存**（不是 `ceil(N/8)` 的
// 5/6 字节）—— 实测见 `simplexc/dossier/ul_access_width.md` §7：改成 `store iN` 就与参考不一致。
// 而 `N` 以下的位仍要掩掉（`load` 的高位为 0），所以存储类型是 `i64`、掩码是 `(1<<33)-1`。
// 期望见 `06-ul1-wide-storage.irkeys`。
run_sim: while true {
  // N = 33：读 8 字节，掩到 33 位
  var v = load(<U33>, U64 4096)
  // 写也 8 字节（若退回 `ceil(33/8)` = 5 字节，这里会变成 `store i40`）
  store(U64 4104, v)
  break
}
