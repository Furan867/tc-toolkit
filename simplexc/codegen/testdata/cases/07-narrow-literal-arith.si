// 引 `docs/facts/semantics.md` §语义未验项的 `arith_ty` 一条（本轮实测补上）：算术运算符与
// **裸整数字面量**（`Int`，64 位）混合时，结果类型取**窄的那一侧** —— 所以 `U32 x * 65537`
// 截回 32 位、`U32 x << 40` 的移位量按 W=32 取模（`& 31`）。
// 期望见 `07-narrow-literal-arith.irkeys`。
run_sim: while true {
  // 运行期值（不是常量，折叠不进来）：U32
  var x = load(<U32>, U64 4096)
  // 乘完要截回 32 位 ⇒ `and i64 …, 4294967295`；若结果类型错成 Int(64) 这道掩码整条消失
  var y = x * 65537
  store(U64 4104, y)
  // 移位量按 W=32 取模，不是 64
  var z = x << 40
  store(U64 4112, z)
  break
}
