// 引 `docs/facts/semantics.md` §U-P 的优先级表：`+ - | ^ &` 是**同一档**、左结合（26 条判别式
// 对着参考产物实测）。这两条只在「同级左结合」下成立：
//   `3 + 2 & 1`  → (3+2)&1 = 1   （若 `&` 更紧会得 3）
//   `2 | 1 ^ 3`  → (2|1)^3 = 0   （若 `^` 更紧会得 2）
// `1 << 2 * 2` → (1<<2)*2 = 8   （若 `*` 更紧会得 16，这两档不同级）
// 全常量会被折成常量，所以断言的是折叠后的值而不是运算序列。期望见同名 `.irkeys`。
run_sim: while true {
  var p = 3 + 2 & 1
  var q = 2 | 1 ^ 3
  var r = 1 << 2 * 2
  store(U64 4104, U64 p)
  store(U64 4112, U64 q)
  store(U64 4120, U64 r)
  break
}
