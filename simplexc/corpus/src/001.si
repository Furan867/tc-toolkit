}

def ui_set_column_header_color(id: Str, value: Int) None {
    switch id
}

def ui_set_row_header_color(id: Str, value: Int) None {
    switch id
        case "table" { store(ui_buffer + 64, U64 value) }
}

def ui_set_text(id: Str, text: Str) None {
    switch id
        case "table[0][0]" { set_text(text, 10000) }
        case "table[0][1]" { set_text(text, 20000) }
        case "table[0][2]" { set_text(text, 30000) }
        case "table[1][0]" { set_text(text, 40000) }
        case "table[1][1]" { set_text(text, 50000) }
        case "table[1][2]" { set_text(text, 60000) }
        case "table[2][0]" { set_text(text, 70000) }
        case "table[2][1]" { set_text(text, 80000) }
        case "table[2][2]" { set_text(text, 90000) }
        case "table[3][0]" { set_text(text, 100000) }
        case "table[3][1]" { set_text(text, 110000) }
        case "table[3][2]" { set_text(text, 120000) }
        case "table[4][0]" { set_text(text, 130000) }
        case "table[4][1]" { set_text(text, 140000) }
        case "table[4][2]" { set_text(text, 150000) }
        case "table[5][0]" { set_text(text, 160000) }
        case "table[5][1]" { set_text(text, 170000) }
        case "table[5][2]" { set_text(text, 180000) }
}

def ui_set_image_name(id: Str, text: Str) None {
    switch id
}

def ui_set_instruction(index: Int, code: Int, pointer: Int) None {
    switch index
}
def add_keyboard_value(key_down: Bool, key: U8) None {
    let value = U16 key_down | (U16 key) << 8
    var index = load(<U16>, #SIMULATION_KEYBOARD_CHARACTER + 4098)
    store(#SIMULATION_KEYBOARD_CHARACTER + index, value)
    store(#SIMULATION_KEYBOARD_CHARACTER + 4098, (index + 8) % 4096)

}
def get_last_time() Int { return Int time_component_last }
def get_screen_connection(screen_name: Str) Str {
}
def get_memory(label: Str) Int { 
}
def get_load_port_input(label: Str) Int { 
}
def get_screen_settings(label: Str, index: Int) Int { 
}
def get_output(user_label: Str, index: Int) Int { 
    if user_label == "Carry in" && index == 0 { return Int (U64 load(<U1>, #SIMULATION_STATE + 1)) }
    if user_label == "A" && index == 0 { return Int (U64 load(<U8>, #SIMULATION_STATE + 1)) }
    if user_label == "B" && index == 0 { return Int (U64 load(<U8>, #SIMULATION_STATE + 1)) }
}
def get_ram_value(label: Str, address: Int, size: @Size) @Size {
}
def set_ram_value(label: Str, offset: Int, value: @Type) None {
}

const #CYCLE_PAST_FAIL = 0
def max(a: TestResult, b: TestResult) TestResult {
    return TestResult max(U64 a, U64 b)
}

def set_error(input: Str) None {

    let len = input.len()

    store(error_buffer, U16 len)

    var i = 0
    while i < len {
        store(error_buffer + i + 2, U8 input[i])
        i += 1
    }
}


var cycle = -1
var last_command_id = U64 0
var last_level_manual_input = U64 0
var time_component_last = U64 0

def reset_sim() None {

    time_component_last = U64 0

    set_error("")

    global_seed = Seed (get_command(ctl_test) + 1) // 0 can't be seed

    last_level_manual_input = 0
    set_setting(sim_cycle, #U64_HIGH) // -1
    set_setting(sim_short_circuit_component_id_1, U64 0)
    set_setting(sim_short_circuit_component_id_2, U64 0)
    set_setting(sim_test_result, U64 pass)
    cycle = -1

  
    memory_clear(#SIMULATION_KEYBOARD_CHARACTER, 8192)
    memory_clear(#SIMULATION_KEYBOARD_COORDINATE, 8192)
    memory_clear(#SIMULATION_STATE, 1375)


}

type Input Struct {
    carry_in: U1,
    a: U8,
    b: U8,
}

type Output Struct {
    output: U8,
    output_is_z: Bool,
    carry_out: U1,
    carry_out_is_z: Bool,
}

var level_input = Input {}
var level_output = Output {}

