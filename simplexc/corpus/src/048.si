def ui_set_text(id: Str, text: Str) None {
    switch id
        case "table[0][0]" { set_text(text, 10000) }
        case "table[0][1]" { set_text(text, 20000) }
        case "table[0][2]" { set_text(text, 30000) }
        case "table[1][0]" { set_text(text, 40000) }
        case "table[1][1]" { set_text(text, 50000) }
        case "table[1][2]" { set_text(text, 60000) }
        case "table[2][0]" { set_text(text, 70000) }
        case "table[2][1]" { set_text(text, 80000) }
        case "table[2][2]" { set_text(text, 90000) }
        case "table[3][0]" { set_text(text, 100000) }
        case "table[3][1]" { set_text(text, 110000) }
        case "table[3][2]" { set_text(text, 120000) }
        case "table[4][0]" { set_text(text, 130000) }
        case "table[4][1]" { set_text(text, 140000) }
        case "table[4][2]" { set_text(text, 150000) }
        case "table[5][0]" { set_text(text, 160000) }
        case "table[5][1]" { set_text(text, 170000) }
        case "table[5][2]" { set_text(text, 180000) }
}

def ui_set_image_name(id: Str, text: Str) None {
    switch id
}

def ui_set_instruction(index: Int, code: Int, pointer: Int) None {
    switch index
}
def add_keyboard_value(key_down: Bool, key: U8) None {
    let value = U16 key_down | (U16 key) << 8
    var index = load(<U16>, #SIMULATION_KEYBOARD_CHARACTER + 4098)
    store(#SIMULATION_KEYBOARD_CHARACTER + index, value)
    store(#SIMULATION_KEYBOARD_CHARACTER + 4098, (index + 8) % 4096)

}
def get_last_time() Int { return Int time_component_last }
