const #CYCLE_PAST_FAIL = 0
def max(a: TestResult, b: TestResult) TestResult {
    return TestResult max(U64 a, U64 b)
}

def set_error(input: Str) None {

    let len = input.len()

    store(error_buffer, U16 len)

    var i = 0
    while i < len {
        store(error_buffer + i + 2, U8 input[i])
        i += 1
    }
}


var cycle = -1
var last_command_id = U64 0
var last_level_manual_input = U64 0
var time_component_last = U64 0

def reset_sim() None {

    time_component_last = U64 0

    set_error("")

    global_seed = Seed (get_command(ctl_test) + 1) // 0 can't be seed

    last_level_manual_input = 0
    set_setting(sim_cycle, #U64_HIGH) // -1
    set_setting(sim_short_circuit_component_id_1, U64 0)
    set_setting(sim_short_circuit_component_id_2, U64 0)
    set_setting(sim_test_result, U64 pass)
    cycle = -1

  
    memory_clear(#SIMULATION_KEYBOARD_CHARACTER, 8192)
    memory_clear(#SIMULATION_KEYBOARD_COORDINATE, 8192)
    memory_clear(#SIMULATION_STATE, 322)


}

type Input Struct {
    carry_in: U1,
    a: U8,
    b: U8,
}

type Output Struct {
    output: U8,
    output_is_z: Bool,
    carry_out: U1,
    carry_out_is_z: Bool,
}

var level_input = Input {}
var level_output = Output {}

def mode_refresh() None {

        


    // 2 com_level_input_word 1 2 Carry in
    let value_id298 = input_replay[0]
    store(#SIMULATION_STATE + 298, U1 (value_id298))
    store(#SIMULATION_STATE + 299, U1 (value_id298))
    


    // 3 com_level_input_word 8 1 A
    let value_id274 = input_replay[1]
    store(#SIMULATION_STATE + 274, U8 (value_id274))
    store(#SIMULATION_STATE + 275, U8 (value_id274))
    


    // 4 com_level_input_word 8 4257300573296473173 B
    let value_id256 = input_replay[2]
    store(#SIMULATION_STATE + 256, U8 (value_id256))
    store(#SIMULATION_STATE + 257, U8 (value_id256))
    


    // 22 com_nor_bit 2 3862493580917806815 
    let value_id320 = ~((U1 0x0) | (U1 0x0))
    store(#SIMULATION_STATE + 320, U1 (value_id320))
    


    // 21 com_nor_bit 2 2467585013027068551 
    let value_id319 = ~((U1 0x0) | (U1 0x0))
    store(#SIMULATION_STATE + 319, U1 (value_id319))
    


    // 20 com_nor_bit 2 4146618733523917390 
    let value_id318 = ~((U1 0x0) | (U1 0x0))
    store(#SIMULATION_STATE + 318, U1 (value_id318))
    


    // 19 com_nor_bit 2 7851206921307316344 
    let value_id317 = ~((U1 0x0) | (U1 0x0))
    store(#SIMULATION_STATE + 317, U1 (value_id317))
    


    // 18 com_nand_bit 2 3519256224320056959 
    let value_id316 = ~((U1 0x0) & (U1 0x0))
    store(#SIMULATION_STATE + 316, U1 (value_id316))
    


    // 7 com_splitter_bit_8 2 8691470194311084254 
    let input_7 = load(<U8>, #SIMULATION_STATE + 256)
    let value_id258 = input_7
    store(#SIMULATION_STATE + 258, U1 (value_id258))
    store(#SIMULATION_STATE + 259, U1 (value_id258))
    let value_id260 = (input_7 >> 1) & 1
    store(#SIMULATION_STATE + 260, U1 (value_id260))
    store(#SIMULATION_STATE + 261, U1 (value_id260))
    let value_id262 = (input_7 >> 2) & 1
    store(#SIMULATION_STATE + 262, U1 (value_id262))
    store(#SIMULATION_STATE + 263, U1 (value_id262))
    let value_id264 = (input_7 >> 3) & 1
    store(#SIMULATION_STATE + 264, U1 (value_id264))
    store(#SIMULATION_STATE + 265, U1 (value_id264))
    let value_id266 = (input_7 >> 4) & 1
    store(#SIMULATION_STATE + 266, U1 (value_id266))
    store(#SIMULATION_STATE + 267, U1 (value_id266))
    let value_id268 = (input_7 >> 5) & 1
    store(#SIMULATION_STATE + 268, U1 (value_id268))
    store(#SIMULATION_STATE + 269, U1 (value_id268))
    let value_id270 = (input_7 >> 6) & 1
    store(#SIMULATION_STATE + 270, U1 (value_id270))
    store(#SIMULATION_STATE + 271, U1 (value_id270))
    let value_id272 = (input_7 >> 7) & 1
    store(#SIMULATION_STATE + 272, U1 (value_id272))
    store(#SIMULATION_STATE + 273, U1 (value_id272))
    


    // 6 com_splitter_bit_8 2 3073349938438526925 
    let input_6 = load(<U8>, #SIMULATION_STATE + 274)
    let value_id276 = input_6
    store(#SIMULATION_STATE + 276, U1 (value_id276))
    store(#SIMULATION_STATE + 277, U1 (value_id276))
    let value_id278 = (input_6 >> 1) & 1
    store(#SIMULATION_STATE + 278, U1 (value_id278))
    store(#SIMULATION_STATE + 279, U1 (value_id278))
    let value_id280 = (input_6 >> 2) & 1
    store(#SIMULATION_STATE + 280, U1 (value_id280))
    store(#SIMULATION_STATE + 281, U1 (value_id280))
    let value_id282 = (input_6 >> 3) & 1
    store(#SIMULATION_STATE + 282, U1 (value_id282))
    store(#SIMULATION_STATE + 283, U1 (value_id282))
    let value_id284 = (input_6 >> 4) & 1
    store(#SIMULATION_STATE + 284, U1 (value_id284))
    store(#SIMULATION_STATE + 285, U1 (value_id284))
    let value_id286 = (input_6 >> 5) & 1
    store(#SIMULATION_STATE + 286, U1 (value_id286))
    store(#SIMULATION_STATE + 287, U1 (value_id286))
    let value_id288 = (input_6 >> 6) & 1
    store(#SIMULATION_STATE + 288, U1 (value_id288))
    store(#SIMULATION_STATE + 289, U1 (value_id288))
    let value_id290 = (input_6 >> 7) & 1
    store(#SIMULATION_STATE + 290, U1 (value_id290))
    store(#SIMULATION_STATE + 291, U1 (value_id290))
    


    // 9 com_and_bit 2 2664724444420813015 
    let value_id292 = load(<U1>, #SIMULATION_STATE + 260) & load(<U1>, #SIMULATION_STATE + 278)
    store(#SIMULATION_STATE + 292, U1 (value_id292))
    store(#SIMULATION_STATE + 293, U1 (value_id292))
    


    // 8 com_or_bit 2 1006966847424782486 
    let value_id294 = load(<U1>, #SIMULATION_STATE + 260) | load(<U1>, #SIMULATION_STATE + 278)
    store(#SIMULATION_STATE + 294, U1 (value_id294))
    store(#SIMULATION_STATE + 295, U1 (value_id294))
    


    // 14 com_switch_bit 2 7915375263959010957 
    store(#SIMULATION_STATE + 307, U1  0)
    store(#SIMULATION_STATE + 306, U1 0)
    store(#SIMULATION_STATE + 308, U1 0)
    var vid307 = U1  0
    var and_field_id307 = ~vid307
    var component_id_id307 = 0
    var component_top_id_id307 = 0
    var pin_index_id307 = 0
    if load(<U1>, #SIMULATION_STATE + 292) != 0 {
        let value = U1 (U1 (load(<U1>, #SIMULATION_STATE + 294)))
        if component_id_id307 != 0 && vid307 != value {
            set_setting(sim_short_circuit_component_id_1, U64 component_id_id307)
            set_setting(sim_short_circuit_component_id_2, U64 14)
            set_setting(sim_short_circuit_pin_1, U64 pin_index_id307)
            set_setting(sim_short_circuit_pin_2, U64 0)
            set_setting(sim_short_circuit_top_level_permanent_id_1, U64 component_top_id_id307)
            set_setting(sim_short_circuit_top_level_permanent_id_2, U64 0)
            set_setting(sim_short_circuit_any_top_level_wire_id, U64 68)
            set_setting(sim_short_circuit_value_1, U64 vid307)
            set_setting(sim_short_circuit_value_2, U64 value)
        }
        vid307 |= value
        and_field_id307 &= value
        store(#SIMULATION_STATE + 307, value)
        store(#SIMULATION_STATE + 309, value)
        component_id_id307 = 14
        component_top_id_id307 = 0
        pin_index_id307 = 0
        store(#SIMULATION_STATE + 306, U8 1)
        store(#SIMULATION_STATE + 308, U8 1)
    }
    


    // 10 com_and_bit 2 2100406122222321486 
    let value_id296 = load(<U1>, #SIMULATION_STATE + 258) & load(<U1>, #SIMULATION_STATE + 276)
    store(#SIMULATION_STATE + 296, U1 (value_id296))
    store(#SIMULATION_STATE + 297, U1 (value_id296))
    


    // 15 com_switch_bit 2 2769985828283679526 
    if load(<U1>, #SIMULATION_STATE + 296) != 0 {
        let value = U1 (U1 (load(<U1>, #SIMULATION_STATE + 294)))
        if component_id_id307 != 0 && vid307 != value {
            set_setting(sim_short_circuit_component_id_1, U64 component_id_id307)
            set_setting(sim_short_circuit_component_id_2, U64 15)
            set_setting(sim_short_circuit_pin_1, U64 pin_index_id307)
            set_setting(sim_short_circuit_pin_2, U64 0)
            set_setting(sim_short_circuit_top_level_permanent_id_1, U64 component_top_id_id307)
            set_setting(sim_short_circuit_top_level_permanent_id_2, U64 0)
            set_setting(sim_short_circuit_any_top_level_wire_id, U64 68)
            set_setting(sim_short_circuit_value_1, U64 vid307)
            set_setting(sim_short_circuit_value_2, U64 value)
        }
        vid307 |= value
        and_field_id307 &= value
        store(#SIMULATION_STATE + 307, value)
        store(#SIMULATION_STATE + 311, value)
        component_id_id307 = 15
        component_top_id_id307 = 0
        pin_index_id307 = 0
        store(#SIMULATION_STATE + 306, U8 1)
        store(#SIMULATION_STATE + 310, U8 1)
    }
    


    // 13 com_not_bit 2 6804422337348765736 
    let value_id300 = (U1 ~load(<U1>, #SIMULATION_STATE + 298))
    store(#SIMULATION_STATE + 300, U1 (value_id300))
    store(#SIMULATION_STATE + 301, U1 (value_id300))
    


    // 12 com_and_bit 2 5315165399256379165 
    let value_id302 = load(<U1>, #SIMULATION_STATE + 298) & load(<U1>, #SIMULATION_STATE + 258)
    store(#SIMULATION_STATE + 302, U1 (value_id302))
    store(#SIMULATION_STATE + 303, U1 (value_id302))
    


    // 17 com_switch_bit 2 5845494106242830130 
    if load(<U1>, #SIMULATION_STATE + 302) != 0 {
        let value = U1 (U1 (load(<U1>, #SIMULATION_STATE + 294)))
        if component_id_id307 != 0 && vid307 != value {
            set_setting(sim_short_circuit_component_id_1, U64 component_id_id307)
            set_setting(sim_short_circuit_component_id_2, U64 17)
            set_setting(sim_short_circuit_pin_1, U64 pin_index_id307)
            set_setting(sim_short_circuit_pin_2, U64 0)
            set_setting(sim_short_circuit_top_level_permanent_id_1, U64 component_top_id_id307)
            set_setting(sim_short_circuit_top_level_permanent_id_2, U64 0)
            set_setting(sim_short_circuit_any_top_level_wire_id, U64 68)
            set_setting(sim_short_circuit_value_1, U64 vid307)
            set_setting(sim_short_circuit_value_2, U64 value)
        }
        vid307 |= value
        and_field_id307 &= value
        store(#SIMULATION_STATE + 307, value)
        store(#SIMULATION_STATE + 315, value)
        component_id_id307 = 17
        component_top_id_id307 = 0
        pin_index_id307 = 0
        store(#SIMULATION_STATE + 306, U8 1)
        store(#SIMULATION_STATE + 314, U8 1)
