    // 0 com_none 2 0 
    


    // 1 com_level_output_word 8 3 Output
    


    // 5 com_level_output_word 1 2340322686578998678 Carry out

}

def mode_run(target_cycle: Int) None {

    if get_setting(sim_test_result) == U64 win { return }
    if (get_setting(sim_test_result) == U64 fail && cycle + 1 >= #CYCLE_PAST_FAIL) { return }
    if get_setting(sim_short_circuit_component_id_1) != 0 { return }

    var halt_run = false

    var original_start_time = Time 0
    var orig_start_cycle = U64 cycle
    var last_time = original_start_time

    var burst_cycles = 1

    var nanos_per_cycle = U64 0

    var i = 0
    var last_target_speed = U64 0
    var speed = U64 1

    while get_command(ctl_command_id) == last_command_id && !halt_run && target_cycle > cycle {
        i += 1

        let target_speed = max(1, get_command(ctl_cycle_speed_ms))

        if target_speed != last_target_speed {

            original_start_time = get_time()
            orig_start_cycle = U64 cycle
            last_time = original_start_time

            speed = min(U64 get_command(ctl_cycle_speed_ms), 10000000000000) // Cap at 10 ghz to avoid overflow
            last_target_speed = target_speed

        }

        let cycles_at_start = cycle
        let burst_target = cycle + burst_cycles

        var burst_target_cycle = min(target_cycle, burst_target)

        def halt() None {

            burst_target_cycle = cycle
            halt_run = true

        }

        def handle_test_result(result: TestResult) None {

            if result != pass {

                var res = result

                halt() // Halt regardless of wether we are above '#CYCLE_PAST_FAIL'

                set_setting(sim_test_result, max(get_setting(sim_test_result), U64 res))

            }

        }

        while cycle < burst_target_cycle {

            if in_scope("get_input") {
                level_input = get_input(cycle + 1)
            }
            

            


            // 2 com_level_input_word 1 2 Carry in
            var vid298 = U1 level_input.carry_in
            input_replay[0] = U64 level_input.carry_in
            


            // 3 com_level_input_word 8 1 A
            var vid274 = U8 level_input.a
            input_replay[1] = U64 level_input.a
            


            // 4 com_level_input_word 8 4257300573296473173 B
            var vid256 = U8 level_input.b
            input_replay[2] = U64 level_input.b
            


            // 22 com_nor_bit 2 3862493580917806815 
            var vid320 = U1 ~((U1 0x0) | (U1 0x0))
            


            // 21 com_nor_bit 2 2467585013027068551 
            var vid319 = U1 ~((U1 0x0) | (U1 0x0))
            


            // 20 com_nor_bit 2 4146618733523917390 
            var vid318 = U1 ~((U1 0x0) | (U1 0x0))
            


            // 19 com_nor_bit 2 7851206921307316344 
            var vid317 = U1 ~((U1 0x0) | (U1 0x0))
            


            // 18 com_nand_bit 2 3519256224320056959 
            var vid316 = U1 ~((U1 0x0) & (U1 0x0))
            


            // 7 com_splitter_bit_8 2 8691470194311084254 
            let input_7 = (U8 vid256)
            var vid258 = U1 input_7
            var vid260 = U1 (input_7 >> 1) & 1
            var vid262 = U1 (input_7 >> 2) & 1
            var vid264 = U1 (input_7 >> 3) & 1
            var vid266 = U1 (input_7 >> 4) & 1
            var vid268 = U1 (input_7 >> 5) & 1
            var vid270 = U1 (input_7 >> 6) & 1
            var vid272 = U1 (input_7 >> 7) & 1
            


            // 6 com_splitter_bit_8 2 3073349938438526925 
            let input_6 = (U8 vid274)
            var vid276 = U1 input_6
            var vid278 = U1 (input_6 >> 1) & 1
            var vid280 = U1 (input_6 >> 2) & 1
            var vid282 = U1 (input_6 >> 3) & 1
            var vid284 = U1 (input_6 >> 4) & 1
            var vid286 = U1 (input_6 >> 5) & 1
            var vid288 = U1 (input_6 >> 6) & 1
            var vid290 = U1 (input_6 >> 7) & 1
            


            // 9 com_and_bit 2 2664724444420813015 
            var vid292 = U1 (U1 vid260) & (U1 vid278)
            


            // 8 com_or_bit 2 1006966847424782486 
            var vid294 = U1 (U1 vid260) | (U1 vid278)
            


            // 14 com_switch_bit 2 7915375263959010957 
            var vid307 = U1 0
            var and_field_id307 = ~vid307
            if (U1 vid292) != 0 {
                vid307 |= U1  (U1 ((U1 vid294)))
                and_field_id307 &= U1  (U1 ((U1 vid294)))
            }
            


            // 10 com_and_bit 2 2100406122222321486 
            var vid296 = U1 (U1 vid258) & (U1 vid276)
            


            // 15 com_switch_bit 2 2769985828283679526 
            if (U1 vid296) != 0 {
                vid307 |= U1  (U1 ((U1 vid294)))
                and_field_id307 &= U1  (U1 ((U1 vid294)))
            }
            


            // 13 com_not_bit 2 6804422337348765736 
            var vid300 = U1 (U1 ~(U1 vid298))
            


            // 12 com_and_bit 2 5315165399256379165 
            var vid302 = U1 (U1 vid298) & (U1 vid258)
            


            // 17 com_switch_bit 2 5845494106242830130 
            if (U1 vid302) != 0 {
                vid307 |= U1  (U1 ((U1 vid294)))
                and_field_id307 &= U1  (U1 ((U1 vid294)))
            }
            


            // 11 com_and_bit 2 3877517839863069426 
            var vid304 = U1 (U1 vid298) & (U1 vid276)
            


            // 16 com_switch_bit 2 3371042285766248890 
            if (U1 vid304) != 0 {
                vid307 |= U1  (U1 ((U1 vid294)))
                and_field_id307 &= U1  (U1 ((U1 vid294)))
            }
            if vid307 > and_field_id307 {
                halt()
            }
            let zid307 = vid307 >= and_field_id307
            


            // 0 com_none 2 0 
            


            // 1 com_level_output_word 8 3 Output
            level_output.output = U8 ((U8 0x0))
            level_output.output_is_z = true
            


            // 5 com_level_output_word 1 2340322686578998678 Carry out
            level_output.carry_out = U1 ((U1 0x0))
            level_output.carry_out_is_z = true

    



            if in_scope("check_output") {
                let result = check_output(cycle + 1, level_input, level_output)
                handle_test_result(result)
            }

            
            cycle += 1 // Do this late as it signals to the front end that it can update

        }

        set_setting(sim_cycle, U64 cycle)

        let time_now = get_time()

        let time_diff = U64 (time_now - last_time)

        nanos_per_cycle = time_diff / U64 burst_cycles

        if time_now - last_time > 33.ms() {

            // Burst took too long
            burst_cycles = max(1, burst_cycles - 1)

        } else {

            // Burst was too fast
            burst_cycles = burst_cycles + 1

        }

        #if in_scope("on_ui_update"){

            on_ui_update(level_input, level_output)

        }

        last_time = time_now


        def get_target_cycle(time_now: Time) U64 {
            let time_diff = U64 (time_now - original_start_time)
            return orig_start_cycle + ((time_diff / 1000000) * speed) / 1000000 // Double divide to prevent overflow
        }

        var run_target_cycle = get_target_cycle(time_now)

        // Sleep any ahead of time away
        while cycle > Int run_target_cycle && get_command(ctl_command_id) == last_command_id {

            sleep(1.ms())
            cycle -= 1
            mode_refresh()
            cycle += 1

            run_target_cycle = get_target_cycle(get_time())

        }

    }

}

var manual_input_seen = false

run_sim: while true {

    reset_sim()

    
    def get_binary_repr(value: Int, size: Int) Str {
        var text = ""
        var i = size - 1
        while i >= 0 {
            if ((value >> i) & 1) == 0 {
                text += "[F]"
            } else {
                text += "[T]"
            }
            i -= 1
        }
        return text
    }
    
    def get_input(cycle: Int) Input {
    
    
        // 17 bit RNG
        var x = cycle
        x ^= x << 6
        x ^= x >> 11
        x ^= x << 9
    
        let input = Input {
            a: U8 (x & 0xff),
            b: U8 ((x >> 8) & 0xff),
            carry_in: U1 (x >> 16) & 1,
        }
    
        ui_set_text("table[0][1]", `{input.a}`)
        ui_set_text("table[0][2]", `[right]{get_binary_repr(Int input.a, 8)}[/right]`)
    
        ui_set_text("table[1][1]", `{input.b}`)
        ui_set_text("table[1][2]", `[right]{get_binary_repr(Int input.b, 8)}[/right]`)
    
        ui_set_text("table[2][1]", `{input.carry_in}`)
        ui_set_text("table[2][2]", `[right]{get_binary_repr(Int input.carry_in, 1)}[/right]`)
    
        let value = Int (U64 input.a + U64 input.b + U64 input.carry_in)
        ui_set_text("table[3][1]", `{value}`)
        ui_set_text("table[3][2]", `[right]    {get_binary_repr(value >> 8, 1)}    {get_binary_repr(value, 8)}[/right]`)
    
        return input
    }
    
    def check_output(cycle: Int, input: Input, output: Output) TestResult {
    
        if output.output_is_z {
            ui_set_text("table[4][1]", `[Z]`)
            ui_set_text("table[4][2]", `[right]    [Z]    [Z][Z][Z][Z][Z][Z][Z][Z][/right]`)
            set_error(`输出不应为空（高阻态）`)
            return fail
        }
    
        ui_set_text("table[4][1]", `{Int output.carry_out << 8 | Int output.output}`)
        ui_set_text("table[4][2]", `[right]    {get_binary_repr(Int output.carry_out, 1)}    {get_binary_repr(Int output.output, 8)}[/right]`)
    
        var sum = Int input.a + Int input.b + Int input.carry_in
        var car = Int (U64 (sum > 0xff))
    
        if Int output.output != (Int sum & 0xff) {
            return fail
        }
    
        if Int output.carry_out != car {
            return fail
        }
    
        if cycle == 0x1ffff {
            return win
        }
    
    }
    
    while true {

        mode_refresh()

        #if in_scope("on_ui_update"){

            on_ui_update(level_input, level_output)

        }

        while get_command(ctl_command_id) == last_command_id {

            #if in_scope("on_manual_input"){

                if last_level_manual_input != get_command(ctl_level_manual_input_id) {

                    last_level_manual_input = get_command(ctl_level_manual_input_id)
                    on_manual_input(Int get_command(ctl_level_manual_input))
                    manual_input_seen = true

                }

            }

            sleep(1.ms())

        }

        if manual_input_seen {

            manual_input_seen = false
            break

        }

        last_command_id = get_command(ctl_command_id) // Read this before the command in case of race condition
        set_setting(sim_last_command_id, last_command_id)
        var command = SimCommand get_command(ctl_command)

        switch command

            case run {

                var target_cycle = Int get_setting(sim_target_cycle)

                set_setting(sim_running, U64 1)
                mode_run(target_cycle)
                set_setting(sim_running, U64 0)

            }

            case refresh {}

            case mode_reset {

                var i = 0
                while i < 1024 {
                    input_replay[i] = ctl_input_replay_reset[i]
                    i += 1
                }

                break

            }

            case quit_simulation {

                break run_sim // We need to break out instead of thread_exit() to make sure everything is cleaned up

            }

    }

}

