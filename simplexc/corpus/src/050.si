    store(#SIMULATION_STATE + 304, U1 (value_id304))
    store(#SIMULATION_STATE + 305, U1 (value_id304))
    


    // 16 com_switch_bit 2 3371042285766248890 
    if load(<U1>, #SIMULATION_STATE + 304) != 0 {
        let value = U1 (U1 (load(<U1>, #SIMULATION_STATE + 294)))
        if component_id_id307 != 0 && vid307 != value {
            set_setting(sim_short_circuit_component_id_1, U64 component_id_id307)
            set_setting(sim_short_circuit_component_id_2, U64 16)
            set_setting(sim_short_circuit_pin_1, U64 pin_index_id307)
            set_setting(sim_short_circuit_pin_2, U64 0)
