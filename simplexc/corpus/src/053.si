    store(#SIMULATION_STATE + 269, U1 (value_id268))
    let value_id270 = (input_7 >> 6) & 1
    store(#SIMULATION_STATE + 270, U1 (value_id270))
    store(#SIMULATION_STATE + 271, U1 (value_id270))
    let value_id272 = (input_7 >> 7) & 1
    store(#SIMULATION_STATE + 272, U1 (value_id272))
