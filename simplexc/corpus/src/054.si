            set_setting(sim_short_circuit_component_id_1, U64 component_id_id411)
            set_setting(sim_short_circuit_component_id_2, U64 19)
            set_setting(sim_short_circuit_pin_1, U64 pin_index_id411)
            set_setting(sim_short_circuit_pin_2, U64 0)
