var settings                          = Ptr 2416573415424
var input_replay                      = raw_cast(<Arr[U64]>, 2416573480960)
var output_history_pins               = Ptr 2416576167936
var error_buffer                      = Ptr 2416633315328
var ui_buffer                         = Ptr 2416633380864
var ctl_input_replay_reset            = raw_cast(<Arr[U64]>, 2416636067840)

