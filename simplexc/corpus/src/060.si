            let input_32 = (U8 vid260)
            var vid262 = U1 input_32
            var vid264 = U1 (input_32 >> 1) & 1
            var vid266 = U1 (input_32 >> 2) & 1
            var vid268 = U1 (input_32 >> 3) & 1
            var vid270 = U1 (input_32 >> 4) & 1
            var vid272 = U1 (input_32 >> 5) & 1
            var vid274 = U1 (input_32 >> 6) & 1
            var vid276 = U1 (input_32 >> 7) & 1
            


            // 4 com_switch_bit 2 2758190499166714597 
            var vid281 = U1 0
            var and_field_id281 = ~vid281
            if (U1 vid274) != 0 {
