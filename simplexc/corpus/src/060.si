                vid347 |= U1  (U1 ((U1 vid256)))
                and_field_id347 &= U1  (U1 ((U1 vid256)))
            }
            if vid347 > and_field_id347 {
                halt()
            }
            let zid347 = vid347 >= and_field_id347
            


            // 11 com_xor_bit 2 7906299319301070039 
