            }
            


            // 22 com_switch_bit 2 6781157912064297227 
            var vid331 = U1 0
            var and_field_id331 = ~vid331
            if (U1 vid272) != 0 {
                vid331 |= U1  (U1 ((U1 vid256)))
                and_field_id331 &= U1  (U1 ((U1 vid256)))
            }
            


            // 12 com_switch_bit 2 2785653534781774430 
