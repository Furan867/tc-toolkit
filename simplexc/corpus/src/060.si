                vid331 |= U1  (U1 ((U1 vid256)))
                and_field_id331 &= U1  (U1 ((U1 vid256)))
            }
            


            // 26 com_switch_bit 2 2988715545850030758 
            if (U1 vid264) != 0 {
                vid347 |= U1  (U1 ((U1 vid256)))
                and_field_id347 &= U1  (U1 ((U1 vid256)))
            }
            


            // 15 com_switch_bit 2 3369164442854146515 
            if (U1 vid264) != 0 {
                vid299 |= U1  (U1 ((U1 vid256)))
                and_field_id299 &= U1  (U1 ((U1 vid256)))
            }
            


            // 14 com_switch_bit 2 7214817734725957114 
            var vid323 = U1 0
            var and_field_id323 = ~vid323
            if (U1 vid264) != 0 {
                vid323 |= U1  (U1 ((U1 vid256)))
                and_field_id323 &= U1  (U1 ((U1 vid256)))
            }
            


            // 10 com_switch_bit 2 3194153354277812434 
            if (U1 vid264) != 0 {
                vid281 |= U1  (U1 ((U1 vid258)))
                and_field_id281 &= U1  (U1 ((U1 vid258)))
            }
            


            // 9 com_switch_bit 2 6426225205861791476 
            if (U1 vid264) != 0 {
                vid309 |= U1  (U1 ((U1 vid256)))
                and_field_id309 &= U1  (U1 ((U1 vid256)))
            }
            


            // 34 com_switch_bit 2 5770237473403093274 
            if (U1 vid262) != 0 {
                vid281 |= U1  (U1 ((U1 vid258)))
                and_field_id281 &= U1  (U1 ((U1 vid258)))
            }
            if vid281 > and_field_id281 {
                halt()
            }
            let zid281 = vid281 >= and_field_id281
            


            // 36 com_xor_bit 2 5742992352567537639 
            var vid296 = U1 (U1 vid276) ^ (U1 vid281)
            


            // 21 com_switch_bit 2 1084489889922510743 
            if (U1 vid262) != 0 {
                vid299 |= U1  (U1 ((U1 vid256)))
                and_field_id299 &= U1  (U1 ((U1 vid256)))
            }
            if vid299 > and_field_id299 {
                halt()
            }
            let zid299 = vid299 >= and_field_id299
            


            // 33 com_xor_bit 2 5770468871728869953 
            var vid306 = U1 (U1 vid299) ^ (U1 vid268)
            


            // 20 com_switch_bit 2 318652374451699508 
            if (U1 vid262) != 0 {
                vid309 |= U1  (U1 ((U1 vid256)))
                and_field_id309 &= U1  (U1 ((U1 vid256)))
            }
            if vid309 > and_field_id309 {
                halt()
            }
            let zid309 = vid309 >= and_field_id309
            


            // 13 com_xor_bit 2 8660486583082906299 
            var vid320 = U1 (U1 vid309) ^ (U1 vid272)
            


            // 16 com_switch_bit 2 255783009995817008 
            if (U1 vid262) != 0 {
                vid323 |= U1  (U1 ((U1 vid256)))
                and_field_id323 &= U1  (U1 ((U1 vid256)))
            }
            if vid323 > and_field_id323 {
                halt()
            }
            let zid323 = vid323 >= and_field_id323
            


            // 7 com_xor_bit 2 3938733900279844748 
            var vid328 = U1 (U1 vid323) ^ (U1 vid266)
            


            // 8 com_switch_bit 2 2986221281467929663 
            if (U1 vid262) != 0 {
                vid331 |= U1  (U1 ((U1 vid256)))
                and_field_id331 &= U1  (U1 ((U1 vid256)))
            }
            if vid331 > and_field_id331 {
                halt()
            }
            let zid331 = vid331 >= and_field_id331
            


            // 37 com_xor_bit 2 3569434327328331808 
            var vid344 = U1 (U1 vid331) ^ (U1 vid274)
            


            // 6 com_switch_bit 2 6951202922927196541 
