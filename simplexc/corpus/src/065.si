def get_output(user_label: Str, index: Int) Int { 
    if user_label == "Input select" && index == 0 { return Int (U64 load(<U1>, #SIMULATION_STATE + 1)) }
    if user_label == "A" && index == 0 { return Int (U64 load(<U8>, #SIMULATION_STATE + 1)) }
    if user_label == "B" && index == 0 { return Int (U64 load(<U8>, #SIMULATION_STATE + 1)) }
    if user_label == "Output select" && index == 0 { return Int (U64 load(<U1>, #SIMULATION_STATE + 1)) }
}
