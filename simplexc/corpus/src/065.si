const #CYCLE_PAST_FAIL = 0
def max(a: TestResult, b: TestResult) TestResult {
    return TestResult max(U64 a, U64 b)
}

def set_error(input: Str) None {

    let len = input.len()

    store(error_buffer, U16 len)

    var i = 0
    while i < len {
        store(error_buffer + i + 2, U8 input[i])
        i += 1
    }
}


var cycle = -1
var last_command_id = U64 0
var last_level_manual_input = U64 0
var time_component_last = U64 0

def reset_sim() None {

    time_component_last = U64 0

    set_error("")

    global_seed = Seed (get_command(ctl_test) + 1) // 0 can't be seed

    last_level_manual_input = 0
    set_setting(sim_cycle, #U64_HIGH) // -1
    set_setting(sim_short_circuit_component_id_1, U64 0)
    set_setting(sim_short_circuit_component_id_2, U64 0)
    set_setting(sim_test_result, U64 pass)
    cycle = -1

  
    memory_clear(#SIMULATION_KEYBOARD_CHARACTER, 8192)
    memory_clear(#SIMULATION_KEYBOARD_COORDINATE, 8192)
    memory_clear(#SIMULATION_STATE, 283)


}

type Input Struct {
    input_select: U1,
    a: U8,
    b: U8,
    output_select: U1,
}

type Output Struct {
    x: U8,
    x_is_z: Bool,
    y: U8,
    y_is_z: Bool,
}

var level_input = Input {}
var level_output = Output {}

def mode_refresh() None {

        


    // 1 com_level_input_1_pin 1 1 Input select
    let value_id264 = input_replay[0]
    store(#SIMULATION_STATE + 264, U1 (value_id264))
    store(#SIMULATION_STATE + 265, U1 (value_id264))
    


    // 4 com_level_input_word 8 2 A
    let value_id262 = input_replay[1]
    store(#SIMULATION_STATE + 262, U8 (value_id262))
    store(#SIMULATION_STATE + 263, U8 (value_id262))
    


    // 5 com_level_input_word 8 3 B
    let value_id260 = input_replay[2]
    store(#SIMULATION_STATE + 260, U8 (value_id260))
    store(#SIMULATION_STATE + 261, U8 (value_id260))
    


    // 6 com_level_input_1_pin 1 4 Output select
    let value_id256 = input_replay[3]
    store(#SIMULATION_STATE + 256, U1 (value_id256))
    store(#SIMULATION_STATE + 257, U1 (value_id256))
    


    // 12 com_not_bit 2 7299504381916939783 
    let value_id258 = (U1 ~load(<U1>, #SIMULATION_STATE + 256))
    store(#SIMULATION_STATE + 258, U1 (value_id258))
    store(#SIMULATION_STATE + 259, U1 (value_id258))
    


    // 11 com_not_bit 2 3047429092566680701 
    let value_id266 = (U1 ~load(<U1>, #SIMULATION_STATE + 264))
    store(#SIMULATION_STATE + 266, U1 (value_id266))
    store(#SIMULATION_STATE + 267, U1 (value_id266))
    


    // 7 com_switch_word 8 1863076128768517044 
    store(#SIMULATION_STATE + 269, U8  0)
    store(#SIMULATION_STATE + 268, U1 0)
    store(#SIMULATION_STATE + 270, U1 0)
    var vid269 = U8  0
    var and_field_id269 = ~vid269
    var component_id_id269 = 0
    var component_top_id_id269 = 0
    var pin_index_id269 = 0
    if load(<U1>, #SIMULATION_STATE + 266) != 0 {
        let value = U8 (U8 (load(<U8>, #SIMULATION_STATE + 262)))
        if component_id_id269 != 0 && vid269 != value {
            set_setting(sim_short_circuit_component_id_1, U64 component_id_id269)
            set_setting(sim_short_circuit_component_id_2, U64 7)
            set_setting(sim_short_circuit_pin_1, U64 pin_index_id269)
            set_setting(sim_short_circuit_pin_2, U64 0)
            set_setting(sim_short_circuit_top_level_permanent_id_1, U64 component_top_id_id269)
            set_setting(sim_short_circuit_top_level_permanent_id_2, U64 0)
            set_setting(sim_short_circuit_any_top_level_wire_id, U64 5)
            set_setting(sim_short_circuit_value_1, U64 vid269)
            set_setting(sim_short_circuit_value_2, U64 value)
        }
        vid269 |= value
        and_field_id269 &= value
        store(#SIMULATION_STATE + 269, value)
        store(#SIMULATION_STATE + 271, value)
        component_id_id269 = 7
        component_top_id_id269 = 0
        pin_index_id269 = 0
        store(#SIMULATION_STATE + 268, U8 1)
        store(#SIMULATION_STATE + 270, U8 1)
    }
    


    // 8 com_switch_word 8 6758026184179601959 
    if load(<U1>, #SIMULATION_STATE + 264) != 0 {
        let value = U8 (U8 (load(<U8>, #SIMULATION_STATE + 260)))
        if component_id_id269 != 0 && vid269 != value {
            set_setting(sim_short_circuit_component_id_1, U64 component_id_id269)
            set_setting(sim_short_circuit_component_id_2, U64 8)
            set_setting(sim_short_circuit_pin_1, U64 pin_index_id269)
            set_setting(sim_short_circuit_pin_2, U64 0)
            set_setting(sim_short_circuit_top_level_permanent_id_1, U64 component_top_id_id269)
            set_setting(sim_short_circuit_top_level_permanent_id_2, U64 0)
            set_setting(sim_short_circuit_any_top_level_wire_id, U64 5)
            set_setting(sim_short_circuit_value_1, U64 vid269)
            set_setting(sim_short_circuit_value_2, U64 value)
        }
        vid269 |= value
        and_field_id269 &= value
        store(#SIMULATION_STATE + 269, value)
        store(#SIMULATION_STATE + 273, value)
        component_id_id269 = 8
        component_top_id_id269 = 0
        pin_index_id269 = 0
        store(#SIMULATION_STATE + 268, U8 1)
        store(#SIMULATION_STATE + 272, U8 1)
    }
    


    // 10 com_switch_word 8 4634184952721724460 
    store(#SIMULATION_STATE + 275, U8  0)
    store(#SIMULATION_STATE + 274, U1 0)
    store(#SIMULATION_STATE + 276, U1 0)
    var vid275 = U8  0
    var and_field_id275 = ~vid275
    var component_id_id275 = 0
    var component_top_id_id275 = 0
    var pin_index_id275 = 0
    if load(<U1>, #SIMULATION_STATE + 256) != 0 {
        let value = U8 (U8 (load(<U8>, #SIMULATION_STATE + 269)))
        if component_id_id275 != 0 && vid275 != value {
            set_setting(sim_short_circuit_component_id_1, U64 component_id_id275)
            set_setting(sim_short_circuit_component_id_2, U64 10)
            set_setting(sim_short_circuit_pin_1, U64 pin_index_id275)
            set_setting(sim_short_circuit_pin_2, U64 0)
            set_setting(sim_short_circuit_top_level_permanent_id_1, U64 component_top_id_id275)
            set_setting(sim_short_circuit_top_level_permanent_id_2, U64 0)
            set_setting(sim_short_circuit_any_top_level_wire_id, U64 16)
            set_setting(sim_short_circuit_value_1, U64 vid275)
            set_setting(sim_short_circuit_value_2, U64 value)
        }
        vid275 |= value
        and_field_id275 &= value
        store(#SIMULATION_STATE + 275, value)
        store(#SIMULATION_STATE + 277, value)
        component_id_id275 = 10
        component_top_id_id275 = 0
        pin_index_id275 = 0
        store(#SIMULATION_STATE + 274, U8 1)
        store(#SIMULATION_STATE + 276, U8 1)
    }
    


    // 9 com_switch_word 8 2677329545972473937 
    store(#SIMULATION_STATE + 279, U8  0)
    store(#SIMULATION_STATE + 278, U1 0)
    store(#SIMULATION_STATE + 280, U1 0)
    var vid279 = U8  0
    var and_field_id279 = ~vid279
    var component_id_id279 = 0
    var component_top_id_id279 = 0
    var pin_index_id279 = 0
    if load(<U1>, #SIMULATION_STATE + 258) != 0 {
        let value = U8 (U8 (load(<U8>, #SIMULATION_STATE + 269)))
        if component_id_id279 != 0 && vid279 != value {
            set_setting(sim_short_circuit_component_id_1, U64 component_id_id279)
            set_setting(sim_short_circuit_component_id_2, U64 9)
            set_setting(sim_short_circuit_pin_1, U64 pin_index_id279)
            set_setting(sim_short_circuit_pin_2, U64 0)
            set_setting(sim_short_circuit_top_level_permanent_id_1, U64 component_top_id_id279)
            set_setting(sim_short_circuit_top_level_permanent_id_2, U64 0)
            set_setting(sim_short_circuit_any_top_level_wire_id, U64 17)
            set_setting(sim_short_circuit_value_1, U64 vid279)
            set_setting(sim_short_circuit_value_2, U64 value)
        }
        vid279 |= value
        and_field_id279 &= value
        store(#SIMULATION_STATE + 279, value)
        store(#SIMULATION_STATE + 281, value)
        component_id_id279 = 9
        component_top_id_id279 = 0
        pin_index_id279 = 0
        store(#SIMULATION_STATE + 278, U8 1)
        store(#SIMULATION_STATE + 280, U8 1)
    }
    


    // 0 com_none 2 0 
    


    // 2 com_level_output_word 8 6054541208406842226 X
    


    // 3 com_level_output_word 8 7634616521716821688 Y

}

def mode_run(target_cycle: Int) None {

    if get_setting(sim_test_result) == U64 win { return }
    if (get_setting(sim_test_result) == U64 fail && cycle + 1 >= #CYCLE_PAST_FAIL) { return }
    if get_setting(sim_short_circuit_component_id_1) != 0 { return }

    var halt_run = false

    var original_start_time = Time 0
    var orig_start_cycle = U64 cycle
    var last_time = original_start_time

    var burst_cycles = 1

    var nanos_per_cycle = U64 0

    var i = 0
    var last_target_speed = U64 0
    var speed = U64 1

    while get_command(ctl_command_id) == last_command_id && !halt_run && target_cycle > cycle {
        i += 1

        let target_speed = max(1, get_command(ctl_cycle_speed_ms))

        if target_speed != last_target_speed {

            original_start_time = get_time()
            orig_start_cycle = U64 cycle
            last_time = original_start_time

            speed = min(U64 get_command(ctl_cycle_speed_ms), 10000000000000) // Cap at 10 ghz to avoid overflow
            last_target_speed = target_speed

        }

        let cycles_at_start = cycle
        let burst_target = cycle + burst_cycles

        var burst_target_cycle = min(target_cycle, burst_target)

        def halt() None {

            burst_target_cycle = cycle
            halt_run = true

        }

        def handle_test_result(result: TestResult) None {

            if result != pass {

                var res = result

                halt() // Halt regardless of wether we are above '#CYCLE_PAST_FAIL'

                set_setting(sim_test_result, max(get_setting(sim_test_result), U64 res))

            }

        }

        while cycle < burst_target_cycle {

            if in_scope("get_input") {
                level_input = get_input(cycle + 1)
            }
            

            


            // 1 com_level_input_1_pin 1 1 Input select
            var vid264 = U1 level_input.input_select
            input_replay[0] = U64 level_input.input_select
            


            // 4 com_level_input_word 8 2 A
            var vid262 = U8 level_input.a
            input_replay[1] = U64 level_input.a
            


            // 5 com_level_input_word 8 3 B
            var vid260 = U8 level_input.b
            input_replay[2] = U64 level_input.b
            


            // 6 com_level_input_1_pin 1 4 Output select
            var vid256 = U1 level_input.output_select
            input_replay[3] = U64 level_input.output_select
            


            // 12 com_not_bit 2 7299504381916939783 
            var vid258 = U1 (U1 ~(U1 vid256))
            


            // 11 com_not_bit 2 3047429092566680701 
            var vid266 = U1 (U1 ~(U1 vid264))
            


            // 7 com_switch_word 8 1863076128768517044 
            var vid269 = U8 0
            var and_field_id269 = ~vid269
            if (U1 vid266) != 0 {
                vid269 |= U8  (U8 ((U8 vid262)))
                and_field_id269 &= U8  (U8 ((U8 vid262)))
            }
            


            // 8 com_switch_word 8 6758026184179601959 
            if (U1 vid264) != 0 {
                vid269 |= U8  (U8 ((U8 vid260)))
                and_field_id269 &= U8  (U8 ((U8 vid260)))
            }
            if vid269 > and_field_id269 {
                halt()
            }
            let zid269 = vid269 >= and_field_id269
            


            // 10 com_switch_word 8 4634184952721724460 
            var vid275 = U8 0
            var and_field_id275 = ~vid275
            if (U1 vid256) != 0 {
                vid275 |= U8  (U8 ((U8 vid269)))
                and_field_id275 &= U8  (U8 ((U8 vid269)))
            }
            if vid275 > and_field_id275 {
                halt()
            }
            let zid275 = vid275 >= and_field_id275
            


            // 9 com_switch_word 8 2677329545972473937 
            var vid279 = U8 0
            var and_field_id279 = ~vid279
            if (U1 vid258) != 0 {
                vid279 |= U8  (U8 ((U8 vid269)))
                and_field_id279 &= U8  (U8 ((U8 vid269)))
            }
            if vid279 > and_field_id279 {
                halt()
            }
            let zid279 = vid279 >= and_field_id279
            


            // 0 com_none 2 0 
            


            // 2 com_level_output_word 8 6054541208406842226 X
            level_output.x = U8 ((U8 vid279))
            level_output.x_is_z = !zid279
            


            // 3 com_level_output_word 8 7634616521716821688 Y
            level_output.y = U8 ((U8 vid275))
            level_output.y_is_z = !zid275

    



            if in_scope("check_output") {
                let result = check_output(cycle + 1, level_input, level_output)
                handle_test_result(result)
            }

            
            cycle += 1 // Do this late as it signals to the front end that it can update

        }

        set_setting(sim_cycle, U64 cycle)

        let time_now = get_time()

        let time_diff = U64 (time_now - last_time)

        nanos_per_cycle = time_diff / U64 burst_cycles

        if time_now - last_time > 33.ms() {

            // Burst took too long
            burst_cycles = max(1, burst_cycles - 1)

        } else {

            // Burst was too fast
            burst_cycles = burst_cycles + 1

        }

        #if in_scope("on_ui_update"){

            on_ui_update(level_input, level_output)

        }

        last_time = time_now


        def get_target_cycle(time_now: Time) U64 {
            let time_diff = U64 (time_now - original_start_time)
            return orig_start_cycle + ((time_diff / 1000000) * speed) / 1000000 // Double divide to prevent overflow
        }

        var run_target_cycle = get_target_cycle(time_now)

        // Sleep any ahead of time away
        while cycle > Int run_target_cycle && get_command(ctl_command_id) == last_command_id {

            sleep(1.ms())
            cycle -= 1
            mode_refresh()
            cycle += 1

            run_target_cycle = get_target_cycle(get_time())

        }

    }

}

var manual_input_seen = false

run_sim: while true {

    reset_sim()

    
    def get_input(cycle: Int) Input {
    
        var in = random(2)
        var out = random(2)
        var val1 = 0
        var val2 = 0
    
        if in == 0 {
    
            val1 = random(256)
    
        } else {
    
            val2 = random(256)
    
        }
    
        let source = in == 0 ? "A" : "B"
        let destination = out == 0 ? "X" : "Y"
        ui_set_text("description", `将 {source} 的值发送到 {destination}。`)
    
        return Input {
            input_select: U1 in,
            a: U8 val1,
            b: U8 val2,
            output_select: U1 out,
        }
    
    }
    
    
    def check_output(cycle: Int, input: Input, output: Output) TestResult {
    
        var val = U8 0
    
        if input.input_select == 0 {
    
            val = input.a
    
        } else {
    
            val = input.b
    
        }
    
    
        if input.output_select == 0 {
    
            if output.x_is_z || output.x != val {
    
                set_error(`输出 X 的值应为 {val}。`)
                return fail
    
            }
    
            if !output.y_is_z {
    
                set_error(`输出 Y 应为空（高阻态）。`)
                return fail
    
            }
    
        } else {
    
            if output.y_is_z || output.y != val {
    
                set_error(`输出 Y 的值应为 {val}。`)
                return fail
    
            }
    
            if !output.x_is_z {
    
                set_error(`输出 X 应为空（高阻态）。`)
                return fail
    
            }
    
        }
    
        if cycle == 32 {
    
            return win
    
        }
    
    }
    while true {

        mode_refresh()

        #if in_scope("on_ui_update"){

            on_ui_update(level_input, level_output)

        }

        while get_command(ctl_command_id) == last_command_id {

            #if in_scope("on_manual_input"){

                if last_level_manual_input != get_command(ctl_level_manual_input_id) {

                    last_level_manual_input = get_command(ctl_level_manual_input_id)
                    on_manual_input(Int get_command(ctl_level_manual_input))
                    manual_input_seen = true

                }

            }

            sleep(1.ms())

        }

        if manual_input_seen {

            manual_input_seen = false
            break

        }

        last_command_id = get_command(ctl_command_id) // Read this before the command in case of race condition
        set_setting(sim_last_command_id, last_command_id)
        var command = SimCommand get_command(ctl_command)

        switch command

            case run {

                var target_cycle = Int get_setting(sim_target_cycle)

                set_setting(sim_running, U64 1)
                mode_run(target_cycle)
                set_setting(sim_running, U64 0)

            }

            case refresh {}

            case mode_reset {

                var i = 0
                while i < 1024 {
                    input_replay[i] = ctl_input_replay_reset[i]
                    i += 1
                }

                break

            }

            case quit_simulation {

                break run_sim // We need to break out instead of thread_exit() to make sure everything is cleaned up

            }

    }

}

