    if user_label == "Save" && index == 0 { return Int (U64 load(<U1>, #SIMULATION_STATE + 1)) }
    if user_label == "Input" && index == 0 { return Int (U64 load(<U8>, #SIMULATION_STATE + 1)) }
}
