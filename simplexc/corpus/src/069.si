    let value_id272 = (U8 load(<U1>, #SIMULATION_STATE + 258) | (((U8 (load(<U1>, #SIMULATION_STATE + 270))) & 1) << 1) | (((U8 (load(<U1>, #SIMULATION_STATE + 268))) & 1) << 2) | (((U8 (load(<U1>, #SIMULATION_STATE + 266))) & 1) << 3) | (((U8 (load(<U1>, #SIMULATION_STATE + 264))) & 1) << 4) | (((U8 (load(<U1>, #SIMULATION_STATE + 262))) & 1) << 5) | (((U8 (load(<U1>, #SIMULATION_STATE + 260))) & 1) << 6) | (((U8 (load(<U1>, #SIMULATION_STATE + 256))) & 1) << 7))
    store(#SIMULATION_STATE + 272, U8 (value_id272))
