def mode_run(target_cycle: Int) None {

    if get_setting(sim_test_result) == U64 win { return }
    if (get_setting(sim_test_result) == U64 fail && cycle + 1 >= #CYCLE_PAST_FAIL) { return }
    if get_setting(sim_short_circuit_component_id_1) != 0 { return }

    var halt_run = false

    var original_start_time = Time 0
    var orig_start_cycle = U64 cycle
    var last_time = original_start_time

    var burst_cycles = 1

    var nanos_per_cycle = U64 0

    var i = 0
    var last_target_speed = U64 0
    var speed = U64 1

    while get_command(ctl_command_id) == last_command_id && !halt_run && target_cycle > cycle {
        i += 1

        let target_speed = max(1, get_command(ctl_cycle_speed_ms))

        if target_speed != last_target_speed {

            original_start_time = get_time()
            orig_start_cycle = U64 cycle
            last_time = original_start_time

            speed = min(U64 get_command(ctl_cycle_speed_ms), 10000000000000) // Cap at 10 ghz to avoid overflow
            last_target_speed = target_speed

        }

        let cycles_at_start = cycle
        let burst_target = cycle + burst_cycles

        var burst_target_cycle = min(target_cycle, burst_target)

        def halt() None {

            burst_target_cycle = cycle
            halt_run = true

        }

        def handle_test_result(result: TestResult) None {

            if result != pass {

                var res = result

                halt() // Halt regardless of wether we are above '#CYCLE_PAST_FAIL'

                set_setting(sim_test_result, max(get_setting(sim_test_result), U64 res))

            }

        }

        while cycle < burst_target_cycle {

            if in_scope("get_input") {
                level_input = get_input(cycle + 1)
            }
            

            


            // 2 com_level_input_1_pin 1 2556108969806308965 Save
            var vid292 = U1 level_input.save
            input_replay[0] = U64 level_input.save
            


            // 3 com_level_input_word 8 8934517657784953102 Input
            var vid274 = U8 level_input.input
            input_replay[1] = U64 level_input.input
            


            // 11 com_register_bit 2 296785825615032193 
            let value_11 = load(<U1>, #SIMULATION_STATE + 308)
            store(#SIMULATION_STATE + 309, value_11) // Output cache
            var vid256 = U1 value_11
            


            // 10 com_register_bit 2 7560376776307563442 
            let value_10 = load(<U1>, #SIMULATION_STATE + 306)
            store(#SIMULATION_STATE + 307, value_10) // Output cache
            var vid258 = U1 value_10
            


            // 9 com_register_bit 2 8002076463453383948 
            let value_9 = load(<U1>, #SIMULATION_STATE + 304)
            store(#SIMULATION_STATE + 305, value_9) // Output cache
            var vid260 = U1 value_9
            


            // 8 com_register_bit 2 1911632512513980038 
            let value_8 = load(<U1>, #SIMULATION_STATE + 302)
            store(#SIMULATION_STATE + 303, value_8) // Output cache
            var vid262 = U1 value_8
            


            // 7 com_register_bit 2 2632655064955448913 
            let value_7 = load(<U1>, #SIMULATION_STATE + 300)
            store(#SIMULATION_STATE + 301, value_7) // Output cache
            var vid264 = U1 value_7
            


            // 6 com_register_bit 2 6722156143538214066 
            let value_6 = load(<U1>, #SIMULATION_STATE + 298)
            store(#SIMULATION_STATE + 299, value_6) // Output cache
            var vid266 = U1 value_6
            


            // 5 com_register_bit 2 6934915327395685481 
            let value_5 = load(<U1>, #SIMULATION_STATE + 296)
            store(#SIMULATION_STATE + 297, value_5) // Output cache
            var vid268 = U1 value_5
            


            // 4 com_register_bit 2 6139590180923388957 
            let value_4 = load(<U1>, #SIMULATION_STATE + 294)
            store(#SIMULATION_STATE + 295, value_4) // Output cache
            var vid270 = U1 value_4
            


            // 12 com_maker_bit_8 2 5876118070398784225 
            var vid272 = U8 (U8 (U1 vid258) | (((U8 ((U1 vid270))) & 1) << 1) | (((U8 ((U1 vid268))) & 1) << 2) | (((U8 ((U1 vid266))) & 1) << 3) | (((U8 ((U1 vid264))) & 1) << 4) | (((U8 ((U1 vid262))) & 1) << 5) | (((U8 ((U1 vid260))) & 1) << 6) | (((U8 ((U1 vid256))) & 1) << 7))
            


            // 13 com_splitter_bit_8 2 7162704942455584406 
            let input_13 = (U8 vid274)
            var vid276 = U1 input_13
            var vid278 = U1 (input_13 >> 1) & 1
            var vid280 = U1 (input_13 >> 2) & 1
            var vid282 = U1 (input_13 >> 3) & 1
            var vid284 = U1 (input_13 >> 4) & 1
            var vid286 = U1 (input_13 >> 5) & 1
            var vid288 = U1 (input_13 >> 6) & 1
            var vid290 = U1 (input_13 >> 7) & 1
            


            // 21 com_register_bit 2 LATE -296785825615032193 
            if (U1 vid292) == 1 {
                store(#SIMULATION_STATE + 308, U1 (U1 vid290))
            }
            


            // 20 com_register_bit 2 LATE -7560376776307563442 
            if (U1 vid292) == 1 {
                store(#SIMULATION_STATE + 306, U1 (U1 vid276))
            }
            


            // 19 com_register_bit 2 LATE -8002076463453383948 
            if (U1 vid292) == 1 {
                store(#SIMULATION_STATE + 304, U1 (U1 vid288))
            }
            


            // 18 com_register_bit 2 LATE -1911632512513980038 
            if (U1 vid292) == 1 {
                store(#SIMULATION_STATE + 302, U1 (U1 vid286))
            }
            


            // 17 com_register_bit 2 LATE -2632655064955448913 
            if (U1 vid292) == 1 {
                store(#SIMULATION_STATE + 300, U1 (U1 vid284))
            }
            


            // 16 com_register_bit 2 LATE -6722156143538214066 
            if (U1 vid292) == 1 {
                store(#SIMULATION_STATE + 298, U1 (U1 vid282))
            }
            


            // 15 com_register_bit 2 LATE -6934915327395685481 
            if (U1 vid292) == 1 {
                store(#SIMULATION_STATE + 296, U1 (U1 vid280))
            }
            


            // 14 com_register_bit 2 LATE -6139590180923388957 
            if (U1 vid292) == 1 {
                store(#SIMULATION_STATE + 294, U1 (U1 vid278))
            }
            


            // 0 com_none 2 0 
            


            // 1 com_level_output_word 8 4760510578164419512 Output
            level_output.output = U8 ((U8 vid272))
            level_output.output_is_z = false

    



            if in_scope("check_output") {
                let result = check_output(cycle + 1, level_input, level_output)
                handle_test_result(result)
            }

            
            cycle += 1 // Do this late as it signals to the front end that it can update

        }

        set_setting(sim_cycle, U64 cycle)

        let time_now = get_time()

        let time_diff = U64 (time_now - last_time)

        nanos_per_cycle = time_diff / U64 burst_cycles

        if time_now - last_time > 33.ms() {

            // Burst took too long
            burst_cycles = max(1, burst_cycles - 1)

        } else {

            // Burst was too fast
            burst_cycles = burst_cycles + 1

        }

        #if in_scope("on_ui_update"){

            on_ui_update(level_input, level_output)

        }

        last_time = time_now


        def get_target_cycle(time_now: Time) U64 {
            let time_diff = U64 (time_now - original_start_time)
            return orig_start_cycle + ((time_diff / 1000000) * speed) / 1000000 // Double divide to prevent overflow
        }

        var run_target_cycle = get_target_cycle(time_now)

        // Sleep any ahead of time away
        while cycle > Int run_target_cycle && get_command(ctl_command_id) == last_command_id {

            sleep(1.ms())
            cycle -= 1
            mode_refresh()
            cycle += 1

            run_target_cycle = get_target_cycle(get_time())

        }

    }

}

var manual_input_seen = false

run_sim: while true {

    reset_sim()

    var memory      = U8 0
    var next_memory = U8 0
    
    def get_padded_number(num: U8) Str {
        var s = `{num}`
        if s.len() < 3 {
            s = " " + s
        }
        if s.len() < 3 {
            s = s + " "
        }
        return s
    }
    
    def get_input(cycle: Int) Input {
    
        memory = next_memory
    
        var action = random(4)
        var num    = U8 random(0x100)
    
        if cycle == 0 {
            action = 1
        }
    
        var save = 0
    
        if (action & 1) != 0 {
    
            save = 1
            next_memory = num
    
        }
    
        var text = ""
        if save == 0 {
            text = "[F]"
        } else {
            text = "[T]"
        }
        ui_set_text("table[0][1]", text)
        ui_set_text("table[1][1]", `{get_padded_number(num)}`)
    
        return Input {save: U1 save, input: U8 num}
    
    }
    
    def check_output(cycle: Int, input: Input, output: Output) TestResult {
        ui_set_text("table[2][1]", `{get_padded_number(memory)}`)
    
        if output.output_is_z {
            ui_set_text("table[3][1]", ` Z `)
            set_error(`输出不应为空（高阻态）`)
            return fail
        }
    
        ui_set_text("table[3][1]", `{get_padded_number(output.output)}`)
    
        if output.output != memory {
            let expected_output = memory
            set_error(`预期的输出为 {expected_output}。`)
            return fail
        }
    
        if cycle == 0xffff {
            return win
        }
    
    }
    while true {

        mode_refresh()

        #if in_scope("on_ui_update"){

            on_ui_update(level_input, level_output)

        }

        while get_command(ctl_command_id) == last_command_id {

            #if in_scope("on_manual_input"){

                if last_level_manual_input != get_command(ctl_level_manual_input_id) {

                    last_level_manual_input = get_command(ctl_level_manual_input_id)
                    on_manual_input(Int get_command(ctl_level_manual_input))
                    manual_input_seen = true

                }

            }

            sleep(1.ms())

        }

        if manual_input_seen {

            manual_input_seen = false
            break

        }

        last_command_id = get_command(ctl_command_id) // Read this before the command in case of race condition
        set_setting(sim_last_command_id, last_command_id)
        var command = SimCommand get_command(ctl_command)

        switch command

            case run {

                var target_cycle = Int get_setting(sim_target_cycle)

                set_setting(sim_running, U64 1)
                mode_run(target_cycle)
                set_setting(sim_running, U64 0)

            }

            case refresh {}

            case mode_reset {

                var i = 0
                while i < 1024 {
                    input_replay[i] = ctl_input_replay_reset[i]
                    i += 1
                }

                break

            }

            case quit_simulation {

                break run_sim // We need to break out instead of thread_exit() to make sure everything is cleaned up

            }

    }

}

