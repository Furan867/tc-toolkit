def get_output(user_label: Str, index: Int) Int { 
    if user_label == "Input" && index == 0 { return Int (U64 load(<U3>, #SIMULATION_STATE + 1)) }
    if user_label == "Disable" && index == 0 { return Int (U64 load(<U1>, #SIMULATION_STATE + 1)) }
}
