}

def mode_run(target_cycle: Int) None {

    if get_setting(sim_test_result) == U64 win { return }
    if (get_setting(sim_test_result) == U64 fail && cycle + 1 >= #CYCLE_PAST_FAIL) { return }
    if get_setting(sim_short_circuit_component_id_1) != 0 { return }

    var halt_run = false

    var original_start_time = Time 0
    var orig_start_cycle = U64 cycle
    var last_time = original_start_time

    var burst_cycles = 1

    var nanos_per_cycle = U64 0

    var i = 0
    var last_target_speed = U64 0
    var speed = U64 1

    while get_command(ctl_command_id) == last_command_id && !halt_run && target_cycle > cycle {
        i += 1

        let target_speed = max(1, get_command(ctl_cycle_speed_ms))

        if target_speed != last_target_speed {

            original_start_time = get_time()
            orig_start_cycle = U64 cycle
            last_time = original_start_time

            speed = min(U64 get_command(ctl_cycle_speed_ms), 10000000000000) // Cap at 10 ghz to avoid overflow
            last_target_speed = target_speed

        }

        let cycles_at_start = cycle
        let burst_target = cycle + burst_cycles

        var burst_target_cycle = min(target_cycle, burst_target)

        def halt() None {

            burst_target_cycle = cycle
            halt_run = true

        }

        def handle_test_result(result: TestResult) None {

            if result != pass {

                var res = result

                halt() // Halt regardless of wether we are above '#CYCLE_PAST_FAIL'

                set_setting(sim_test_result, max(get_setting(sim_test_result), U64 res))

            }

        }

        while cycle < burst_target_cycle {

            if in_scope("get_input") {
                level_input = get_input(cycle + 1)
            }
            

            


            // 1 com_level_input_1_pin 1 8889286672326221133 Load
            var vid308 = U1 level_input.load
            input_replay[0] = U64 level_input.load
            


            // 2 com_level_input_2_pin 2 6452944301761287414 Address
            var vid268 = U1 level_input.address & 1
            var vid270 = U1 (level_input.address >> 1) & 1
            input_replay[1] = U64 level_input.address
            


            // 3 com_level_input_word 8 4 Value
            var vid266 = U8 level_input.value
            input_replay[2] = U64 level_input.value
            


            // 5 com_level_input_1_pin 1 3304164213712623844 Save
            var vid264 = U1 level_input.save
            input_replay[3] = U64 level_input.save
            


            // 11 com_register_word 8 253806351637528255 
            let value_11 = load(<U8>, #SIMULATION_STATE + 320)
            store(#SIMULATION_STATE + 321, value_11) // Output cache
            var vid256 = U8 value_11
            


            // 10 com_register_word 8 1524674111778308371 
            let value_10 = load(<U8>, #SIMULATION_STATE + 318)
            store(#SIMULATION_STATE + 319, value_10) // Output cache
            var vid258 = U8 value_10
            


            // 9 com_register_word 8 1985710402811285152 
            let value_9 = load(<U8>, #SIMULATION_STATE + 316)
            store(#SIMULATION_STATE + 317, value_9) // Output cache
            var vid260 = U8 value_9
            


            // 8 com_register_word 8 5826970539509863802 
            let value_8 = load(<U8>, #SIMULATION_STATE + 314)
            store(#SIMULATION_STATE + 315, value_8) // Output cache
            var vid262 = U8 value_8
            


            // 20 com_maker_bit_2 2 7283804143492972907 
            var vid272 = U2 (U8 (U1 vid268) | (U8 (U8 ((U1 vid270))) << 1))
            


            // 19 com_decoder_2 2 1164675712331893557 
            var val19 = (U2 vid272)
            var vid274 = U1 (U64 (val19 == 0))
            var vid276 = U1 (U64 (val19 == 1))
            var vid278 = U1 (U64 (val19 == 2))
            var vid280 = U1 (U64 (val19 == 3))
            


            // 17 com_switch_word 8 7947391820549651266 
            var vid299 = U8 0
            var and_field_id299 = ~vid299
            if (U1 vid280) != 0 {
                vid299 |= U8  (U8 ((U8 vid256)))
                and_field_id299 &= U8  (U8 ((U8 vid256)))
            }
            


            // 15 com_switch_bit 2 7523372757576308548 
            var vid283 = U1 0
            var and_field_id283 = ~vid283
            if (U1 vid280) != 0 {
                vid283 |= U1  (U1 ((U1 vid264)))
                and_field_id283 &= U1  (U1 ((U1 vid264)))
            }
            if vid283 > and_field_id283 {
                halt()
            }
            let zid283 = vid283 >= and_field_id283
            


            // 24 com_register_word 8 LATE -253806351637528255 
            if (U1 vid283) == 1 {
                store(#SIMULATION_STATE + 320, U8 ((U8 vid266)))
            }
            


            // 16 com_switch_word 8 5463521938082330061 
            if (U1 vid278) != 0 {
                vid299 |= U8  (U8 ((U8 vid258)))
                and_field_id299 &= U8  (U8 ((U8 vid258)))
            }
            


            // 14 com_switch_bit 2 4250906028322327556 
            var vid287 = U1 0
            var and_field_id287 = ~vid287
            if (U1 vid278) != 0 {
                vid287 |= U1  (U1 ((U1 vid264)))
                and_field_id287 &= U1  (U1 ((U1 vid264)))
            }
            if vid287 > and_field_id287 {
                halt()
            }
            let zid287 = vid287 >= and_field_id287
            


            // 23 com_register_word 8 LATE -1524674111778308371 
            if (U1 vid287) == 1 {
                store(#SIMULATION_STATE + 318, U8 ((U8 vid266)))
            }
            


            // 13 com_switch_bit 2 8815788644694413382 
            var vid291 = U1 0
            var and_field_id291 = ~vid291
            if (U1 vid276) != 0 {
                vid291 |= U1  (U1 ((U1 vid264)))
                and_field_id291 &= U1  (U1 ((U1 vid264)))
            }
            if vid291 > and_field_id291 {
                halt()
            }
            let zid291 = vid291 >= and_field_id291
            


            // 22 com_register_word 8 LATE -1985710402811285152 
            if (U1 vid291) == 1 {
                store(#SIMULATION_STATE + 316, U8 ((U8 vid266)))
            }
            


            // 7 com_switch_word 8 4855491724601734516 
            if (U1 vid276) != 0 {
                vid299 |= U8  (U8 ((U8 vid260)))
                and_field_id299 &= U8  (U8 ((U8 vid260)))
            }
            


            // 12 com_switch_bit 2 2360770350029984911 
            var vid295 = U1 0
            var and_field_id295 = ~vid295
            if (U1 vid274) != 0 {
                vid295 |= U1  (U1 ((U1 vid264)))
                and_field_id295 &= U1  (U1 ((U1 vid264)))
            }
            if vid295 > and_field_id295 {
                halt()
            }
            let zid295 = vid295 >= and_field_id295
            


            // 21 com_register_word 8 LATE -5826970539509863802 
            if (U1 vid295) == 1 {
                store(#SIMULATION_STATE + 314, U8 ((U8 vid266)))
            }
            


            // 6 com_switch_word 8 1241359839808522774 
            if (U1 vid274) != 0 {
                vid299 |= U8  (U8 ((U8 vid262)))
                and_field_id299 &= U8  (U8 ((U8 vid262)))
            }
            if vid299 > and_field_id299 {
                halt()
            }
            let zid299 = vid299 >= and_field_id299
            


            // 18 com_switch_word 8 5222776322272273319 
            var vid311 = U8 0
            var and_field_id311 = ~vid311
            if (U1 vid308) != 0 {
                vid311 |= U8  (U8 ((U8 vid299)))
                and_field_id311 &= U8  (U8 ((U8 vid299)))
            }
            if vid311 > and_field_id311 {
                halt()
            }
            let zid311 = vid311 >= and_field_id311
            


            // 0 com_none 2 0 
            


            // 4 com_level_output_word 8 6991893849134016550 Output
            level_output.output = U8 ((U8 vid311))
            level_output.output_is_z = !zid311

    



            if in_scope("check_output") {
                let result = check_output(cycle + 1, level_input, level_output)
                handle_test_result(result)
            }

            
            cycle += 1 // Do this late as it signals to the front end that it can update

        }

        set_setting(sim_cycle, U64 cycle)

        let time_now = get_time()

        let time_diff = U64 (time_now - last_time)

        nanos_per_cycle = time_diff / U64 burst_cycles

        if time_now - last_time > 33.ms() {

            // Burst took too long
            burst_cycles = max(1, burst_cycles - 1)

        } else {

            // Burst was too fast
            burst_cycles = burst_cycles + 1

        }

        #if in_scope("on_ui_update"){

            on_ui_update(level_input, level_output)

        }

        last_time = time_now


        def get_target_cycle(time_now: Time) U64 {
            let time_diff = U64 (time_now - original_start_time)
            return orig_start_cycle + ((time_diff / 1000000) * speed) / 1000000 // Double divide to prevent overflow
        }

        var run_target_cycle = get_target_cycle(time_now)

        // Sleep any ahead of time away
        while cycle > Int run_target_cycle && get_command(ctl_command_id) == last_command_id {

            sleep(1.ms())
            cycle -= 1
            mode_refresh()
            cycle += 1

            run_target_cycle = get_target_cycle(get_time())

        }

    }

}

var manual_input_seen = false

run_sim: while true {

    reset_sim()

    
    var memory_state      = [0,0,0,0]
    
    def markup(text: Str) Str {
        return `[color=#E5787D][b]{text}[/b][/color]`
    }
    
    def get_input(cycle: Int) Input {
    
        var add_1 = random(2)
        var add_2 = random(2)
        var actions = random(4)
        var load = actions & 1
        var save = actions >> 1
        var value = 1 + random(255)
    
        if cycle < 8 {
            if cycle % 2 == 0 {
                save = 1
                load = 0
                add_1 = (cycle / 2) & 1
                add_2 = Int ((cycle / 2) > 1)
    
            } else {
                save = 0
                load = 1
                add_1 = (cycle / 2) & 1
                add_2 = Int ((cycle / 2) > 1)
            }
        }
    
        var offset = -1
        if save == 1 {
            offset = add_1 * 2 + add_2
        }
    
        var i = 0
        while i < 4 {
            var text = offset == i ? str(value) : str(memory_state[i])
            ui_set_text(`states[{i + 1}][1]`, text)
            i += 1
        }
    
        var text_value = markup(`{value}`)
        ui_set_text("actions[1][2]", text_value)
    
        var text_add = str(add_1) + str(add_2)
        text_add = markup(text_add)
        ui_set_text("actions[1][3]", text_add)
    
        if load == 0 {
            ui_set_text("actions[2][1]", "[F]")
            ui_set_hidden("load", true)
        } else {
            var text_state = markup(`{memory_state[add_1 * 2 + add_2]}`)
            ui_set_text("actions[2][1]", "[T]")
            ui_set_text("load", `[left]` + `从地址 {text_add} 读取 {text_state}` + `[/left]`)
            ui_set_hidden("load", false)
        }
    
        if save == 0 {
            ui_set_text("actions[3][1]", "[F]")
            ui_set_hidden("save", true)
        } else {
            ui_set_text("actions[3][1]", "[T]")
            ui_set_text("save", `[left]` + `向地址 {text_add} 写入 {text_value}` + `[/left]`)
            ui_set_hidden("save", false)
        }
    
        return Input {
            load: U1 load,
            save: U1 save,
            address: U2 add_1 << 1 | U2 add_2,
            value: U8 value,
        }
    }
    
    def check_output(cycle: Int, input: Input, output: Output) TestResult {
    
        if input.load == 1 {
    
            if memory_state[input.address] != Int output.output {
                let expected_value = memory_state[input.address]
                let actual_value = output.output
    
                if output.output_is_z {
                    set_error(`当前输出为空（高阻态），但预期值为 {expected_value}。`)
                } else {
                    set_error(`当前输出为 {actual_value}，但预期值为 {expected_value}。`)
                }
    
                return fail
    
            }
    
        } else {
    
            if !output.output_is_z {
                set_error(`输出应该为空（高阻态）。`)
                return fail
            }
    
        }
    
        if cycle == 0xfff {
    
            return win
    
        }
    
        if input.save == 1 {
            memory_state[input.address] = Int input.value
        }
    
    }
    
    while true {

        mode_refresh()

        #if in_scope("on_ui_update"){

            on_ui_update(level_input, level_output)

        }

        while get_command(ctl_command_id) == last_command_id {

            #if in_scope("on_manual_input"){

                if last_level_manual_input != get_command(ctl_level_manual_input_id) {

                    last_level_manual_input = get_command(ctl_level_manual_input_id)
                    on_manual_input(Int get_command(ctl_level_manual_input))
                    manual_input_seen = true

                }

            }

            sleep(1.ms())

        }

        if manual_input_seen {

            manual_input_seen = false
            break

        }

        last_command_id = get_command(ctl_command_id) // Read this before the command in case of race condition
        set_setting(sim_last_command_id, last_command_id)
        var command = SimCommand get_command(ctl_command)

        switch command

            case run {

                var target_cycle = Int get_setting(sim_target_cycle)

                set_setting(sim_running, U64 1)
                mode_run(target_cycle)
                set_setting(sim_running, U64 0)

            }

            case refresh {}

            case mode_reset {

                var i = 0
                while i < 1024 {
                    input_replay[i] = ctl_input_replay_reset[i]
                    i += 1
                }

                break

            }

            case quit_simulation {

                break run_sim // We need to break out instead of thread_exit() to make sure everything is cleaned up

            }

    }

}

