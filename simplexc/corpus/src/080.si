def get_output(user_label: Str, index: Int) Int { 
    if user_label == "Load" && index == 0 { return Int (U64 load(<U1>, #SIMULATION_STATE + 1)) }
    if user_label == "Address" && index == 0 { return Int (U64 load(<U1>, #SIMULATION_STATE + 1)) }
    if user_label == "Address" && index == 1 { return Int (U64 load(<U1>, #SIMULATION_STATE + 1)) }
    if user_label == "Value" && index == 0 { return Int (U64 load(<U8>, #SIMULATION_STATE + 1)) }
    if user_label == "Save" && index == 0 { return Int (U64 load(<U1>, #SIMULATION_STATE + 1)) }
}
