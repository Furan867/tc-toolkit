    let value_id280 = (U64 (val19 == 3))
    store(#SIMULATION_STATE + 280, U1 (value_id280))
    store(#SIMULATION_STATE + 281, U1 (value_id280))
    


    // 17 com_switch_word 8 7947391820549651266 
    store(#SIMULATION_STATE + 299, U8  0)
    store(#SIMULATION_STATE + 298, U1 0)
    store(#SIMULATION_STATE + 306, U1 0)
