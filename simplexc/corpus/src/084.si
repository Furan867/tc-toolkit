def mode_run(target_cycle: Int) None {

    if get_setting(sim_test_result) == U64 win { return }
    if (get_setting(sim_test_result) == U64 fail && cycle + 1 >= #CYCLE_PAST_FAIL) { return }
    if get_setting(sim_short_circuit_component_id_1) != 0 { return }

    var halt_run = false

    var original_start_time = Time 0
    var orig_start_cycle = U64 cycle
    var last_time = original_start_time

    var burst_cycles = 1

    var nanos_per_cycle = U64 0

    var i = 0
    var last_target_speed = U64 0
    var speed = U64 1

    while get_command(ctl_command_id) == last_command_id && !halt_run && target_cycle > cycle {
        i += 1

        let target_speed = max(1, get_command(ctl_cycle_speed_ms))

        if target_speed != last_target_speed {

            original_start_time = get_time()
            orig_start_cycle = U64 cycle
            last_time = original_start_time

            speed = min(U64 get_command(ctl_cycle_speed_ms), 10000000000000) // Cap at 10 ghz to avoid overflow
            last_target_speed = target_speed

        }

        let cycles_at_start = cycle
        let burst_target = cycle + burst_cycles

        var burst_target_cycle = min(target_cycle, burst_target)

        def halt() None {

            burst_target_cycle = cycle
            halt_run = true

        }

        def handle_test_result(result: TestResult) None {

            if result != pass {

                var res = result

                halt() // Halt regardless of wether we are above '#CYCLE_PAST_FAIL'

                set_setting(sim_test_result, max(get_setting(sim_test_result), U64 res))

            }

        }

        while cycle < burst_target_cycle {

            if in_scope("get_input") {
                level_input = get_input(cycle + 1)
            }
            

            


            // 1 com_level_input_word 8 5333319365468671932 Instruction
            var vid268 = U8 level_input.instruction
            input_replay[0] = U64 level_input.instruction
            


            // 7 com_register_word 8 5038837070423351497 Reg 5
            let value_7 = load(<U8>, #SIMULATION_STATE + 344)
            store(#SIMULATION_STATE + 345, value_7) // Output cache
            var vid256 = U8 value_7
            


            // 6 com_register_word 8 8457532672162606686 Reg 4
            let value_6 = load(<U8>, #SIMULATION_STATE + 342)
            store(#SIMULATION_STATE + 343, value_6) // Output cache
            var vid258 = U8 value_6
            


            // 5 com_register_word 8 2696761337750346968 Reg 3
            let value_5 = load(<U8>, #SIMULATION_STATE + 340)
            store(#SIMULATION_STATE + 341, value_5) // Output cache
            var vid260 = U8 value_5
            


            // 4 com_register_word 8 7011283332965780127 Reg 2
            let value_4 = load(<U8>, #SIMULATION_STATE + 338)
            store(#SIMULATION_STATE + 339, value_4) // Output cache
            var vid262 = U8 value_4
            


            // 3 com_register_word 8 8019107146118383994 Reg 1
            let value_3 = load(<U8>, #SIMULATION_STATE + 336)
            store(#SIMULATION_STATE + 337, value_3) // Output cache
            var vid264 = U8 value_3
            


            // 2 com_register_word 8 1694631439058008882 Reg 0
            let value_2 = load(<U8>, #SIMULATION_STATE + 334)
            store(#SIMULATION_STATE + 335, value_2) // Output cache
            var vid266 = U8 value_2
            


            // 17 com_splitter_bit_8 2 6764804433434021057 
            let input_17 = (U8 vid268)
            var vid368 = U1 input_17
            var vid369 = U1 (input_17 >> 1) & 1
            var vid370 = U1 (input_17 >> 2) & 1
            var vid270 = U1 (input_17 >> 3) & 1
            var vid272 = U1 (input_17 >> 4) & 1
            var vid274 = U1 (input_17 >> 5) & 1
            var vid371 = U1 (input_17 >> 6) & 1
            var vid372 = U1 (input_17 >> 7) & 1
            


            // 16 com_maker_bit_4 2 3578523879609704144 
            var vid276 = U4 (U8 (U1 vid270) | (((U8 ((U1 vid272))) & 1) << 1) | (((U8 ((U1 vid274))) & 1) << 2) | (((U8 0x0) & 1) << 3))
            


            // 19 com_decoder_3 2 1884838916282834265 
            var val19 = (((((U1 0x0)) & 1) == 1) ? 8 : U8 ((U3 ((U3 vid276))) & 0b111))
            var vid278 = U1 (U64 (val19 == 0))
            var vid280 = U1 (U64 (val19 == 1))
            var vid282 = U1 (U64 (val19 == 2))
            var vid284 = U1 (U64 (val19 == 3))
            var vid286 = U1 (U64 (val19 == 4))
            var vid288 = U1 (U64 (val19 == 5))
            var vid290 = U1 (U64 (val19 == 6))
            var vid373 = U1 (U64 (val19 == 7))
            


            // 12 com_splitter_bit_8 2 9077415681366144360 
            let input_12 = (U8 vid268)
            var vid292 = U1 input_12
            var vid294 = U1 (input_12 >> 1) & 1
            var vid296 = U1 (input_12 >> 2) & 1
            var vid363 = U1 (input_12 >> 3) & 1
            var vid364 = U1 (input_12 >> 4) & 1
            var vid365 = U1 (input_12 >> 5) & 1
            var vid366 = U1 (input_12 >> 6) & 1
            var vid367 = U1 (input_12 >> 7) & 1
            


            // 13 com_maker_bit_4 2 2495780051996469839 
            var vid298 = U4 (U8 (U1 vid292) | (((U8 ((U1 vid294))) & 1) << 1) | (((U8 ((U1 vid296))) & 1) << 2) | (((U8 0x0) & 1) << 3))
            


            // 10 com_decoder_3 2 9209228748588502679 
            var val10 = (((((U1 0x0)) & 1) == 1) ? 8 : U8 ((U3 ((U3 vid298))) & 0b111))
            var vid300 = U1 (U64 (val10 == 0))
            var vid302 = U1 (U64 (val10 == 1))
            var vid304 = U1 (U64 (val10 == 2))
            var vid306 = U1 (U64 (val10 == 3))
            var vid308 = U1 (U64 (val10 == 4))
            var vid310 = U1 (U64 (val10 == 5))
            var vid312 = U1 (U64 (val10 == 6))
            var vid362 = U1 (U64 (val10 == 7))
            


            // 8 com_level_input_switched 8 8473002715135360280 
            let enable_8 = (U1 vid312)
            var vid315 = U8 0
            var and_field_id315 = ~vid315
            if enable_8 != 0 {
                vid315 |= U8  (U8 (level_input.input))
                and_field_id315 &= U8  (U8 (level_input.input))
            }
            level_input.input_enabled = Bool enable_8
            if vid315 > and_field_id315 {
                halt()
            }
            let zid315 = vid315 >= and_field_id315
            


            // 22 com_switch_word 8 6216605498921401020 
            var vid319 = U8 0
            var and_field_id319 = ~vid319
            if (U1 vid312) != 0 {
                vid319 |= U8  (U8 ((U8 vid315)))
                and_field_id319 &= U8  (U8 ((U8 vid315)))
            }
            


            // 20 com_switch_word 8 3162778880714194146 
            if (U1 vid310) != 0 {
                vid319 |= U8  (U8 ((U8 vid256)))
                and_field_id319 &= U8  (U8 ((U8 vid256)))
            }
            


            // 21 com_switch_word 8 3726969595151382956 
            if (U1 vid308) != 0 {
                vid319 |= U8  (U8 ((U8 vid258)))
                and_field_id319 &= U8  (U8 ((U8 vid258)))
            }
            


            // 18 com_switch_word 8 5444739482933837572 
            if (U1 vid306) != 0 {
                vid319 |= U8  (U8 ((U8 vid260)))
                and_field_id319 &= U8  (U8 ((U8 vid260)))
            }
            


            // 15 com_switch_word 8 3473263944295692419 
            if (U1 vid304) != 0 {
                vid319 |= U8  (U8 ((U8 vid262)))
                and_field_id319 &= U8  (U8 ((U8 vid262)))
            }
            


            // 14 com_switch_word 8 7939370918108705346 
            if (U1 vid302) != 0 {
                vid319 |= U8  (U8 ((U8 vid264)))
                and_field_id319 &= U8  (U8 ((U8 vid264)))
            }
            


            // 11 com_switch_word 8 552827026747290463 
            if (U1 vid300) != 0 {
                vid319 |= U8  (U8 ((U8 vid266)))
                and_field_id319 &= U8  (U8 ((U8 vid266)))
            }
            if vid319 > and_field_id319 {
                halt()
            }
            let zid319 = vid319 >= and_field_id319
            


            // 28 com_register_word 8 LATE -5038837070423351497 Reg 5
            if (U1 vid288) == 1 {
                store(#SIMULATION_STATE + 344, U8 ((U8 vid319)))
            }
            


            // 27 com_register_word 8 LATE -8457532672162606686 Reg 4
            if (U1 vid286) == 1 {
                store(#SIMULATION_STATE + 342, U8 ((U8 vid319)))
            }
            


            // 26 com_register_word 8 LATE -2696761337750346968 Reg 3
            if (U1 vid284) == 1 {
                store(#SIMULATION_STATE + 340, U8 ((U8 vid319)))
            }
            


            // 25 com_register_word 8 LATE -7011283332965780127 Reg 2
            if (U1 vid282) == 1 {
                store(#SIMULATION_STATE + 338, U8 ((U8 vid319)))
            }
            


            // 24 com_register_word 8 LATE -8019107146118383994 Reg 1
            if (U1 vid280) == 1 {
                store(#SIMULATION_STATE + 336, U8 ((U8 vid319)))
            }
            


            // 23 com_register_word 8 LATE -1694631439058008882 Reg 0
            if (U1 vid278) == 1 {
                store(#SIMULATION_STATE + 334, U8 ((U8 vid319)))
            }
            


            // 0 com_none 2 0 
            


            // 9 com_level_output_switched 8 7392017726269494413 
            level_output.output = U8 ((U8 vid319))
            level_output.output_is_z = !zid319
            level_output.output_enabled = (U1 vid290) == 1

    



            if in_scope("check_output") {
                let result = check_output(cycle + 1, level_input, level_output)
                handle_test_result(result)
            }

            
            cycle += 1 // Do this late as it signals to the front end that it can update

        }

        set_setting(sim_cycle, U64 cycle)

        let time_now = get_time()

        let time_diff = U64 (time_now - last_time)

        nanos_per_cycle = time_diff / U64 burst_cycles

        if time_now - last_time > 33.ms() {

            // Burst took too long
            burst_cycles = max(1, burst_cycles - 1)

        } else {

            // Burst was too fast
            burst_cycles = burst_cycles + 1

        }

        #if in_scope("on_ui_update"){

            on_ui_update(level_input, level_output)

        }

        last_time = time_now


        def get_target_cycle(time_now: Time) U64 {
            let time_diff = U64 (time_now - original_start_time)
            return orig_start_cycle + ((time_diff / 1000000) * speed) / 1000000 // Double divide to prevent overflow
        }

        var run_target_cycle = get_target_cycle(time_now)

        // Sleep any ahead of time away
        while cycle > Int run_target_cycle && get_command(ctl_command_id) == last_command_id {

            sleep(1.ms())
            cycle -= 1
            mode_refresh()
            cycle += 1

            run_target_cycle = get_target_cycle(get_time())

        }

    }

}

var manual_input_seen = false

run_sim: while true {

    reset_sim()

    const #INPUT  = 0b110_000
    const #OUTPUT = 0b000_110
    const #MOV    = 0b1000_0000
    
    var instructions = array(<Int>, 256)
    var registers    = [U8 0,0,0,0,0,0]
    
    var h = 0
    while h < 6 {
        registers[h] = 0
        h += 1
    }
    var s = 0
    var d = 0
    instructions[0] = #INPUT | #OUTPUT
    instructions[1] = #INPUT | 0
    instructions[2] = #INPUT | 1
    instructions[3] = #INPUT | 2
    instructions[4] = #INPUT | 3
    instructions[5] = #INPUT | 4
    instructions[6] = #INPUT | 5
    var i = 7
    while s <= 6 {
        d = 0
        instructions[i] = #INPUT | s
        i += 1
        while d <= 6 {
            instructions[i] = (s << 3) | d
            i += 1
            d += 1
        }
        s += 1
    }
    
    
    def get_input(cycle: Int) Input {
    
        let instruction = instructions[cycle]
    
        return Input {instruction: U8 instruction, input: U8 random(256)}
    
    }
    
    def check_output(cycle: Int, input: Input, output: Output) TestResult {
    
        let instruction = Int input.instruction
        let from = instruction & 0b111
        let to   = instruction >> 3
    
        if output.output_enabled && to != 6 {
            set_error(`输出不应处于“启用”状态。`)
            return fail
        }
    
        ui_set_instruction(0, #MOV | instruction, cycle)
    
        var value = U8 0
    
        if from <= 5 {
            value = registers[from]
        } elif from == 6 {
            value = input.input
        }
    
    
        if to <= 5 {
            registers[to] = value
        } elif to == 6 {
            if !output.output_enabled {
                set_error(`输出未启用。`)
                return fail
            }
            if output.output != value {
                set_error(`预期输出为 {value}。`)
                return fail
            }
        }
    
        var reg_i = 0
        while reg_i < 6 {
            let value = U8 get_memory(`Reg {reg_i}`)
            if registers[reg_i] != value {
                let value = registers[reg_i]
                set_error(`寄存器 {reg_i} 的值应为 {value}。`)
                return fail
            }
    
            reg_i += 1
        }
    
        if cycle == 63 {
            return win
        }
    
    }
    
    while true {

        mode_refresh()

        #if in_scope("on_ui_update"){

            on_ui_update(level_input, level_output)

        }

        while get_command(ctl_command_id) == last_command_id {

            #if in_scope("on_manual_input"){

                if last_level_manual_input != get_command(ctl_level_manual_input_id) {

                    last_level_manual_input = get_command(ctl_level_manual_input_id)
                    on_manual_input(Int get_command(ctl_level_manual_input))
                    manual_input_seen = true

                }

            }

            sleep(1.ms())

        }

        if manual_input_seen {

            manual_input_seen = false
            break

        }

        last_command_id = get_command(ctl_command_id) // Read this before the command in case of race condition
        set_setting(sim_last_command_id, last_command_id)
        var command = SimCommand get_command(ctl_command)

        switch command

            case run {

                var target_cycle = Int get_setting(sim_target_cycle)

                set_setting(sim_running, U64 1)
                mode_run(target_cycle)
                set_setting(sim_running, U64 0)

            }

            case refresh {}

            case mode_reset {

                var i = 0
                while i < 1024 {
                    input_replay[i] = ctl_input_replay_reset[i]
                    i += 1
                }

                break

            }

            case quit_simulation {

                break run_sim // We need to break out instead of thread_exit() to make sure everything is cleaned up

            }

    }

}

