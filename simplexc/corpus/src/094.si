def mode_run(target_cycle: Int) None {

    if get_setting(sim_test_result) == U64 win { return }
    if (get_setting(sim_test_result) == U64 fail && cycle + 1 >= #CYCLE_PAST_FAIL) { return }
    if get_setting(sim_short_circuit_component_id_1) != 0 { return }

    var halt_run = false

    var original_start_time = Time 0
    var orig_start_cycle = U64 cycle
    var last_time = original_start_time

    var burst_cycles = 1

    var nanos_per_cycle = U64 0

    var i = 0
    var last_target_speed = U64 0
    var speed = U64 1

    while get_command(ctl_command_id) == last_command_id && !halt_run && target_cycle > cycle {
        i += 1

        let target_speed = max(1, get_command(ctl_cycle_speed_ms))

        if target_speed != last_target_speed {

            original_start_time = get_time()
            orig_start_cycle = U64 cycle
            last_time = original_start_time

            speed = min(U64 get_command(ctl_cycle_speed_ms), 10000000000000) // Cap at 10 ghz to avoid overflow
            last_target_speed = target_speed

        }

        let cycles_at_start = cycle
        let burst_target = cycle + burst_cycles

        var burst_target_cycle = min(target_cycle, burst_target)

        def halt() None {

            burst_target_cycle = cycle
            halt_run = true

        }

        def handle_test_result(result: TestResult) None {

            if result != pass {

                var res = result

                halt() // Halt regardless of wether we are above '#CYCLE_PAST_FAIL'

                set_setting(sim_test_result, max(get_setting(sim_test_result), U64 res))

            }

        }

        while cycle < burst_target_cycle {

            if in_scope("get_input") {
                level_input = get_input(cycle + 1)
            }
            

            


            // 1 com_cc_level_input 3 8886406332321803229 Condition
            var vid324 = U3 level_input.condition
            input_replay[0] = U64 level_input.condition
            


            // 3 com_cc_level_input 8 3888339095491657582 Input
            var vid264 = U8 level_input.input
            input_replay[1] = U64 level_input.input
            


            // 57 com_on 2 4210513984558865894 
            var vid256 = U1 1
            


            // 21 com_cc_input_buffer 1 0 
            var vid258 = U1 (U1 0x0)
            


            // 20 com_custom 8 8176888133586290345 
            


            // 14 com_on 2 2360844752040494505 
            var vid260 = U1 1
            


            // 13 com_off 2 5618149503524658051 
            var vid262 = U1 0
            


            // 4 com_custom 8 7466350411961435054 
            


            // 16 com_splitter_bit_8 2 3396623467737259793 
            let input_16 = (U8 vid264)
            var vid266 = U1 input_16
            var vid268 = U1 (input_16 >> 1) & 1
            var vid270 = U1 (input_16 >> 2) & 1
            var vid272 = U1 (input_16 >> 3) & 1
            var vid274 = U1 (input_16 >> 4) & 1
            var vid276 = U1 (input_16 >> 5) & 1
            var vid278 = U1 (input_16 >> 6) & 1
            var vid280 = U1 (input_16 >> 7) & 1
            


            // 66 com_cc_input_buffer 1 0 
            var vid282 = U1 (U1 vid280)
            


            // 67 com_switch_bit 2 2120534575274938466 
            var vid301 = U1 0
            var and_field_id301 = ~vid301
            if (U1 vid282) != 0 {
                vid301 |= U1  (U1 ((U1 vid256)))
                and_field_id301 &= U1  (U1 ((U1 vid256)))
            }
            


            // 18 com_not_bit 2 1882883326118769024 
            var vid284 = U1 (U1 ~(U1 vid280))
            


            // 62 com_cc_input_buffer 1 0 
            var vid286 = U1 (U1 vid278)
            


            // 63 com_switch_bit 2 5352931165111160548 
            if (U1 vid286) != 0 {
                vid301 |= U1  (U1 ((U1 vid256)))
                and_field_id301 &= U1  (U1 ((U1 vid256)))
            }
            


            // 58 com_cc_input_buffer 1 0 
            var vid288 = U1 (U1 vid276)
            


            // 59 com_switch_bit 2 9122377908128214094 
            if (U1 vid288) != 0 {
                vid301 |= U1  (U1 ((U1 vid256)))
                and_field_id301 &= U1  (U1 ((U1 vid256)))
            }
            


            // 53 com_cc_input_buffer 1 0 
            var vid290 = U1 (U1 vid274)
            


            // 54 com_switch_bit 2 5066305969615513406 
            if (U1 vid290) != 0 {
                vid301 |= U1  (U1 ((U1 vid256)))
                and_field_id301 &= U1  (U1 ((U1 vid256)))
            }
            


            // 52 com_cc_input_buffer 1 0 
            var vid292 = U1 (U1 vid272)
            


            // 56 com_switch_bit 2 1374044342408981856 
            if (U1 vid292) != 0 {
                vid301 |= U1  (U1 ((U1 vid256)))
                and_field_id301 &= U1  (U1 ((U1 vid256)))
            }
            


            // 51 com_cc_input_buffer 1 0 
            var vid294 = U1 (U1 vid270)
            


            // 55 com_switch_bit 2 5514338695839166964 
            if (U1 vid294) != 0 {
                vid301 |= U1  (U1 ((U1 vid256)))
                and_field_id301 &= U1  (U1 ((U1 vid256)))
            }
            


            // 60 com_cc_input_buffer 1 0 
            var vid296 = U1 (U1 vid268)
            


            // 61 com_switch_bit 2 1167435631613107699 
            if (U1 vid296) != 0 {
                vid301 |= U1  (U1 ((U1 vid256)))
                and_field_id301 &= U1  (U1 ((U1 vid256)))
            }
            


            // 64 com_cc_input_buffer 1 0 
            var vid298 = U1 (U1 vid266)
            


            // 65 com_switch_bit 2 3574234766437437230 
            if (U1 vid298) != 0 {
                vid301 |= U1  (U1 ((U1 vid256)))
                and_field_id301 &= U1  (U1 ((U1 vid256)))
            }
            if vid301 > and_field_id301 {
                halt()
            }
            let zid301 = vid301 >= and_field_id301
            


            // 17 com_not_bit 2 2869611133818006673 
            var vid318 = U1 (U1 ~(U1 vid301))
            


            // 19 com_or_bit 2 372474313436454401 
            var vid320 = U1 (U1 vid280) | (U1 vid318)
            


            // 15 com_nor_bit 2 7696989941392603461 
            var vid322 = U1 ~((U1 vid280) | (U1 vid318))
            


            // 50 com_cc_input_buffer 3 0 
            var vid326 = U3 (U3 vid324)
            


            // 49 com_splitter_bit_4 2 6193906490784131139 
            let input_49 = (U4 ((U3 vid326)))
            var vid328 = U1 input_49
            var vid330 = U1 (input_49 >> 1) & 1
            var vid332 = U1 (input_49 >> 2) & 1
            var vid406 = U1 (input_49 >> 3) & 1
            


            // 46 com_not_bit 2 3664041052772670870 
            var vid334 = U1 (U1 ~(U1 vid332))
            


            // 45 com_nor_bit 2 3129786946748833371 
            var vid336 = U1 ~((U1 vid334) | (U1 vid258))
            


            // 42 com_nor_bit 2 5408097130491011973 
            var vid338 = U1 ~((U1 vid334) | (U1 vid258))
            


            // 41 com_nor_bit 2 7359637582520103737 
            var vid340 = U1 ~((U1 vid334) | (U1 vid258))
            


            // 35 com_nor_bit 2 696172799145840152 
            var vid342 = U1 ~((U1 vid334) | (U1 vid258))
            


            // 43 com_nor_bit 2 5359394902711919019 
            var vid344 = U1 ~((U1 vid332) | (U1 vid258))
            


            // 39 com_nor_bit 2 4362750358708029831 
            var vid346 = U1 ~((U1 vid332) | (U1 vid258))
            


            // 37 com_nor_bit 2 2359447136326083481 
            var vid348 = U1 ~((U1 vid332) | (U1 vid258))
            


            // 31 com_nor_bit 2 6260019200949405823 
            var vid350 = U1 ~((U1 vid332) | (U1 vid258))
            


            // 47 com_not_bit 2 2874966086940268008 
            var vid352 = U1 (U1 ~(U1 vid330))
            


            // 44 com_nor_bit 2 5690333522251747531 
            var vid354 = U1 ~((U1 vid328) | (U1 vid352))
            


            // 26 com_and_bit 2 2016441372520944738 
            var vid356 = U1 (U1 vid354) & (U1 vid346)
            


            // 7 com_switch_bit 2 2272049062439060492 
            var vid389 = U1 0
            var and_field_id389 = ~vid389
            if (U1 vid356) != 0 {
                vid389 |= U1  (U1 ((U1 vid318)))
                and_field_id389 &= U1  (U1 ((U1 vid318)))
            }
            


            // 30 com_nor_bit 2 3349703662956733413 
            var vid358 = U1 ~((U1 vid328) | (U1 vid352))
            


            // 32 com_and_bit 2 9059040889555934407 
            var vid360 = U1 (U1 vid358) & (U1 vid342)
            


            // 11 com_switch_bit 2 1920272664017781777 
            if (U1 vid360) != 0 {
                vid389 |= U1  (U1 ((U1 vid320)))
                and_field_id389 &= U1  (U1 ((U1 vid320)))
            }
            


            // 33 com_nor_bit 2 4531013009600092975 
            var vid362 = U1 ~((U1 vid328) | (U1 vid330))
            


            // 22 com_and_bit 2 1542887557907712742 
            var vid364 = U1 (U1 vid362) & (U1 vid338)
            


            // 9 com_switch_bit 2 2348854289746251015 
            if (U1 vid364) != 0 {
                vid389 |= U1  (U1 ((U1 vid280)))
                and_field_id389 &= U1  (U1 ((U1 vid280)))
            }
            


            // 25 com_nor_bit 2 1109785615219213011 
            var vid366 = U1 ~((U1 vid328) | (U1 vid330))
            


            // 24 com_and_bit 2 5970603863309583506 
            var vid368 = U1 (U1 vid366) & (U1 vid344)
            


            // 5 com_switch_bit 2 7052567576907402098 
            if (U1 vid368) != 0 {
                vid389 |= U1  (U1 ((U1 vid262)))
                and_field_id389 &= U1  (U1 ((U1 vid262)))
            }
            


            // 48 com_not_bit 2 6171163893763204973 
            var vid370 = U1 (U1 ~(U1 vid328))
            


            // 38 com_nor_bit 2 2557813104896249374 
            var vid372 = U1 ~((U1 vid370) | (U1 vid352))
            


            // 40 com_and_bit 2 6024647775129861191 
            var vid374 = U1 (U1 vid372) & (U1 vid336)
            


            // 12 com_switch_bit 2 1174072881225060230 
            if (U1 vid374) != 0 {
                vid389 |= U1  (U1 ((U1 vid322)))
                and_field_id389 &= U1  (U1 ((U1 vid322)))
            }
            


            // 36 com_nor_bit 2 3269455986735575066 
            var vid376 = U1 ~((U1 vid370) | (U1 vid330))
            


            // 23 com_and_bit 2 383518928334999337 
            var vid378 = U1 (U1 vid376) & (U1 vid348)
            


            // 6 com_switch_bit 2 7960873783703153982 
            if (U1 vid378) != 0 {
                vid389 |= U1  (U1 ((U1 vid260)))
                and_field_id389 &= U1  (U1 ((U1 vid260)))
            }
            


            // 34 com_nor_bit 2 4008670173898440276 
            var vid380 = U1 ~((U1 vid370) | (U1 vid352))
            


            // 27 com_and_bit 2 6423978042396298920 
            var vid382 = U1 (U1 vid380) & (U1 vid350)
            


            // 8 com_switch_bit 2 4137342592618905627 
            if (U1 vid382) != 0 {
                vid389 |= U1  (U1 ((U1 vid301)))
                and_field_id389 &= U1  (U1 ((U1 vid301)))
            }
            


            // 28 com_nor_bit 2 4740189023969019921 
            var vid384 = U1 ~((U1 vid370) | (U1 vid330))
            


            // 29 com_and_bit 2 5993871698827884482 
            var vid386 = U1 (U1 vid384) & (U1 vid340)
            


            // 10 com_switch_bit 2 4956187003608843683 
            if (U1 vid386) != 0 {
                vid389 |= U1  (U1 ((U1 vid284)))
                and_field_id389 &= U1  (U1 ((U1 vid284)))
            }
            if vid389 > and_field_id389 {
                halt()
            }
            let zid389 = vid389 >= and_field_id389
            


            // 0 com_none 2 0 
            


            // 2 com_cc_level_output 1 412430996129987082 Result
            level_output.result = U1 ((U1 vid389))
            level_output.result_is_z = !zid389

    



            if in_scope("check_output") {
                let result = check_output(cycle + 1, level_input, level_output)
                handle_test_result(result)
            }

            
            cycle += 1 // Do this late as it signals to the front end that it can update

        }

        set_setting(sim_cycle, U64 cycle)

        let time_now = get_time()

        let time_diff = U64 (time_now - last_time)

        nanos_per_cycle = time_diff / U64 burst_cycles

        if time_now - last_time > 33.ms() {

            // Burst took too long
            burst_cycles = max(1, burst_cycles - 1)

        } else {

            // Burst was too fast
            burst_cycles = burst_cycles + 1

        }

        #if in_scope("on_ui_update"){

            on_ui_update(level_input, level_output)

        }

        last_time = time_now


        def get_target_cycle(time_now: Time) U64 {
            let time_diff = U64 (time_now - original_start_time)
            return orig_start_cycle + ((time_diff / 1000000) * speed) / 1000000 // Double divide to prevent overflow
        }

        var run_target_cycle = get_target_cycle(time_now)

        // Sleep any ahead of time away
        while cycle > Int run_target_cycle && get_command(ctl_command_id) == last_command_id {

            sleep(1.ms())
            cycle -= 1
            mode_refresh()
            cycle += 1

            run_target_cycle = get_target_cycle(get_time())

        }

    }

}

var manual_input_seen = false

run_sim: while true {

    reset_sim()

    
    def get_input(cycle: Int) Input {
        var x = cycle
        x ^= x << 1
        x ^= x >> 5
        x ^= x << 8
    
        var condition = x & 0b111
        var value = (x >> 3) & 0xff
    
        if value & 0b10000000 != 0 {
            value = value ^ 0xff
            value += 1
            value = -value
        }
    
        var condition_text = " "
        if (condition / 4) % 2 == 0 {
            condition_text += "[F]"
        } else {
            condition_text += "[T]"
        }
        if (condition / 2) % 2 == 0 {
            condition_text += "[F]"
        } else {
            condition_text += "[T]"
        }
        if (condition / 1) % 2 == 0 {
            condition_text += "[F]"
        } else {
            condition_text += "[T]"
        }
        condition_text += " "
    
        ui_set_text("table[1][1]", `{value}`)
    
        switch condition
            case 0 {
                ui_set_text("table[2][1]", `永不成立`)
                ui_set_text("table[3][1]", "[F]")
            }
            case 1 {
                ui_set_text("table[2][1]", `必定成立`)
                ui_set_text("table[3][1]", "[T]")
            }
            case 2 {
                ui_set_text("table[2][1]", `{value} = 0`)
                if value == 0 {
                    ui_set_text("table[3][1]", "[T]")
                } else {
                    ui_set_text("table[3][1]", "[F]")
                }
            }
            case 3 {
                ui_set_text("table[2][1]", `{value} ≠ 0`)
                if value == 0 {
                    ui_set_text("table[3][1]", "[F]")
                } else {
                    ui_set_text("table[3][1]", "[T]")
                }
            }
            case 4 {
                ui_set_text("table[2][1]", `{value} < 0`)
                if value < 0 {
                    ui_set_text("table[3][1]", "[T]")
                } else {
                    ui_set_text("table[3][1]", "[F]")
                }
            }
            case 5 {
                ui_set_text("table[2][1]", `{value} ≥ 0`)
                if value < 0 {
                    ui_set_text("table[3][1]", "[F]")
                } else {
                    ui_set_text("table[3][1]", "[T]")
                }
            }
            case 6 {
                ui_set_text("table[2][1]", `{value} ≤ 0`)
                if value <= 0 {
                    ui_set_text("table[3][1]", "[T]")
                } else {
                    ui_set_text("table[3][1]", "[F]")
                }
            }
            case 7 {
                ui_set_text("table[2][1]", `{value} > 0`)
                if value <= 0 {
                    ui_set_text("table[3][1]", "[F]")
                } else {
                    ui_set_text("table[3][1]", "[T]")
                }
            }
    
        ui_set_text("table[0][1]", condition_text)
    
        return Input {condition: U3 condition, input: U8 value}
    
    }
    
    def check_output(cycle: Int, input: Input, output: Output) TestResult {
    
        if output.result_is_z {
            ui_set_text("table[4][1]", "[Z]")
            set_error(`输出不应为空（高阻态）`)
            return fail
        }
    
        if output.result == 0 {
            ui_set_text("table[4][1]", "[F]")
        } else {
            ui_set_text("table[4][1]", "[T]")
        }
    
        var expected = false
    
        var condition = input.condition
        var value = asr(Int input.input << 56, 56)
    
        switch condition
            case 0 {
                expected = false
            }
            case 1 {
                expected = true
            }
            case 2 {
                expected = value == 0
            }
            case 3 {
                expected = value != 0
            }
            case 4 {
                expected = value < 0
            }
            case 5 {
                expected = value >= 0
            }
            case 6 {
                expected = value <= 0
            }
            case 7 {
                expected = value > 0
            }
    
        if expected {
            if output.result == 0 {
                return fail
            }
        } else {
            if output.result != 0 {
                return fail
            }
        }
    
        if cycle == 2047 {
            return win
        }
    }
    
    while true {

        mode_refresh()

        #if in_scope("on_ui_update"){

            on_ui_update(level_input, level_output)

        }

        while get_command(ctl_command_id) == last_command_id {

            #if in_scope("on_manual_input"){

                if last_level_manual_input != get_command(ctl_level_manual_input_id) {

                    last_level_manual_input = get_command(ctl_level_manual_input_id)
                    on_manual_input(Int get_command(ctl_level_manual_input))
                    manual_input_seen = true

                }

            }

            sleep(1.ms())

        }

        if manual_input_seen {

            manual_input_seen = false
            break

        }

        last_command_id = get_command(ctl_command_id) // Read this before the command in case of race condition
        set_setting(sim_last_command_id, last_command_id)
        var command = SimCommand get_command(ctl_command)

        switch command

            case run {

                var target_cycle = Int get_setting(sim_target_cycle)

                set_setting(sim_running, U64 1)
                mode_run(target_cycle)
                set_setting(sim_running, U64 0)

            }

            case refresh {}

            case mode_reset {

                var i = 0
                while i < 1024 {
                    input_replay[i] = ctl_input_replay_reset[i]
                    i += 1
                }

                break

            }

            case quit_simulation {

                break run_sim // We need to break out instead of thread_exit() to make sure everything is cleaned up

            }

    }

}

