def ui_set_position(id: Str, x: Int, y: Int) None {
    switch id
        case "instruction" { store(ui_buffer + 8, U64 (x << 16 | (y & 0xffff))) }
}

def ui_set_width(id: Str, value: Int) None {
    switch id
        case "instruction" { store(ui_buffer + 16, U64 value) }
}

def ui_set_hidden(id: Str, value: Bool) None {
    switch id
        case "instruction" { store(ui_buffer + 0, U64 value) }
}

def ui_set_size(id: Str, value: Int) None {
    switch id
        case "instruction" { store(ui_buffer + 32, U64 value) }
}

def ui_set_column_header_size(id: Str, value: Int) None {
    switch id
}

def ui_set_row_header_size(id: Str, value: Int) None {
    switch id
}

def ui_set_color(id: Str, value: Int) None {
    switch id
}

def ui_set_address_color(id: Str, value: Int) None {
    switch id
}

def ui_set_instruction_color(id: Str, value: Int) None {
    switch id
        case "instruction" { store(ui_buffer + 40, U64 value) }
}

def ui_set_description_color(id: Str, value: Int) None {
    switch id
        case "instruction" { store(ui_buffer + 48, U64 value) }
}

def ui_set_column_header_color(id: Str, value: Int) None {
    switch id
}

def ui_set_row_header_color(id: Str, value: Int) None {
    switch id
        case "instruction" { store(ui_buffer + 56, U64 value) }
}

def ui_set_text(id: Str, text: Str) None {
    switch id
}

def ui_set_image_name(id: Str, text: Str) None {
    switch id
}

def ui_set_instruction(index: Int, code: Int, pointer: Int) None {
    switch index
        case 0 {
            store(ui_buffer + 64, code)
            store(ui_buffer + 72, pointer)
        }
}
def add_keyboard_value(key_down: Bool, key: U8) None {
    let value = U16 key_down | (U16 key) << 8
    var index = load(<U16>, #SIMULATION_KEYBOARD_CHARACTER + 4098)
    store(#SIMULATION_KEYBOARD_CHARACTER + index, value)
    store(#SIMULATION_KEYBOARD_CHARACTER + 4098, (index + 8) % 4096)

}
def get_last_time() Int { return Int time_component_last }
def get_screen_connection(screen_name: Str) Str {
}
def get_memory(label: Str) Int { 
    if label == "Count" { return Int (U64 load(<U8>, #SIMULATION_STATE + 416) & 255) }
    if label == "Reg 0" { return Int (U64 load(<U8>, #SIMULATION_STATE + 418) & 255) }
    if label == "Reg 1" { return Int (U64 load(<U8>, #SIMULATION_STATE + 420) & 255) }
    if label == "Reg 2" { return Int (U64 load(<U8>, #SIMULATION_STATE + 422) & 255) }
    if label == "Reg 3" { return Int (U64 load(<U8>, #SIMULATION_STATE + 424) & 255) }
    if label == "Reg 4" { return Int (U64 load(<U8>, #SIMULATION_STATE + 426) & 255) }
    if label == "Reg 5" { return Int (U64 load(<U8>, #SIMULATION_STATE + 428) & 255) }
}
