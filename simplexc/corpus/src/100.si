def get_load_port_input(label: Str) Int { 
}
def get_screen_settings(label: Str, index: Int) Int { 
}
def get_output(user_label: Str, index: Int) Int { 
    if user_label == "Count" && index == 0 { return Int (U64 load(<U8>, #SIMULATION_STATE + 417)) }
    if user_label == "Reg 0" && index == 0 { return Int (U64 load(<U8>, #SIMULATION_STATE + 419)) }
    if user_label == "Reg 1" && index == 0 { return Int (U64 load(<U8>, #SIMULATION_STATE + 421)) }
    if user_label == "Reg 2" && index == 0 { return Int (U64 load(<U8>, #SIMULATION_STATE + 423)) }
    if user_label == "Reg 3" && index == 0 { return Int (U64 load(<U8>, #SIMULATION_STATE + 425)) }
    if user_label == "Reg 4" && index == 0 { return Int (U64 load(<U8>, #SIMULATION_STATE + 427)) }
    if user_label == "Reg 5" && index == 0 { return Int (U64 load(<U8>, #SIMULATION_STATE + 429)) }
}
def get_ram_value(label: Str, address: Int, size: @Size) @Size {
    if label == 'Program' { return load(type_of(size), #DATA_1948035650992482295 + (256 - ((size(size) + 7) / 8)) - address)) } 
}
def set_ram_value(label: Str, offset: Int, value: @Type) None {
    if label == 'Program' { store(#DATA_1948035650992482295 + 256 - offset - (size(value) + 7) / 8, value) }
}

const #CYCLE_PAST_FAIL = 0
def max(a: TestResult, b: TestResult) TestResult {
    return TestResult max(U64 a, U64 b)
}

def set_error(input: Str) None {

    let len = input.len()

    store(error_buffer, U16 len)

    var i = 0
    while i < len {
        store(error_buffer + i + 2, U8 input[i])
        i += 1
    }
}


var cycle = -1
var last_command_id = U64 0
var last_level_manual_input = U64 0
var time_component_last = U64 0

def reset_sim() None {

    time_component_last = U64 0

    set_error("")

    global_seed = Seed (get_command(ctl_test) + 1) // 0 can't be seed

    last_level_manual_input = 0
    set_setting(sim_cycle, #U64_HIGH) // -1
    set_setting(sim_short_circuit_component_id_1, U64 0)
    set_setting(sim_short_circuit_component_id_2, U64 0)
    set_setting(sim_test_result, U64 pass)
    cycle = -1

  
    memory_clear(#SIMULATION_KEYBOARD_CHARACTER, 8192)
    memory_clear(#SIMULATION_KEYBOARD_COORDINATE, 8192)
    memory_clear(#SIMULATION_STATE, 473)
    memory_copy(#RESET_DATA_1948035650992482295 - 2048, #DATA_1948035650992482295 - 2048, 4352)


}

