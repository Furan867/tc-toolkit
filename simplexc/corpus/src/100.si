const #SETTINGS_1948035650992482295   = Ptr 2416508665856 // """ & $c_alloc(4096) & "\n" & """
type TestResult Enum[pass, win, fail]


def set_text(text: Str, offset: Int) None {
    let length = text.len()
    store(ui_buffer + offset, length)
    var i = 0
    while i < length {
        store(ui_buffer + offset + 8 + i, U8 text[i])
        i += 1
    }
}

