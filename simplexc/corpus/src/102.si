            if (U1 vid394) == 1 {
                store(#SIMULATION_STATE + 576, U8 ((U8 vid553)))
            }
            


            // 126 com_register_word 8 LATE -1694631439058008882 Reg 0
            if (U1 vid408) == 1 {
                store(#SIMULATION_STATE + 574, U8 ((U8 vid553)))
            }
            


            // 125 com_counter 8 LATE -7159672995443721992 Count
            if (U1 vid501) == 1 {

                store(#SIMULATION_STATE + 572, U8 ((U8 vid553)))
            } else {

                store(#SIMULATION_STATE + 572, U8 ((load(<U8>, #SIMULATION_STATE + 572) & 255 + 1)))
            }
            


            // 0 com_none 2 0 
            


            // 9 com_level_output_switched 8 7392017726269494413 
            level_output.output = U8 ((U8 vid553))
            level_output.output_is_z = !zid553
            level_output.output_enabled = (U1 vid404) == 1
            var logic_idx_30 = Int (U32 ((U8 vid360))) & 0xffff
            var count_30 = load(<U16>, #SETTINGS_1948035650992482295)
            var start_30 = #SETTINGS_1948035650992482295 + 2
            var finish_30 = start_30 + Int (count_30 * 2)
            while Int start_30 < Int finish_30 {
                if Int load(<U16>, start_30) == logic_idx_30 {
                    halt()
                    break
                }
                start_30 += 2
            }

    



            if in_scope("check_output") {
                let result = check_output(cycle + 1, level_input, level_output)
                handle_test_result(result)
            }

            
            cycle += 1 // Do this late as it signals to the front end that it can update

        }

        set_setting(sim_cycle, U64 cycle)

        let time_now = get_time()

        let time_diff = U64 (time_now - last_time)

        nanos_per_cycle = time_diff / U64 burst_cycles

        if time_now - last_time > 33.ms() {

            // Burst took too long
            burst_cycles = max(1, burst_cycles - 1)

        } else {

            // Burst was too fast
            burst_cycles = burst_cycles + 1

        }

        #if in_scope("on_ui_update"){

            on_ui_update(level_input, level_output)

        }

        last_time = time_now


        def get_target_cycle(time_now: Time) U64 {
            let time_diff = U64 (time_now - original_start_time)
            return orig_start_cycle + ((time_diff / 1000000) * speed) / 1000000 // Double divide to prevent overflow
        }

        var run_target_cycle = get_target_cycle(time_now)

        // Sleep any ahead of time away
        while cycle > Int run_target_cycle && get_command(ctl_command_id) == last_command_id {

            sleep(1.ms())
            cycle -= 1
            mode_refresh()
            cycle += 1

            run_target_cycle = get_target_cycle(get_time())

        }

    }

}

var manual_input_seen = false

run_sim: while true {

    reset_sim()

    const #INPUT  = U8 0b110_000
    const #OUTPUT = U8 0b000_110
    
    const #IMM    = U8 0b0000_0000
    const #CALC   = U8 0b0100_0000
    const #MOVE   = U8 0b1000_0000
    const #COND   = U8 0b1100_0000
    
    const #NAND = U8 0
    const #OR   = U8 1
    const #AND  = U8 2
    const #NOR  = U8 3
    const #ADD  = U8 4
    const #SUB  = U8 5
    
    const #NEVER  = U8 0
    const #ALWAYS = U8 1
    const #EQ     = U8 2
    const #NE     = U8 3
    const #LT     = U8 4
    const #GE     = U8 5
    const #LE     = U8 6
    const #GT     = U8 7
    
    const #NOP   = #COND | #NEVER
    
    var registers = [U8 0,0,0,0,0,0]
    var counter   = U8 0
    
    def get_input(cycle: Int) Input {
        return Input {input: U8 random(256)}
    }
    
    def check_output(cycle: Int, input: Input, output: Output) TestResult {
    
    
        ui_set_instruction(0, cycle, 0)
        ui_set_instruction(1, cycle, 0)
        ui_set_instruction(2, cycle, 0)
        ui_set_instruction(3, cycle, 0)
        ui_set_instruction(4, cycle, 0)
        ui_set_instruction(5, cycle, 0)
    
        let actual_counter = get_output("Count", 0)
        let instruction = get_ram_value("Program", actual_counter, <U8>)
    
        ui_set_instruction(0, Int instruction, cycle)
    
        let opcode = instruction >> 6
    
        let to   = (instruction >> 3) & 0b111
    
        if output.output_enabled && (opcode != #MOVE >> 6 || to != 6) {
            set_error(`输出不应处于“启用”状态。`)
            return fail
        }
    
        switch U8 opcode
            case #IMM {
                registers[0] = instruction
                counter += 1
            }
            case #CALC >> 6 {
                let alu_code = instruction & 0b111
                let r1 = registers[1]
                let r2 = registers[2]
    
                switch U8 alu_code
                    case #OR {
                        registers[3] = r1 | r2
                    }
                    case #NAND {
                        registers[3] = ~(r1 & r2) & 0xff
                    }
                    case #NOR {
                        registers[3] = ~(r1 | r2) & 0xff
                    }
                    case #AND {
                        registers[3] = r1 & r2
                    }
                    case #ADD {
                        registers[3] = (r1 + r2) & 0xff
                    }
                    case #SUB {
                        registers[3] = (r1 - r2) & 0xff
                    }
    
                counter += 1
    
            }
            case #MOVE >> 6 {
    
                let from = instruction & 0b111
                let to   = (instruction >> 3) & 0b111
    
                var value = U8 0
                if from <= 5 {
                    value = registers[from]
                } elif from == 6 {
                    value = U8 input.input
                }
    
                if to <= 5 {
                    registers[to] = value
                } elif to == 6 {
                    if !output.output_enabled {
                        set_error(`输出未启用。`)
                        return fail
                    }
                    if output.output != U8 value {
                        set_error(`预期输出为 {value}。`)
                        return fail
                    }
                }
    
                counter += 1
            }
            case #COND >> 6 {
                let cond = instruction & 0b111
    
                let equal = registers[3] == 0
                let less  = registers[3] > 127
    
                var set_counter = false
    
                switch U8 cond
                    case #NEVER {}
                    case #ALWAYS {
                        set_counter = true
                    }
                    case #EQ {
                        set_counter = equal
                    }
                    case #NE {
                        set_counter = !equal
                    }
                    case #LT {
                        set_counter = less
                    }
                    case #GE {
                        set_counter = !less
                    }
                    case #LE {
                        set_counter = less || equal
                    }
                    case #GT {
                        set_counter = !less && !equal
                    }
    
    
                if set_counter {
                    counter = registers[0]
                } else {
                    counter += 1
                }
            }
    
        var reg_i = 0
        while reg_i < 6 {
            let value = U8 get_memory(`Reg {reg_i}`)
            if registers[reg_i] != value {
                let value = registers[reg_i]
                set_error(`寄存器 {reg_i} 的值应为 {value}。`)
                return fail
            }
    
            reg_i += 1
        }
    
        if U8 get_memory("Count") != counter {
            let expected_value = counter
            set_error(`计数器的值应为 {expected_value}。`)
            return fail
        }
    
        if cycle == 255 {
            return win
        }
    }
    
    while true {

        mode_refresh()

        #if in_scope("on_ui_update"){

            on_ui_update(level_input, level_output)

        }

        while get_command(ctl_command_id) == last_command_id {

            #if in_scope("on_manual_input"){

                if last_level_manual_input != get_command(ctl_level_manual_input_id) {

                    last_level_manual_input = get_command(ctl_level_manual_input_id)
                    on_manual_input(Int get_command(ctl_level_manual_input))
                    manual_input_seen = true

                }

            }

            sleep(1.ms())

        }

        if manual_input_seen {

            manual_input_seen = false
            break

        }

        last_command_id = get_command(ctl_command_id) // Read this before the command in case of race condition
        set_setting(sim_last_command_id, last_command_id)
        var command = SimCommand get_command(ctl_command)

        switch command

            case run {

                var target_cycle = Int get_setting(sim_target_cycle)

                set_setting(sim_running, U64 1)
                mode_run(target_cycle)
                set_setting(sim_running, U64 0)

            }

            case refresh {}

            case mode_reset {

                var i = 0
                while i < 1024 {
                    input_replay[i] = ctl_input_replay_reset[i]
                    i += 1
                }

                break

            }

            case quit_simulation {

                break run_sim // We need to break out instead of thread_exit() to make sure everything is cleaned up

            }

    }

}

