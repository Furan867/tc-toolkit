        0b1010100010001010100000001,
        0b1010101110101010111011101,
        0b1010100000101000100000101,
        0b1111111111111111111111111,
    
        0b1111111111111111111111111,
        0b1000000000000000000000001,
        0b1111101011111011101110111,
        0b1000101000100000100010101,
        0b1110111011101110101110101,
        0b1000100000101000101010101,
        0b1011101111111011101011101,
        0b1000000000100000100000001,
        0b1111111111111111111111111,
    
        0b1111111111111111111111111,
        0b1010000000100000001000001,
        0b1011101111111011111110101,
        0b1000001000101010100010101,
        0b1110101011101010101011101,
        0b1010100010000010001000001,
        0b1010111010111110111011101,
        0b1000100000000000001010001,
        0b1111111111111111111111111,
    
        0b1111111111111111111111111,
        0b1010000000001000100010001,
        0b1010101111101110111010101,
        0b1000101000000010000000101,
        0b1110111111111111101111101,
        0b1000100000000000000010001,
        0b1010101110111010101111101,
        0b1010001000100010101000001,
        0b1111111111111111111111111,
    
        0b1111111111111111111111111,
        0b1000000000000000100000001,
        0b1111101110111110111010101,
        0b1000001000100000000010101,
        0b1110111011111011111010101,
        0b1000100000001000100010101,
        0b1111101110111111101011101,
        0b1000000010100000001010001,
        0b1111111111111111111111111,
    ]
    
    let maze = get_test()
    
    var x_pos = 0
    var y_pos = 0
    var rot = 3
    
    def looking_at(x: Int, y: Int) Int {
        let row = #MAZES[maze * 9 + y]
        return ((row >> (25 - x)) & 1)
    }
    
    def is_wall(x: Int, y: Int) Bool {
        return looking_at(x, y) == 1
    }
    
    def set_state(x: Int, y: Int, rotation: Int) None {
    
        x_pos = x
        y_pos = y
        rot = rotation
    
        ui_set_hidden("robot_0", true)
        ui_set_hidden("robot_1", true)
        ui_set_hidden("robot_2", true)
        ui_set_hidden("robot_3", true)
    
        let x_px = - 13 * 24 + x * 24
        let y_px = y * 24 - 150 + 32 * 2 - 2
    
        var lx = 0
        var ly = 0
        var wall = false
    
        switch rotation
            case 0 {
                lx = x_px
                ly = y_px - 24
                ui_set_position("robot_0", x_px, y_px)
                ui_set_hidden("robot_0", false)
                wall = is_wall(x, y - 1)
            }
            case 1 {
                lx = x_px + 24
                ly = y_px
                ui_set_position("robot_1", x_px, y_px)
                ui_set_hidden("robot_1", false)
                wall = is_wall(x + 1, y)
            }
            case 2 {
                lx = x_px
                ly = y_px + 24
                ui_set_position("robot_2", x_px, y_px)
                ui_set_hidden("robot_2", false)
                wall = is_wall(x, y + 1)
            }
            case 3 {
                lx = x_px - 24
                ly = y_px
                ui_set_position("robot_3", x_px, y_px)
                ui_set_hidden("robot_3", false)
                wall = is_wall(x - 1, y)
            }
    
        if wall {
            ui_set_position("looking_at_1", lx, ly)
            ui_set_hidden("looking_at_0", true)
            ui_set_hidden("looking_at_1", false)
        } else {
            ui_set_position("looking_at_0", lx, ly)
            ui_set_hidden("looking_at_0", false)
            ui_set_hidden("looking_at_1", true)
        }
    
    }
    
    def move(rotation: Int) None {
        var x = x_pos
        var y = y_pos
        var r = rot
    
        switch rotation
            case 0 {
                r = (r + 3) % 4
            }
            case 1 {
                switch r
                    case 0 { y -= 1 }
                    case 1 { x += 1 }
                    case 2 { y += 1 }
                    case 3 { x -= 1 }
    
                if is_wall(x, y) {
                    x = x_pos
                    y = y_pos
                }
    
            }
            case 2 {
                r = (r + 1) % 4
            }
    
        set_state(x, y, r)
    
    }
    
    def on_manual_input(input: Int) None {
    
        if input < 4 {
            move(input)
        }
    
    }
    
    def get_input_switched() Int {
    
        var x = x_pos
        var y = y_pos
    
        switch rot
            case 0 { y -= 1 }
            case 1 { x += 1 }
            case 2 { y += 1 }
            case 3 { x -= 1 }
    
        return looking_at(x, y)
    
    }
    
    def check_output_switched(output: Int) TestResult {
    
        move(output)
    
        let x = x_pos
        let y = y_pos
        let r = rot
    
        if x == 2 && y == 1 && r == 0 {
            return win
        }
    
    }
    
    ui_set_hidden("maze_0", true)
    ui_set_hidden("maze_1", true)
    ui_set_hidden("maze_2", true)
    ui_set_hidden("maze_3", true)
    ui_set_hidden("maze_4", true)
    ui_set_hidden("maze_5", true)
    ui_set_hidden("maze_6", true)
    ui_set_hidden("maze_7", true)
    
    switch get_test()
        case 0 { ui_set_hidden("maze_0", false) }
        case 1 { ui_set_hidden("maze_1", false) }
        case 2 { ui_set_hidden("maze_2", false) }
        case 3 { ui_set_hidden("maze_3", false) }
        case 4 { ui_set_hidden("maze_4", false) }
        case 5 { ui_set_hidden("maze_5", false) }
        case 6 { ui_set_hidden("maze_6", false) }
        case 7 { ui_set_hidden("maze_7", false) }
    
    set_state(24, 7, 3)
    
    while true {

        mode_refresh()

        #if in_scope("on_ui_update"){

            on_ui_update(level_input, level_output)

        }

        while get_command(ctl_command_id) == last_command_id {

            #if in_scope("on_manual_input"){

                if last_level_manual_input != get_command(ctl_level_manual_input_id) {

                    last_level_manual_input = get_command(ctl_level_manual_input_id)
                    on_manual_input(Int get_command(ctl_level_manual_input))
                    manual_input_seen = true

                }

            }

            sleep(1.ms())

        }

        if manual_input_seen {

            manual_input_seen = false
            break

        }

        last_command_id = get_command(ctl_command_id) // Read this before the command in case of race condition
        set_setting(sim_last_command_id, last_command_id)
        var command = SimCommand get_command(ctl_command)

        switch command

            case run {

                var target_cycle = Int get_setting(sim_target_cycle)

                set_setting(sim_running, U64 1)
                mode_run(target_cycle)
                set_setting(sim_running, U64 0)

            }

            case refresh {}

            case mode_reset {

                var i = 0
                while i < 1024 {
                    input_replay[i] = ctl_input_replay_reset[i]
                    i += 1
                }

                break

            }

            case quit_simulation {

                break run_sim // We need to break out instead of thread_exit() to make sure everything is cleaned up

            }

    }

}

