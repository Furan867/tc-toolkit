def ui_set_position(id: Str, x: Int, y: Int) None {
    switch id
        case "maze_0" { store(ui_buffer + 8, U64 (x << 16 | (y & 0xffff))) }
        case "maze_1" { store(ui_buffer + 40, U64 (x << 16 | (y & 0xffff))) }
        case "maze_2" { store(ui_buffer + 72, U64 (x << 16 | (y & 0xffff))) }
        case "maze_3" { store(ui_buffer + 104, U64 (x << 16 | (y & 0xffff))) }
        case "maze_4" { store(ui_buffer + 136, U64 (x << 16 | (y & 0xffff))) }
        case "maze_5" { store(ui_buffer + 168, U64 (x << 16 | (y & 0xffff))) }
        case "maze_6" { store(ui_buffer + 200, U64 (x << 16 | (y & 0xffff))) }
        case "maze_7" { store(ui_buffer + 232, U64 (x << 16 | (y & 0xffff))) }
        case "robot_0" { store(ui_buffer + 264, U64 (x << 16 | (y & 0xffff))) }
        case "robot_1" { store(ui_buffer + 296, U64 (x << 16 | (y & 0xffff))) }
        case "robot_2" { store(ui_buffer + 328, U64 (x << 16 | (y & 0xffff))) }
        case "robot_3" { store(ui_buffer + 360, U64 (x << 16 | (y & 0xffff))) }
        case "looking_at_0" { store(ui_buffer + 392, U64 (x << 16 | (y & 0xffff))) }
        case "looking_at_1" { store(ui_buffer + 424, U64 (x << 16 | (y & 0xffff))) }
}

