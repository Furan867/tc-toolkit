def ui_set_image_name(id: Str, text: Str) None {
    switch id
        case "maze_0" { set_text(text, 10000) }
        case "maze_1" { set_text(text, 20000) }
        case "maze_2" { set_text(text, 30000) }
        case "maze_3" { set_text(text, 40000) }
        case "maze_4" { set_text(text, 50000) }
        case "maze_5" { set_text(text, 60000) }
        case "maze_6" { set_text(text, 70000) }
        case "maze_7" { set_text(text, 80000) }
        case "robot_0" { set_text(text, 90000) }
        case "robot_1" { set_text(text, 100000) }
        case "robot_2" { set_text(text, 110000) }
        case "robot_3" { set_text(text, 120000) }
        case "looking_at_0" { set_text(text, 130000) }
        case "looking_at_1" { set_text(text, 140000) }
}

