            if (U1 vid332) != 0 {
                vid335 |= U1  (U1 ((U1 vid278)))
                and_field_id335 &= U1  (U1 ((U1 vid278)))
            }
            if vid335 > and_field_id335 {
                halt()
            }
            let zid335 = vid335 >= and_field_id335
            


            // 38 com_or_bit 2 2058182596705425057 
            var vid338 = U1 (U1 vid330) | (U1 vid335)
            


            // 37 com_not_bit 2 6928733552471238318 
            var vid340 = U1 (U1 ~(U1 vid338))
            


            // 36 com_switch_bit 2 5381048847541482383 
            var vid343 = U1 0
            var and_field_id343 = ~vid343
            if (U1 vid340) != 0 {
                vid343 |= U1  (U1 ((U1 vid276)))
                and_field_id343 &= U1  (U1 ((U1 vid276)))
            }
            if vid343 > and_field_id343 {
                halt()
            }
            let zid343 = vid343 >= and_field_id343
            


            // 43 com_or_bit 2 6576269560462453619 
            var vid346 = U1 (U1 vid338) | (U1 vid343)
            


            // 40 com_not_bit 2 1794756680630820583 
            var vid348 = U1 (U1 ~(U1 vid346))
            


            // 41 com_switch_word 8 3433296884041752478 
            if (U1 vid348) != 0 {
                vid351 |= U8  (U8 ((U8 vid256)))
                and_field_id351 &= U8  (U8 ((U8 vid256)))
            }
            


            // 35 com_switch_word 8 2325111564786562749 
            if (U1 vid343) != 0 {
                vid351 |= U8  (U8 ((U8 vid258)))
                and_field_id351 &= U8  (U8 ((U8 vid258)))
            }
            


            // 30 com_switch_word 8 1285687493683558632 
            if (U1 vid335) != 0 {
                vid351 |= U8  (U8 ((U8 vid260)))
                and_field_id351 &= U8  (U8 ((U8 vid260)))
            }
            


            // 25 com_switch_word 8 7088583474713792515 
            if (U1 vid327) != 0 {
                vid351 |= U8  (U8 ((U8 vid262)))
                and_field_id351 &= U8  (U8 ((U8 vid262)))
            }
            


            // 20 com_switch_word 8 3851709080274161441 
            if (U1 vid319) != 0 {
                vid351 |= U8  (U8 ((U8 vid264)))
                and_field_id351 &= U8  (U8 ((U8 vid264)))
            }
            


            // 11 com_switch_word 8 144005551810293577 
            if (U1 vid311) != 0 {
                vid351 |= U8  (U8 ((U8 vid266)))
                and_field_id351 &= U8  (U8 ((U8 vid266)))
            }
            


            // 14 com_switch_word 8 2530008831530180573 
            if (U1 vid303) != 0 {
                vid351 |= U8  (U8 ((U8 vid268)))
                and_field_id351 &= U8  (U8 ((U8 vid268)))
            }
            


            // 9 com_switch_word 8 9030586414613794090 
            if (U1 vid295) != 0 {
                vid351 |= U8  (U8 ((U8 vid270)))
                and_field_id351 &= U8  (U8 ((U8 vid270)))
            }
            if vid351 > and_field_id351 {
                halt()
            }
            let zid351 = vid351 >= and_field_id351
            


            // 0 com_none 2 0 
            


            // 2 com_level_output_word 8 4717420930798948972 Result
            level_output.result = U8 ((U8 vid351))
            level_output.result_is_z = !zid351

    



            if in_scope("check_output") {
                let result = check_output(cycle + 1, level_input, level_output)
                handle_test_result(result)
            }

            
            cycle += 1 // Do this late as it signals to the front end that it can update

        }

        set_setting(sim_cycle, U64 cycle)

        let time_now = get_time()

        let time_diff = U64 (time_now - last_time)

        nanos_per_cycle = time_diff / U64 burst_cycles

        if time_now - last_time > 33.ms() {

            // Burst took too long
            burst_cycles = max(1, burst_cycles - 1)

        } else {

            // Burst was too fast
            burst_cycles = burst_cycles + 1

        }

        #if in_scope("on_ui_update"){

            on_ui_update(level_input, level_output)

        }

        last_time = time_now


        def get_target_cycle(time_now: Time) U64 {
            let time_diff = U64 (time_now - original_start_time)
            return orig_start_cycle + ((time_diff / 1000000) * speed) / 1000000 // Double divide to prevent overflow
        }

        var run_target_cycle = get_target_cycle(time_now)

        // Sleep any ahead of time away
        while cycle > Int run_target_cycle && get_command(ctl_command_id) == last_command_id {

            sleep(1.ms())
            cycle -= 1
            mode_refresh()
            cycle += 1

            run_target_cycle = get_target_cycle(get_time())

        }

    }

}

var manual_input_seen = false

run_sim: while true {

    reset_sim()

    
    def get_input(cycle: Int) Input {
    
        return Input {input: U8 cycle}
    
    }
    
    def check_output(cycle: Int, input: Input, output: Output) TestResult {
    
        let count = clz(input.input)
    
        if count != output.result {
    
            let input_value = input.input
            let binary_value = "0b" + bin(8, Int input.input)
    
            if output.result_is_z {
    
                set_error(`输出不应为空（高阻态）`)
    
            } elif count == 1 {
    
                set_error(`{input_value}（{binary_value}）应有 1 个前导零`)
    
            } else {
    
                set_error(`{input_value}（{binary_value}）应有 {count} 个前导零`)
    
            }
    
            return fail
    
        }
    
    
        if cycle == 0x100 {
    
            return win
    
        }
    
    }
    while true {

        mode_refresh()

        #if in_scope("on_ui_update"){

            on_ui_update(level_input, level_output)

        }

        while get_command(ctl_command_id) == last_command_id {

            #if in_scope("on_manual_input"){

                if last_level_manual_input != get_command(ctl_level_manual_input_id) {

                    last_level_manual_input = get_command(ctl_level_manual_input_id)
                    on_manual_input(Int get_command(ctl_level_manual_input))
                    manual_input_seen = true

                }

            }

            sleep(1.ms())

        }

        if manual_input_seen {

            manual_input_seen = false
            break

        }

        last_command_id = get_command(ctl_command_id) // Read this before the command in case of race condition
        set_setting(sim_last_command_id, last_command_id)
        var command = SimCommand get_command(ctl_command)

        switch command

            case run {

                var target_cycle = Int get_setting(sim_target_cycle)

                set_setting(sim_running, U64 1)
                mode_run(target_cycle)
                set_setting(sim_running, U64 0)

            }

            case refresh {}

            case mode_reset {

                var i = 0
                while i < 1024 {
                    input_replay[i] = ctl_input_replay_reset[i]
                    i += 1
                }

                break

            }

            case quit_simulation {

                break run_sim // We need to break out instead of thread_exit() to make sure everything is cleaned up

            }

    }

}

