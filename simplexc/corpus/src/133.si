def mode_run(target_cycle: Int) None {

    if get_setting(sim_test_result) == U64 win { return }
    if (get_setting(sim_test_result) == U64 fail && cycle + 1 >= #CYCLE_PAST_FAIL) { return }
    if get_setting(sim_short_circuit_component_id_1) != 0 { return }

    var halt_run = false

    var original_start_time = Time 0
    var orig_start_cycle = U64 cycle
    var last_time = original_start_time

    var burst_cycles = 1

    var nanos_per_cycle = U64 0

    var i = 0
    var last_target_speed = U64 0
    var speed = U64 1

    while get_command(ctl_command_id) == last_command_id && !halt_run && target_cycle > cycle {
        i += 1

        let target_speed = max(1, get_command(ctl_cycle_speed_ms))

        if target_speed != last_target_speed {

            original_start_time = get_time()
            orig_start_cycle = U64 cycle
            last_time = original_start_time

            speed = min(U64 get_command(ctl_cycle_speed_ms), 10000000000000) // Cap at 10 ghz to avoid overflow
            last_target_speed = target_speed

        }

        let cycles_at_start = cycle
        let burst_target = cycle + burst_cycles

        var burst_target_cycle = min(target_cycle, burst_target)

        def halt() None {

            burst_target_cycle = cycle
            halt_run = true

        }

        def handle_test_result(result: TestResult) None {

            if result != pass {

                var res = result

                halt() // Halt regardless of wether we are above '#CYCLE_PAST_FAIL'

                set_setting(sim_test_result, max(get_setting(sim_test_result), U64 res))

            }

        }

        while cycle < burst_target_cycle {

            if in_scope("get_input") {
                level_input = get_input(cycle + 1)
            }
            

            


            // 1 com_level_input_word 8 1640901824651595730 Input
            var vid274 = U8 level_input.input
            input_replay[0] = U64 level_input.input
            


            // 2 com_level_input_word 3 6310825833587449367 Shift
            var vid256 = U3 level_input.shift
            input_replay[1] = U64 level_input.shift
            


            // 13 com_decoder_3 2 6517952222922783048 
            var val13 = (((((U1 0x0)) & 1) == 1) ? 8 : U8 ((U3 vid256) & 0b111))
            var vid258 = U1 (U64 (val13 == 0))
            var vid260 = U1 (U64 (val13 == 1))
            var vid262 = U1 (U64 (val13 == 2))
            var vid264 = U1 (U64 (val13 == 3))
            var vid266 = U1 (U64 (val13 == 4))
            var vid268 = U1 (U64 (val13 == 5))
            var vid270 = U1 (U64 (val13 == 6))
            var vid272 = U1 (U64 (val13 == 7))
            


            // 20 com_splitter_bit_8 2 7578532431282220990 
            let input_20 = (U8 vid274)
            var vid276 = U1 input_20
            var vid278 = U1 (input_20 >> 1) & 1
            var vid280 = U1 (input_20 >> 2) & 1
            var vid282 = U1 (input_20 >> 3) & 1
            var vid284 = U1 (input_20 >> 4) & 1
            var vid286 = U1 (input_20 >> 5) & 1
            var vid288 = U1 (input_20 >> 6) & 1
            var vid290 = U1 (input_20 >> 7) & 1
            


            // 10 com_maker_bit_8 2 6811868643572088846 
            var vid292 = U8 (U8 (U1 vid290) | (((U8 0x0) & 1) << 1) | (((U8 0x0) & 1) << 2) | (((U8 0x0) & 1) << 3) | (((U8 0x0) & 1) << 4) | (((U8 0x0) & 1) << 5) | (((U8 0x0) & 1) << 6) | (((U8 0x0) & 1) << 7))
            


            // 14 com_switch_word 8 223824544289865302 
            var vid307 = U8 0
            var and_field_id307 = ~vid307
            if (U1 vid272) != 0 {
                vid307 |= U8  (U8 ((U8 vid292)))
                and_field_id307 &= U8  (U8 ((U8 vid292)))
            }
            


            // 9 com_maker_bit_8 2 339311811063042544 
            var vid294 = U8 (U8 (U1 vid288) | (((U8 ((U1 vid290))) & 1) << 1) | (((U8 0x0) & 1) << 2) | (((U8 0x0) & 1) << 3) | (((U8 0x0) & 1) << 4) | (((U8 0x0) & 1) << 5) | (((U8 0x0) & 1) << 6) | (((U8 0x0) & 1) << 7))
            


            // 15 com_switch_word 8 2485168136379541864 
            if (U1 vid270) != 0 {
                vid307 |= U8  (U8 ((U8 vid294)))
                and_field_id307 &= U8  (U8 ((U8 vid294)))
            }
            


            // 8 com_maker_bit_8 2 182966237101604326 
            var vid296 = U8 (U8 (U1 vid286) | (((U8 ((U1 vid288))) & 1) << 1) | (((U8 ((U1 vid290))) & 1) << 2) | (((U8 0x0) & 1) << 3) | (((U8 0x0) & 1) << 4) | (((U8 0x0) & 1) << 5) | (((U8 0x0) & 1) << 6) | (((U8 0x0) & 1) << 7))
            


            // 16 com_switch_word 8 6013256844466868221 
            if (U1 vid268) != 0 {
                vid307 |= U8  (U8 ((U8 vid296)))
                and_field_id307 &= U8  (U8 ((U8 vid296)))
            }
            


            // 7 com_maker_bit_8 2 6466719601825142187 
            var vid298 = U8 (U8 (U1 vid284) | (((U8 ((U1 vid286))) & 1) << 1) | (((U8 ((U1 vid288))) & 1) << 2) | (((U8 ((U1 vid290))) & 1) << 3) | (((U8 0x0) & 1) << 4) | (((U8 0x0) & 1) << 5) | (((U8 0x0) & 1) << 6) | (((U8 0x0) & 1) << 7))
            


            // 17 com_switch_word 8 2835704615653069047 
            if (U1 vid266) != 0 {
                vid307 |= U8  (U8 ((U8 vid298)))
                and_field_id307 &= U8  (U8 ((U8 vid298)))
            }
            


            // 6 com_maker_bit_8 2 8559195900449435738 
            var vid300 = U8 (U8 (U1 vid282) | (((U8 ((U1 vid284))) & 1) << 1) | (((U8 ((U1 vid286))) & 1) << 2) | (((U8 ((U1 vid288))) & 1) << 3) | (((U8 ((U1 vid290))) & 1) << 4) | (((U8 0x0) & 1) << 5) | (((U8 0x0) & 1) << 6) | (((U8 0x0) & 1) << 7))
            


            // 18 com_switch_word 8 5136553850846646622 
            if (U1 vid264) != 0 {
                vid307 |= U8  (U8 ((U8 vid300)))
                and_field_id307 &= U8  (U8 ((U8 vid300)))
            }
            


            // 5 com_maker_bit_8 2 9195741301065175841 
            var vid302 = U8 (U8 (U1 vid278) | (((U8 ((U1 vid280))) & 1) << 1) | (((U8 ((U1 vid282))) & 1) << 2) | (((U8 ((U1 vid284))) & 1) << 3) | (((U8 ((U1 vid286))) & 1) << 4) | (((U8 ((U1 vid288))) & 1) << 5) | (((U8 ((U1 vid290))) & 1) << 6) | (((U8 0x0) & 1) << 7))
            


            // 12 com_switch_word 8 1836537133715292397 
            if (U1 vid260) != 0 {
                vid307 |= U8  (U8 ((U8 vid302)))
                and_field_id307 &= U8  (U8 ((U8 vid302)))
            }
            


            // 4 com_maker_bit_8 2 1692143041932945446 
            var vid304 = U8 (U8 (U1 vid280) | (((U8 ((U1 vid282))) & 1) << 1) | (((U8 ((U1 vid284))) & 1) << 2) | (((U8 ((U1 vid286))) & 1) << 3) | (((U8 ((U1 vid288))) & 1) << 4) | (((U8 ((U1 vid290))) & 1) << 5) | (((U8 0x0) & 1) << 6) | (((U8 0x0) & 1) << 7))
            


            // 19 com_switch_word 8 8847985117455192877 
            if (U1 vid262) != 0 {
                vid307 |= U8  (U8 ((U8 vid304)))
                and_field_id307 &= U8  (U8 ((U8 vid304)))
            }
            


            // 11 com_switch_word 8 6818876175519891260 
            if (U1 vid258) != 0 {
                vid307 |= U8  (U8 ((U8 vid274)))
                and_field_id307 &= U8  (U8 ((U8 vid274)))
            }
            if vid307 > and_field_id307 {
                halt()
            }
            let zid307 = vid307 >= and_field_id307
            


            // 0 com_none 2 0 
            


            // 3 com_level_output_word 8 3846974392934834276 Result
            level_output.result = U8 ((U8 vid307))
            level_output.result_is_z = !zid307

    



            if in_scope("check_output") {
                let result = check_output(cycle + 1, level_input, level_output)
                handle_test_result(result)
            }

            
            cycle += 1 // Do this late as it signals to the front end that it can update

        }

        set_setting(sim_cycle, U64 cycle)

        let time_now = get_time()

        let time_diff = U64 (time_now - last_time)

        nanos_per_cycle = time_diff / U64 burst_cycles

        if time_now - last_time > 33.ms() {

            // Burst took too long
            burst_cycles = max(1, burst_cycles - 1)

        } else {

            // Burst was too fast
            burst_cycles = burst_cycles + 1

        }

        #if in_scope("on_ui_update"){

            on_ui_update(level_input, level_output)

        }

        last_time = time_now


        def get_target_cycle(time_now: Time) U64 {
            let time_diff = U64 (time_now - original_start_time)
            return orig_start_cycle + ((time_diff / 1000000) * speed) / 1000000 // Double divide to prevent overflow
        }

        var run_target_cycle = get_target_cycle(time_now)

        // Sleep any ahead of time away
        while cycle > Int run_target_cycle && get_command(ctl_command_id) == last_command_id {

            sleep(1.ms())
            cycle -= 1
            mode_refresh()
            cycle += 1

            run_target_cycle = get_target_cycle(get_time())

        }

    }

}

var manual_input_seen = false

run_sim: while true {

    reset_sim()

    def get_binary_repr(value: Int, size: Int) Str {
        var text = ""
        var i = size - 1
        while i >= 0 {
            if ((value >> i) & 1) == 0 {
                text += "[F]"
            } else {
                text += "[T]"
            }
            i -= 1
        }
        return text
    }
    
    def get_input(cycle: Int) Input {
    
        var x = cycle
        x ^= x << 6
        x ^= x >> 5
        x ^= x << 7
    
        let input = Input {
            input: U8 x,
            shift: U3 (x >> 8),
        }
    
        ui_set_text("table[0][1]", `{input.shift}`)
        ui_set_text("table[1][1]", get_binary_repr(Int input.input, 8))
    
        return input
    
    }
    
    def check_output(cycle: Int, input: Input, output: Output) TestResult {
        let expected = input.input >> U8 input.shift
        ui_set_text("table[2][1]", get_binary_repr(Int expected, 8))
    
        if output.result_is_z {
            ui_set_text("table[3][1]", "[right][Z][Z][Z][Z][Z][Z][Z][Z][/right]")
            set_error(`输出不应为空（高阻态）`)
            return fail
        }
    
        ui_set_text("table[3][1]", get_binary_repr(Int output.result, 8))
    
        if output.result != expected {
            return fail
        }
    
        if cycle == 2048 {
            return win
        }
    
    }
    while true {

        mode_refresh()

        #if in_scope("on_ui_update"){

            on_ui_update(level_input, level_output)

        }

        while get_command(ctl_command_id) == last_command_id {

            #if in_scope("on_manual_input"){

                if last_level_manual_input != get_command(ctl_level_manual_input_id) {

                    last_level_manual_input = get_command(ctl_level_manual_input_id)
                    on_manual_input(Int get_command(ctl_level_manual_input))
                    manual_input_seen = true

                }

            }

            sleep(1.ms())

        }

        if manual_input_seen {

            manual_input_seen = false
            break

        }

        last_command_id = get_command(ctl_command_id) // Read this before the command in case of race condition
        set_setting(sim_last_command_id, last_command_id)
        var command = SimCommand get_command(ctl_command)

        switch command

            case run {

                var target_cycle = Int get_setting(sim_target_cycle)

                set_setting(sim_running, U64 1)
                mode_run(target_cycle)
                set_setting(sim_running, U64 0)

            }

            case refresh {}

            case mode_reset {

                var i = 0
                while i < 1024 {
                    input_replay[i] = ctl_input_replay_reset[i]
                    i += 1
                }

                break

            }

            case quit_simulation {

                break run_sim // We need to break out instead of thread_exit() to make sure everything is cleaned up

            }

    }

}

