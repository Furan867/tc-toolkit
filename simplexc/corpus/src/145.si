def mode_run(target_cycle: Int) None {

    if get_setting(sim_test_result) == U64 win { return }
    if (get_setting(sim_test_result) == U64 fail && cycle + 1 >= #CYCLE_PAST_FAIL) { return }
    if get_setting(sim_short_circuit_component_id_1) != 0 { return }

    var halt_run = false

    var original_start_time = Time 0
    var orig_start_cycle = U64 cycle
    var last_time = original_start_time

    var burst_cycles = 1

    var nanos_per_cycle = U64 0

    var i = 0
    var last_target_speed = U64 0
    var speed = U64 1

    while get_command(ctl_command_id) == last_command_id && !halt_run && target_cycle > cycle {
        i += 1

        let target_speed = max(1, get_command(ctl_cycle_speed_ms))

        if target_speed != last_target_speed {

            original_start_time = get_time()
            orig_start_cycle = U64 cycle
            last_time = original_start_time

            speed = min(U64 get_command(ctl_cycle_speed_ms), 10000000000000) // Cap at 10 ghz to avoid overflow
            last_target_speed = target_speed

        }

        let cycles_at_start = cycle
        let burst_target = cycle + burst_cycles

        var burst_target_cycle = min(target_cycle, burst_target)

        def halt() None {

            burst_target_cycle = cycle
            halt_run = true

        }

        def handle_test_result(result: TestResult) None {

            if result != pass {

                var res = result

                halt() // Halt regardless of wether we are above '#CYCLE_PAST_FAIL'

                set_setting(sim_test_result, max(get_setting(sim_test_result), U64 res))

            }

        }

        while cycle < burst_target_cycle {

            if in_scope("get_input") {
                level_input = get_input(cycle + 1)
            }
            

            


            // 1 com_cc_level_input 4 5583813695281939133 Opcode
            var vid290 = U4 level_input.opcode
            input_replay[0] = U64 level_input.opcode
            


            // 2 com_cc_level_input 32 2224024033325130927 Argument A
            var vid268 = U32 level_input.argument_a
            input_replay[1] = U64 level_input.argument_a
            


            // 4 com_cc_level_input 32 662760815030292693 Argument B
            var vid258 = U32 level_input.argument_b
            input_replay[2] = U64 level_input.argument_b
            


            // 10 com_on 2 7003718046811046973 
            var vid256 = U1 1
            


            // 8 com_not_word 8 1373544546742584999 
            var vid266 = U8 ~(U8 ((U8 vid258)))
            


            // 13 com_not_word 8 8087854965620747601 
            var vid276 = U8 ~(U8 ((U8 vid268)))
            


            // 16 com_nand_word 8 7091867685174944826 
            var vid278 = U8 ~((U8 vid276) & (U8 vid266))
            


            // 14 com_not_word 8 584137885141294602 
            var vid280 = U8 ~(U8 vid278)
            


            // 12 com_add 8 5119579102425735552 
            let sum_12_1 = U9 (U8 ((U8 vid268)))
            let sum_12_2 = U9 (U8 ((U8 vid258)))
            let sum_12 = ((U9 (U8 0x0) & 1) + sum_12_1 + sum_12_2)
            var vid282 = U8 sum_12
            var vid319 = U1 (sum_12 >> 8)
            


            // 11 com_add 8 4335973764482702434 
            let sum_11_1 = U9 (U8 ((U8 vid268)))
            let sum_11_2 = U9 (U8 vid266)
            let sum_11 = ((U9 (U8 ((U1 vid256))) & 1) + sum_11_1 + sum_11_2)
            var vid284 = U8 sum_11
            var vid318 = U1 (sum_11 >> 8)
            


            // 7 com_nand_word 8 5589437539829338680 
            var vid286 = U8 ~((U8 ((U8 vid268))) & (U8 ((U8 vid258))))
            


            // 6 com_not_word 8 6014618857776987948 
            var vid288 = U8 ~(U8 vid286)
            


            // 15 com_decoder_3 2 8309746602378339636 
            var val15 = (((((U1 0x0)) & 1) == 1) ? 8 : U8 ((U3 ((U3 vid290))) & 0b111))
            var vid292 = U1 (U64 (val15 == 0))
            var vid294 = U1 (U64 (val15 == 1))
            var vid296 = U1 (U64 (val15 == 2))
            var vid298 = U1 (U64 (val15 == 3))
            var vid300 = U1 (U64 (val15 == 4))
            var vid302 = U1 (U64 (val15 == 5))
            var vid320 = U1 (U64 (val15 == 6))
            var vid321 = U1 (U64 (val15 == 7))
            


            // 5 com_switch_word 8 5397675743209806666 
            var vid305 = U8 0
            var and_field_id305 = ~vid305
            if (U1 vid302) != 0 {
                vid305 |= U8  (U8 ((U8 vid284)))
                and_field_id305 &= U8  (U8 ((U8 vid284)))
            }
            


            // 20 com_switch_word 8 4632766833914844274 
            if (U1 vid300) != 0 {
                vid305 |= U8  (U8 ((U8 vid282)))
                and_field_id305 &= U8  (U8 ((U8 vid282)))
            }
            


            // 19 com_switch_word 8 511048628647841773 
            if (U1 vid298) != 0 {
                vid305 |= U8  (U8 ((U8 vid280)))
                and_field_id305 &= U8  (U8 ((U8 vid280)))
            }
            


            // 18 com_switch_word 8 1644046943857272332 
            if (U1 vid296) != 0 {
                vid305 |= U8  (U8 ((U8 vid288)))
                and_field_id305 &= U8  (U8 ((U8 vid288)))
            }
            


            // 17 com_switch_word 8 3660115394929259386 
            if (U1 vid294) != 0 {
                vid305 |= U8  (U8 ((U8 vid278)))
                and_field_id305 &= U8  (U8 ((U8 vid278)))
            }
            


            // 9 com_switch_word 8 3752094460611230300 
            if (U1 vid292) != 0 {
                vid305 |= U8  (U8 ((U8 vid286)))
                and_field_id305 &= U8  (U8 ((U8 vid286)))
            }
            if vid305 > and_field_id305 {
                halt()
            }
            let zid305 = vid305 >= and_field_id305
            


            // 0 com_none 2 0 
            


            // 3 com_cc_level_output 32 7840263827940466690 Result
            level_output.result = U32 ((U32 ((U8 vid305))))
            level_output.result_is_z = !zid305

    



            if in_scope("check_output") {
                let result = check_output(cycle + 1, level_input, level_output)
                handle_test_result(result)
            }

            
            cycle += 1 // Do this late as it signals to the front end that it can update

        }

        set_setting(sim_cycle, U64 cycle)

        let time_now = get_time()

        let time_diff = U64 (time_now - last_time)

        nanos_per_cycle = time_diff / U64 burst_cycles

        if time_now - last_time > 33.ms() {

            // Burst took too long
            burst_cycles = max(1, burst_cycles - 1)

        } else {

            // Burst was too fast
            burst_cycles = burst_cycles + 1

        }

        #if in_scope("on_ui_update"){

            on_ui_update(level_input, level_output)

        }

        last_time = time_now


        def get_target_cycle(time_now: Time) U64 {
            let time_diff = U64 (time_now - original_start_time)
            return orig_start_cycle + ((time_diff / 1000000) * speed) / 1000000 // Double divide to prevent overflow
        }

        var run_target_cycle = get_target_cycle(time_now)

        // Sleep any ahead of time away
        while cycle > Int run_target_cycle && get_command(ctl_command_id) == last_command_id {

            sleep(1.ms())
            cycle -= 1
            mode_refresh()
            cycle += 1

            run_target_cycle = get_target_cycle(get_time())

        }

    }

}

var manual_input_seen = false

run_sim: while true {

    reset_sim()

    def flag_result(a: U32, b: U32) U32 {
        let equal = U32 (a == b)
        let uless = U32 (U32 a < U32 b) & 1
        let sless = U32 (S32 a < S32 b) & 1
    
        let result = (sless << 2) | (uless << 1) | equal
    
        return (sless << 2) | (uless << 1) | equal
    }
    
    def get_input(cycle: Int) Input {
    
        var code = random(11)
        var a = U32 0
        var b = U32 0
    
        if cycle < 0xfff {
    
            a = U32 random(0x100)
            b = U32 random(0x100)
    
        } else {
    
            switch random(5)
                case 0 {
                    a = U32 random(0x10000_0000)
                    b = U32 random(0x10000_0000)
                }
                case 1 {
                    a = U32 random(0x10000_0000)
                    b = a
                }
                case 2 {
                    a = U32 random(0x10000_0000)
                    b = a + 1
                }
                case 3 {
                    a = U32 random(0x10000_0000)
                    b = a - 1
                }
                case 4 {
                    a = U32 random(0x10000_0000)
                    let mask = U32 1 << U32 random(32)
                    b = a ^ mask
                }
    
        }
    
        if code == 7 || code == 8 || code == 9 {
    
            b = U32 random(32)
    
        }
    
        switch code
            case 0 {
    
                ui_set_text("description", `{a} NAND {b} = {U32 ~(a & b)}`)
    
            }
            case 1 {
    
                ui_set_text("description", `{a} OR {b} = {a | b}`)
    
            }
            case 2 {
    
                ui_set_text("description", `{a} AND {b} = {a & b}`)
    
            }
            case 3 {
    
                ui_set_text("description", `{a} NOR {b} = {U32 ~(a | b)}`)
    
            }
            case 4 {
    
                ui_set_text("description", `{a} ADD {b} = {U32 (a + b)}`)
    
            }
            case 5 {
    
                ui_set_text("description", `{a} SUB {b} = {a - b}`)
    
            }
            case 6 {
    
                ui_set_text("description", `{a} XOR {b} = {a ^ b}`)
    
            }
            case 7 {
    
                ui_set_text("description", `{a} LSL {b} = {U32 (a << b)}`)
    
            }
            case 8 {
    
                ui_set_text("description", `{a} LSR {b} = {a >> b}`)
    
            }
            case 9 {
    
                ui_set_text("description", `{a} ASR {b} = {asr(a, b)}`)
    
            }
            case 10 {
    
                ui_set_text("description", `CMP {a}, {b} = {flag_result(a, b)}`)
    
            }
    
        return Input {opcode: U4 code, argument_a: U32 a, argument_b: U32 b}
    
    }
    
    def check_output(cycle: Int, input: Input, output: Output) TestResult {
    
        if output.result_is_z {
            set_error(`输出不应为空（高阻态）`)
            return fail
        }
    
        var result = U32 0
    
        switch input.opcode
            case 0  { result = ~(input.argument_a &  input.argument_b) }
            case 1  { result =   input.argument_a |  input.argument_b }
            case 2  { result =   input.argument_a &  input.argument_b }
            case 3  { result = ~(input.argument_a |  input.argument_b) }
            case 4  { result =   input.argument_a +  input.argument_b }
            case 5  { result =   input.argument_a -  input.argument_b }
            case 6  { result =   input.argument_a ^  input.argument_b }
            case 7  { result =   input.argument_a << input.argument_b }
            case 8  { result =   input.argument_a >> input.argument_b }
            case 9  { result =   asr(input.argument_a, input.argument_b) }
            case 10 { result =   flag_result(input.argument_a, input.argument_b) }
    
        result &= 0xffff_ffff
    
        if output.result != result {
            return fail
    
        }
    
        if cycle == 1000_000 {
    
            return win
    
        }
    
    }
    while true {

        mode_refresh()

        #if in_scope("on_ui_update"){

            on_ui_update(level_input, level_output)

        }

        while get_command(ctl_command_id) == last_command_id {

            #if in_scope("on_manual_input"){

                if last_level_manual_input != get_command(ctl_level_manual_input_id) {

                    last_level_manual_input = get_command(ctl_level_manual_input_id)
                    on_manual_input(Int get_command(ctl_level_manual_input))
                    manual_input_seen = true

                }

            }

            sleep(1.ms())

        }

        if manual_input_seen {

            manual_input_seen = false
            break

        }

        last_command_id = get_command(ctl_command_id) // Read this before the command in case of race condition
        set_setting(sim_last_command_id, last_command_id)
        var command = SimCommand get_command(ctl_command)

        switch command

            case run {

                var target_cycle = Int get_setting(sim_target_cycle)

                set_setting(sim_running, U64 1)
                mode_run(target_cycle)
                set_setting(sim_running, U64 0)

            }

            case refresh {}

            case mode_reset {

                var i = 0
                while i < 1024 {
                    input_replay[i] = ctl_input_replay_reset[i]
                    i += 1
                }

                break

            }

            case quit_simulation {

                break run_sim // We need to break out instead of thread_exit() to make sure everything is cleaned up

            }

    }

}

