def ui_set_position(id: Str, x: Int, y: Int) None {
    switch id
        case "instruction" { store(ui_buffer + 8, U64 (x << 16 | (y & 0xffff))) }
}

def ui_set_width(id: Str, value: Int) None {
    switch id
        case "instruction" { store(ui_buffer + 16, U64 value) }
}

def ui_set_hidden(id: Str, value: Bool) None {
    switch id
        case "instruction" { store(ui_buffer + 0, U64 value) }
}

def ui_set_size(id: Str, value: Int) None {
    switch id
        case "instruction" { store(ui_buffer + 32, U64 value) }
}

