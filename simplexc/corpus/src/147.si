def mode_run(target_cycle: Int) None {

    if get_setting(sim_test_result) == U64 win { return }
    if (get_setting(sim_test_result) == U64 fail && cycle + 1 >= #CYCLE_PAST_FAIL) { return }
    if get_setting(sim_short_circuit_component_id_1) != 0 { return }

    var halt_run = false

    var original_start_time = Time 0
    var orig_start_cycle = U64 cycle
    var last_time = original_start_time

    var burst_cycles = 1

    var nanos_per_cycle = U64 0

    var i = 0
    var last_target_speed = U64 0
    var speed = U64 1

    while get_command(ctl_command_id) == last_command_id && !halt_run && target_cycle > cycle {
        i += 1

        let target_speed = max(1, get_command(ctl_cycle_speed_ms))

        if target_speed != last_target_speed {

            original_start_time = get_time()
            orig_start_cycle = U64 cycle
            last_time = original_start_time

            speed = min(U64 get_command(ctl_cycle_speed_ms), 10000000000000) // Cap at 10 ghz to avoid overflow
            last_target_speed = target_speed

        }

        let cycles_at_start = cycle
        let burst_target = cycle + burst_cycles

        var burst_target_cycle = min(target_cycle, burst_target)

        def halt() None {

            burst_target_cycle = cycle
            halt_run = true

        }

        def handle_test_result(result: TestResult) None {

            if result != pass {

                var res = result

                halt() // Halt regardless of wether we are above '#CYCLE_PAST_FAIL'

                set_setting(sim_test_result, max(get_setting(sim_test_result), U64 res))

            }

        }

        while cycle < burst_target_cycle {

            if in_scope("get_input") {
                level_input = get_input(cycle + 1)
            }
            

            


            // 22 com_delay_line_word 32 2103751745922615144 
            let value_22 = load(<U32>, #SIMULATION_STATE + 410)
            store(#SIMULATION_STATE + 414, value_22) // Output cache
            var vid256 = U32 value_22
            


            // 20 com_constant 32 7768171595900255589 
            var vid264 = U32 ( 4 & 0b11111111111111111111111111111111)
            


            // 23 com_add 32 6487355707187800926 
            let sum_23_1 = U33 (U32 vid256)
            let sum_23_2 = U33 (U32 vid264)
            let sum_23 = ((U33 (U32 0x0) & 1) + sum_23_1 + sum_23_2)
            var vid272 = U32 sum_23
            var vid418 = U1 (sum_23 >> 32)
            


            // 19 com_probe_memory_word 32 4949768409093326632 Count
            


            // 18 com_cc_input_buffer 32 0 
            var vid280 = U32 (U32 0x0)
            


            // 17 com_cc_input_buffer 1 0 
            var vid288 = U1 (U1 0x0)
            


            // 21 com_mux 32 4084068917427187503 
            var vid290 = U32 (U1 vid288) & 1 == 0 ? (U32 vid272) : (U32 vid280)
            


            // 24 com_delay_line_word 32 LATE -2103751745922615144 
            store(#SIMULATION_STATE + 410, U32 ((U32 vid290)))
            


            // 14 com_constant 32 7362498006464115961 
            var vid298 = U32 ( 2 & 0b11111111111111111111111111111111)
            


            // 13 com_lsl 32 7303750122961784452 
            var vid306 = U32 ((U32 0x0) << (U32 vid298))
            


            // 15 com_equal 32 1604275179792263348 
            var vid314 = U1 ((U32 vid306) == (U32 0x0))
            


            // 16 com_not_bit 2 6663372516916025055 
            var vid316 = U1 (U1 ~(U1 vid314))
            


            // 12 com_lsl 32 6392043151127459274 
            var vid318 = U32 ((U32 0x0) << (U32 vid298))
            


            // 11 com_lsl 32 8364069070194541336 
            var vid326 = U32 ((U32 0x0) << (U32 vid298))
            


            // 9 com_on 2 4963311456853272728 
            var vid334 = U1 1
            


            // 5 com_load_port 32 3259284663407978865 
            load_port_5 = Int (U32 vid326) & 255
            let value_5 = load(<U32>, #DATA_2711086732312417723 + 252 - load_port_5)
            var vid337 = U32 0
            var and_field_id337 = ~vid337
            if (U1 vid334) != 0 {
                vid337 |= U32  (U32 (value_5))
                and_field_id337 &= U32  (U32 (value_5))
            }
            store(#SIMULATION_STATE + 404, value_5) // Output cache
            if vid337 > and_field_id337 {
                halt()
            }
            let zid337 = vid337 >= and_field_id337
            


            // 4 com_load_port 32 3712640338414515413 
            load_port_4 = Int (U32 vid318) & 255
            let value_4 = load(<U32>, #DATA_2711086732312417723 + 252 - load_port_4)
            var vid347 = U32 0
            var and_field_id347 = ~vid347
            if (U1 vid334) != 0 {
                vid347 |= U32  (U32 (value_4))
                and_field_id347 &= U32  (U32 (value_4))
            }
            store(#SIMULATION_STATE + 396, value_4) // Output cache
            if vid347 > and_field_id347 {
                halt()
            }
            let zid347 = vid347 >= and_field_id347
            


            // 10 com_nand_word 32 7143222836793659352 
            var vid362 = U32 ~((U32 vid337) & (U32 vid347))
            


            // 6 com_store_port 32 5214019468095016930 
            if Bool (U1 vid316) {
                store(#DATA_2711086732312417723 + Int (252 - ((U32 vid306) & 255)), (U32 vid362))

                store(#DATA_2711086732312417723 - 4, U32 0)

            }
            


            // 8 com_custom 32 7534867754565876996 
            


            // 7 com_on 2 2151629776076060758 
            var vid370 = U1 1
            


            // 3 com_load_port 32 6951584130599049155 Instruction
            load_port_3 = Int (U32 vid256) & 16777215
            let value_3 = load(<U32>, #DATA_8272137354285170169 + 16777212 - load_port_3)
            var vid373 = U32 0
            var and_field_id373 = ~vid373
            if (U1 vid370) != 0 {
                vid373 |= U32  (U32 (value_3))
                and_field_id373 &= U32  (U32 (value_3))
            }
            store(#SIMULATION_STATE + 386, value_3) // Output cache
            if vid373 > and_field_id373 {
                halt()
            }
            let zid373 = vid373 >= and_field_id373
            


            // 2 com_ram 8 2711086732312417723 Register File
            


            // 1 com_ram 8 8272137354285170169 Main Memory
            


            // 0 com_none 2 0 
            var logic_idx_1 = Int (U32 vid256) & 0xffff
            var count_1 = load(<U16>, #SETTINGS_8272137354285170169)
            var start_1 = #SETTINGS_8272137354285170169 + 2
            var finish_1 = start_1 + Int (count_1 * 2)
            while Int start_1 < Int finish_1 {
                if Int load(<U16>, start_1) == logic_idx_1 {
                    halt()
                    break
                }
                start_1 += 2
            }

    



            if in_scope("check_output") {
                let result = check_output(cycle + 1, level_input, level_output)
                handle_test_result(result)
            }

            
            cycle += 1 // Do this late as it signals to the front end that it can update

        }

        set_setting(sim_cycle, U64 cycle)

        let time_now = get_time()

        let time_diff = U64 (time_now - last_time)

        nanos_per_cycle = time_diff / U64 burst_cycles

        if time_now - last_time > 33.ms() {

            // Burst took too long
            burst_cycles = max(1, burst_cycles - 1)

        } else {

            // Burst was too fast
            burst_cycles = burst_cycles + 1

        }

        #if in_scope("on_ui_update"){

            on_ui_update(level_input, level_output)

        }

        last_time = time_now


        def get_target_cycle(time_now: Time) U64 {
            let time_diff = U64 (time_now - original_start_time)
            return orig_start_cycle + ((time_diff / 1000000) * speed) / 1000000 // Double divide to prevent overflow
        }

        var run_target_cycle = get_target_cycle(time_now)

        // Sleep any ahead of time away
        while cycle > Int run_target_cycle && get_command(ctl_command_id) == last_command_id {

            sleep(1.ms())
            cycle -= 1
            mode_refresh()
            cycle += 1

            run_target_cycle = get_target_cycle(get_time())

        }

    }

}

var manual_input_seen = false

run_sim: while true {

    reset_sim()

    
    const #OP_IO  = 0
    const #OP_ALU = 1
    const #OP_JMP = 2
    const #OP_RAM = 3
    
    const #MAX_RAM = U32 11000
    const #MAX_SSD = U32 1000
    
    var counter   = U32 0
    var registers = array(<U32>, 16)
    var ram       = array(<U8>, #MAX_RAM)
    var ssd       = array(<U8>, #MAX_SSD)
    var saved_time = 0
    var screen_setting = 0
    
    add_keyboard_value(true, U8 0xff)
    
    def flag_result(a: U32, b: U32) U32 {
    
        let equal = U32 (a == b)
        let uless = U32 (U32 a < U32 b) & 1
        let sless = U32 (S32 a < S32 b) & 1
    
        return (sless << 2) | (uless << 1) | equal
    
    }
    
    def retire_instruction(instruction: Int, input: Int, output_enabled: Bool, output_value: Int) Bool {
    
        let mode            = (instruction >> 29) & 0b11
        let opcode          = (instruction >> 24) & 0b1111
        let dest            = (instruction >> 20) & 0b1111
        let a               = (instruction >> 16) & 0b1111
        let b               = (instruction >> 8) & 0b1111
        let immediate       = (instruction >> 28) & 1 != 0
        let immediate_value =  U32 (instruction & 0xffff)
    
        let a_value = registers[a]
        let b_value = immediate ? immediate_value : registers[b]
    
        switch mode
    
            case #OP_IO {
    
                const #NOP      = 0
                const #INPUT    = 1
                const #OUTPUT   = 2
                const #KEYBOARD = 3
                const #SCREEN   = 4
                const #TIME_0   = 5
                const #TIME_1   = 6
                const #COUNTER  = 7
    
                switch opcode & 0xf
                    case #INPUT    { registers[dest] = U32 input }
                    case #OUTPUT   {
                        let expected_output = Int b_value
    
                        if !output_enabled {
    
                            set_error(`输出端应处于激活状态。`)
                            return true
                        }
    
                        if output_value != expected_output {
    
                            set_error(`输出应为 {expected_output}，而非 {output_value}。`)
                            return true
    
                        }
    
                    }
                    case #KEYBOARD { registers[dest] = 0x01ff }
                    case #SCREEN   { screen_setting = Int b_value }
                    case #TIME_0   {
                        saved_time = get_last_time()
                        registers[dest] = U32 saved_time
                    }
                    case #TIME_1   {
                        registers[dest] = U32 (saved_time >> 32)
    
                        if registers[dest] != U32 get_ram_value("Register File", dest * 4, <U32>) {
                            set_error(`你不应该在两条 time_0 指令之间请求访问系统时间。`)
                            return true
                        }
                    }
                    case #COUNTER  { registers[dest] = counter }
    
                counter += 4
    
            }
    
            case #OP_ALU {
    
                counter += 4
    
                var result = U32 0
    
                switch opcode
                    case 0  { result = ~(a_value &  b_value) }
                    case 1  { result =   a_value |  b_value }
                    case 2  { result =   a_value &  b_value }
                    case 3  { result = ~(a_value |  b_value) }
                    case 4  { result =   a_value +  b_value }
                    case 5  { result =   a_value -  b_value }
                    case 6  { result =   a_value ^  b_value }
                    case 7  { result =   a_value << b_value }
                    case 8  { result =   a_value >> b_value }
                    case 9  { result =  U32 asr(S32 a_value, S32 b_value) }
                    case 10 { result =  flag_result(a_value, b_value) }
    
                registers[dest] = result & 0xffff_ffff
    
            }
    
            case #OP_JMP {
    
                let flags   = Int a_value & 0b111
                let matched = (opcode & flags) > 0
                let met     = matched != ((opcode & 0b1000) > 0)
    
                if met {
    
                    counter = b_value
    
                } else {
    
                    counter += 4
    
                }
    
            }
    
            case #OP_RAM {
                counter += 4
    
                const #LOAD_8    = 0b0000
                const #LOAD_16   = 0b0001
                const #LOAD_32   = 0b0010
                const #PLOAD     = 0b0011
                const #STORE_8   = 0b0100
                const #STORE_16  = 0b0101
                const #STORE_32  = 0b0110
                const #PSTORE    = 0b0111
    
                switch opcode
    
                    case #LOAD_8{
    
                        if b_value < #MAX_RAM - 1 {
    
                            registers[dest] = U32 ram[b_value]
    
                        }
    
                    }
    
                    case #LOAD_16 {
    
                        if b_value < #MAX_RAM - 2 {
    
                            registers[dest] = (U32 ram[b_value] << 8) | (U32 ram[b_value + 1])
    
                        }
    
                    }
    
                    case #LOAD_32 {
    
                        if b_value < #MAX_RAM - 4 {
    
                            registers[dest] = (U32 ram[b_value] << 24) | (U32 ram[b_value + 1] << 16) | (U32 ram[b_value + 2] << 8) | (U32 ram[b_value + 3])
    
                        }
    
                    }
    
                    case #STORE_8 {
    
                        if b_value < #MAX_RAM - 1 {
    
                            ram[b_value + 0] = U8 a_value
    
                        }
    
                    }
    
                    case #STORE_16 {
    
                        if b_value < #MAX_RAM - 2 {
    
                            ram[b_value + 1] = U8 a_value
                            ram[b_value + 0] = U8 (a_value >> 8)
    
                        }
    
                    }
    
                    case #STORE_32 {
    
                        if b_value < #MAX_RAM - 4 {
    
                            ram[b_value + 3] = U8 a_value
                            ram[b_value + 2] = U8 (a_value >> 8)
                            ram[b_value + 1] = U8 (a_value >> 16)
                            ram[b_value + 0] = U8 (a_value >> 24)
    
                        }
    
                    }
    
                    case #PLOAD {
    
                        if b_value < #MAX_SSD - 4 {
    
                            registers[dest] = (U32 ssd[b_value] << 24) | (U32 ssd[b_value + 1] << 16) | (U32 ssd[b_value + 2] << 8) | (U32 ssd[b_value + 3])
    
                        }
    
                    }
    
                    case #PSTORE {
    
                        if b_value < #MAX_SSD - 4 {
    
                            ssd[b_value + 3] = U8 a_value
                            ssd[b_value + 2] = U8 (a_value >> 8)
                            ssd[b_value + 1] = U8 (a_value >> 16)
                            ssd[b_value + 0] = U8 (a_value >> 24)
    
                        }
    
                    }
    
    
            }
    
        registers[0] = 0
    
    }
    
    def get_input(cycle: Int) Input { }
    
    def check_output(cycle: Int, input: Input, output: Output) TestResult {
    
        let actual_counter = get_load_port_input("Instruction")
    
        if U32 actual_counter != counter {
    
            ui_set_instruction(0, 0, 0)
            let expected_value = counter
            set_error(`你应该从主存地址 {expected_value} 处读取下一条指令，但当前的取指地址为 {actual_counter}。请检查你在上一周期是否正确更新了程序计数器的值。`)
            return fail
    
        }
    
        var instruction = get_ram_value("Main Memory", Int counter, <U32>)
        ui_set_instruction(0, Int instruction, Int counter)
    
        let error = retire_instruction(Int instruction, 0, false, 0)
    
        if error {
    
            return fail
    
        }
    
        {
    
            var reg = 0
            while reg < 16 {
    
                let value = U32 get_ram_value("Register File", reg * 4, <U32>)
    
                if value != registers[reg] {
    
                    if reg == 0 {
    
                        set_error(`寄存器'zr'（元件'Register File'的零地址处）的值应该始终为 0。`)
    
                    } else {
    
                        var register = ""
                        switch reg
                            case 14 { register = "'sp'" }
                            case 15 { register = "'flags'" }
                            default { register = `r{reg}`}
    
                        let address = reg * 4
                        let expected_value = "0x" + hex(8, Int registers[reg])
                        let actual_value = "0x" + hex(8, Int value)
                        set_error(`寄存器 {register}（元件'Register File'的地址 {address} 处）的值应为 {expected_value}，而非 {actual_value}。`)
    
                    }
                    return fail
    
                }
    
                reg += 1
    
            }
        }
    
    
        {
            // Tests only use addresses between 10k and 11k to speed up simulation
    
            var i = 10000
    
            while i < 11000 {
                let value = get_ram_value("Main Memory", i, <U8>)
                if ram[i] != value {
                    let expected_value = ram[i]
                    set_error(`主存地址 {i} 处的值应为 {expected_value}，而非 {value}。`)
                    return fail
                }
                i += 1
            }
        }
    
        {
            // Tests only the first 1k
    
            var i = 0
    
            while i < 1000 {
                let value = get_ram_value("Persistent Memory", i, <U8>)
                if ssd[i] != value {
                    let expected_value = ssd[i]
                    set_error(`外存地址 {i} 处的值应为 {expected_value}，而非 {value}。`)
                    return fail
                }
                i += 1
            }
        }
    
        {
    
            let value = get_screen_settings("screen", 3)
            if value != screen_setting {
                let expected_value = screen_setting
                set_error(`屏幕组件的 3 号设定的值应为 {expected_value}，而非 {value}。`)
                return fail
            }
    
        }
    
        if cycle > 1000 {
            return win
        }
    
    }
    
    while true {

        mode_refresh()

        #if in_scope("on_ui_update"){

            on_ui_update(level_input, level_output)

        }

        while get_command(ctl_command_id) == last_command_id {

            #if in_scope("on_manual_input"){

                if last_level_manual_input != get_command(ctl_level_manual_input_id) {

                    last_level_manual_input = get_command(ctl_level_manual_input_id)
                    on_manual_input(Int get_command(ctl_level_manual_input))
                    manual_input_seen = true

                }

            }

            sleep(1.ms())

        }

        if manual_input_seen {

            manual_input_seen = false
            break

        }

        last_command_id = get_command(ctl_command_id) // Read this before the command in case of race condition
        set_setting(sim_last_command_id, last_command_id)
        var command = SimCommand get_command(ctl_command)

        switch command

            case run {

                var target_cycle = Int get_setting(sim_target_cycle)

                set_setting(sim_running, U64 1)
                mode_run(target_cycle)
                set_setting(sim_running, U64 0)

            }

            case refresh {}

            case mode_reset {

                var i = 0
                while i < 1024 {
                    input_replay[i] = ctl_input_replay_reset[i]
                    i += 1
                }

                break

            }

            case quit_simulation {

                break run_sim // We need to break out instead of thread_exit() to make sure everything is cleaned up

            }

    }

}

