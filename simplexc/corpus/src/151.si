            }
            if vid303 > and_field_id303 {
                halt()
            }
            let zid303 = vid303 >= and_field_id303
            


            // 22 com_add 8 6894973863962410401 
            let sum_22_1 = U9 (U8 vid303)
            let sum_22_2 = U9 (U8 vid297)
            let sum_22 = ((U9 (U8 0x0) & 1) + sum_22_1 + sum_22_2)
            var vid306 = U8 sum_22
            var vid338 = U1 (sum_22 >> 8)
            


            // 24 com_add 8 8422677979211789291 
            let sum_24_1 = U9 (U8 vid306)
            let sum_24_2 = U9 (U8 vid292)
            let sum_24 = ((U9 (U8 0x0) & 1) + sum_24_1 + sum_24_2)
            var vid308 = U8 sum_24
            var vid340 = U1 (sum_24 >> 8)
            


            // 6 com_static_indexer 8 6353395478684825685 
            var vid310 = U8 (U8 ((U8 vid274)) << 3)
            


            // 15 com_switch_word 8 3578829407677472233 
            var vid313 = U8 0
            var and_field_id313 = ~vid313
            if (U1 vid264) != 0 {
                vid313 |= U8  (U8 ((U8 vid310)))
                and_field_id313 &= U8  (U8 ((U8 vid310)))
            }
            if vid313 > and_field_id313 {
                halt()
            }
            let zid313 = vid313 >= and_field_id313
            


            // 5 com_static_indexer 8 717011832123703464 
            var vid316 = U8 (U8 ((U8 vid274)) << 2)
            


            // 14 com_switch_word 8 6007989872380931840 
            var vid319 = U8 0
            var and_field_id319 = ~vid319
            if (U1 vid262) != 0 {
                vid319 |= U8  (U8 ((U8 vid316)))
                and_field_id319 &= U8  (U8 ((U8 vid316)))
            }
            if vid319 > and_field_id319 {
                halt()
            }
            let zid319 = vid319 >= and_field_id319
            


            // 21 com_add 8 5249752564748501617 
            let sum_21_1 = U9 (U8 vid319)
            let sum_21_2 = U9 (U8 vid313)
            let sum_21 = ((U9 (U8 0x0) & 1) + sum_21_1 + sum_21_2)
            var vid322 = U8 sum_21
            var vid337 = U1 (sum_21 >> 8)
            


            // 4 com_static_indexer 8 5198259410613117927 
            var vid324 = U8 (U8 ((U8 vid274)) << 1)
            


            // 13 com_switch_word 8 2172166554768415650 
            var vid327 = U8 0
            var and_field_id327 = ~vid327
            if (U1 vid260) != 0 {
                vid327 |= U8  (U8 ((U8 vid324)))
                and_field_id327 &= U8  (U8 ((U8 vid324)))
            }
            if vid327 > and_field_id327 {
                halt()
            }
            let zid327 = vid327 >= and_field_id327
            


            // 20 com_add 8 723331318072896198 
            let sum_20_1 = U9 (U8 vid277)
            let sum_20_2 = U9 (U8 vid327)
            let sum_20 = ((U9 (U8 0x0) & 1) + sum_20_1 + sum_20_2)
            var vid330 = U8 sum_20
            var vid336 = U1 (sum_20 >> 8)
            


            // 25 com_add 8 5261485434826109955 
            let sum_25_1 = U9 (U8 vid330)
            let sum_25_2 = U9 (U8 vid322)
            let sum_25 = ((U9 (U8 0x0) & 1) + sum_25_1 + sum_25_2)
            var vid332 = U8 sum_25
            var vid341 = U1 (sum_25 >> 8)
            


            // 26 com_add 8 2113478339150508987 
            let sum_26_1 = U9 (U8 vid332)
            let sum_26_2 = U9 (U8 vid308)
            let sum_26 = ((U9 (U8 0x0) & 1) + sum_26_1 + sum_26_2)
            var vid334 = U8 sum_26
            var vid342 = U1 (sum_26 >> 8)
            


            // 0 com_none 2 0 
            


            // 3 com_level_output_word 8 1568662432200534928 Result
            level_output.result = U8 ((U8 vid334))
            level_output.result_is_z = false

    



            if in_scope("check_output") {
                let result = check_output(cycle + 1, level_input, level_output)
                handle_test_result(result)
            }

            
            cycle += 1 // Do this late as it signals to the front end that it can update

        }

        set_setting(sim_cycle, U64 cycle)

        let time_now = get_time()

        let time_diff = U64 (time_now - last_time)

        nanos_per_cycle = time_diff / U64 burst_cycles

        if time_now - last_time > 33.ms() {

            // Burst took too long
            burst_cycles = max(1, burst_cycles - 1)

        } else {

            // Burst was too fast
            burst_cycles = burst_cycles + 1

        }

        #if in_scope("on_ui_update"){

            on_ui_update(level_input, level_output)

        }

        last_time = time_now


        def get_target_cycle(time_now: Time) U64 {
            let time_diff = U64 (time_now - original_start_time)
            return orig_start_cycle + ((time_diff / 1000000) * speed) / 1000000 // Double divide to prevent overflow
        }

        var run_target_cycle = get_target_cycle(time_now)

        // Sleep any ahead of time away
        while cycle > Int run_target_cycle && get_command(ctl_command_id) == last_command_id {

            sleep(1.ms())
            cycle -= 1
            mode_refresh()
            cycle += 1

            run_target_cycle = get_target_cycle(get_time())

        }

    }

}

var manual_input_seen = false

run_sim: while true {

    reset_sim()

    
    
    ui_set_text("description", `将两路输入相乘`)
    
    def get_input(cycle: Int) Input {
    
        var a = random(256)
        var b = random(256)
    
        return Input {a: U8 a, b: U8 b}
    
    }
    
    def check_output(cycle: Int, input: Input, output: Output) TestResult {
    
        let a = input.a
        let b = input.b
        let result = (input.a * input.b) & 0xff
    
        ui_set_text("description", `{a} * {b} = {result}`)
    
        if output.result_is_z {
            set_error(`输出不应为空（高阻态）`)
            return fail
        }
    
        if output.result != (input.a * input.b) & 0xff {
    
            let a = input.a
            let b = input.b
            let result = (input.a * input.b) & 0xff
            set_error(`{a} * {b} 的最低八位为 {result}`)
            return fail
    
        }
    
        if cycle == 0xffff {
            return win
        }
    
    }
    
    
    
    
    
    while true {

        mode_refresh()

        #if in_scope("on_ui_update"){

            on_ui_update(level_input, level_output)

        }

        while get_command(ctl_command_id) == last_command_id {

            #if in_scope("on_manual_input"){

                if last_level_manual_input != get_command(ctl_level_manual_input_id) {

                    last_level_manual_input = get_command(ctl_level_manual_input_id)
                    on_manual_input(Int get_command(ctl_level_manual_input))
                    manual_input_seen = true

                }

            }

            sleep(1.ms())

        }

        if manual_input_seen {

            manual_input_seen = false
            break

        }

        last_command_id = get_command(ctl_command_id) // Read this before the command in case of race condition
        set_setting(sim_last_command_id, last_command_id)
        var command = SimCommand get_command(ctl_command)

        switch command

            case run {

                var target_cycle = Int get_setting(sim_target_cycle)

                set_setting(sim_running, U64 1)
                mode_run(target_cycle)
                set_setting(sim_running, U64 0)

            }

            case refresh {}

            case mode_reset {

                var i = 0
                while i < 1024 {
                    input_replay[i] = ctl_input_replay_reset[i]
                    i += 1
                }

                break

            }

            case quit_simulation {

                break run_sim // We need to break out instead of thread_exit() to make sure everything is cleaned up

            }

    }

}

