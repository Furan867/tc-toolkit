            }
            if vid289 > and_field_id289 {
                halt()
            }
            let zid289 = vid289 >= and_field_id289
            


            // 23 com_add 8 252496058134454415 
            let sum_23_1 = U9 (U8 vid289)
            let sum_23_2 = U9 (U8 vid283)
