            var vid332 = U8 sum_31
            var vid334 = U1 (sum_31 >> 8)
            


            // 35 com_mux 8 3317379055058927743 
            var vid336 = U8 (U1 vid334) & 1 == 0 ? (U8 ((U8 vid328))) : (U8 vid332)
            


