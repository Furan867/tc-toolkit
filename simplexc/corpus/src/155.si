            // 20 com_add 8 1085925847940001914 
            let sum_20_1 = U9 (U8 ((U8 vid340)))
            let sum_20_2 = U9 (U8 vid274)
            let sum_20 = ((U9 (U8 ((U1 vid258))) & 1) + sum_20_1 + sum_20_2)
            var vid344 = U8 sum_20
            var vid346 = U1 (sum_20 >> 8)
            


            // 12 com_mux 8 5308814807834798345 
            var vid348 = U8 (U1 vid346) & 1 == 0 ? (U8 ((U8 vid340))) : (U8 vid344)
            


            // 30 com_concatenator_2 9 8923975156484697184 
            var vid350 = U9 (U9 (U1 vid290) | ((U9 (U8 vid348)) << 1))
            


            // 25 com_add 8 3211531516008909763 
            let sum_25_1 = U9 (U8 ((U8 vid350)))
            let sum_25_2 = U9 (U8 vid274)
            let sum_25 = ((U9 (U8 ((U1 vid270))) & 1) + sum_25_1 + sum_25_2)
            var vid354 = U8 sum_25
            var vid356 = U1 (sum_25 >> 8)
            


