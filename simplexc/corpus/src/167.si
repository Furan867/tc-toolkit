def ui_set_position(id: Str, x: Int, y: Int) None {
    switch id
        case "instruction" { store(ui_buffer + 8, U64 (x << 16 | (y & 0xffff))) }
}

def ui_set_width(id: Str, value: Int) None {
    switch id
        case "instruction" { store(ui_buffer + 16, U64 value) }
}

def ui_set_hidden(id: Str, value: Bool) None {
    switch id
        case "instruction" { store(ui_buffer + 0, U64 value) }
}

def ui_set_size(id: Str, value: Int) None {
    switch id
        case "instruction" { store(ui_buffer + 32, U64 value) }
}

def ui_set_column_header_size(id: Str, value: Int) None {
    switch id
}

def ui_set_row_header_size(id: Str, value: Int) None {
    switch id
}

def ui_set_color(id: Str, value: Int) None {
    switch id
}

def ui_set_address_color(id: Str, value: Int) None {
    switch id
}

def ui_set_instruction_color(id: Str, value: Int) None {
    switch id
        case "instruction" { store(ui_buffer + 40, U64 value) }
}

def ui_set_description_color(id: Str, value: Int) None {
    switch id
        case "instruction" { store(ui_buffer + 48, U64 value) }
}

def ui_set_column_header_color(id: Str, value: Int) None {
    switch id
}

def ui_set_row_header_color(id: Str, value: Int) None {
    switch id
        case "instruction" { store(ui_buffer + 56, U64 value) }
}

def ui_set_text(id: Str, text: Str) None {
    switch id
}

def ui_set_image_name(id: Str, text: Str) None {
    switch id
}

def ui_set_instruction(index: Int, code: Int, pointer: Int) None {
    switch index
        case 0 {
            store(ui_buffer + 64, code)
            store(ui_buffer + 72, pointer)
        }
}
def add_keyboard_value(key_down: Bool, key: U8) None {
    let value = U16 key_down | (U16 key) << 8
    var index = load(<U16>, #SIMULATION_KEYBOARD_CHARACTER + 4098)
    store(#SIMULATION_KEYBOARD_CHARACTER + index, value)
    store(#SIMULATION_KEYBOARD_CHARACTER + 4098, (index + 8) % 4096)

}
def get_last_time() Int { return Int time_component_last }
def get_screen_connection(screen_name: Str) Str {
}
def get_memory(label: Str) Int { 
}
var load_port_3 = 0
var load_port_4 = 0
var load_port_5 = 0
def get_load_port_input(label: Str) Int { 
    if label == "Instruction" { return load_port_3 }
}
def get_screen_settings(label: Str, index: Int) Int { 
}
def get_output(user_label: Str, index: Int) Int { 
    if user_label == "Instruction" && index == 0 { return Int (U64 load(<U32>, #SIMULATION_STATE + 641)) }
    if user_label == "Instruction" && index == 1 { return Int (U64 load(<U8>, #SIMULATION_STATE + 641)) }
}
def get_ram_value(label: Str, address: Int, size: @Size) @Size {
    if label == 'Main Memory' { return load(type_of(size), #DATA_8272137354285170169 + (16777216 - ((size(size) + 7) / 8)) - address)) } 
    if label == 'Register File' { return load(type_of(size), #DATA_2711086732312417723 + (256 - ((size(size) + 7) / 8)) - address)) } 
}
def set_ram_value(label: Str, offset: Int, value: @Type) None {
    if label == 'Main Memory' { store(#DATA_8272137354285170169 + 16777216 - offset - (size(value) + 7) / 8, value) }
    if label == 'Register File' { store(#DATA_2711086732312417723 + 256 - offset - (size(value) + 7) / 8, value) }
}

const #CYCLE_PAST_FAIL = 0
def max(a: TestResult, b: TestResult) TestResult {
    return TestResult max(U64 a, U64 b)
}

def set_error(input: Str) None {

    let len = input.len()

    store(error_buffer, U16 len)

    var i = 0
    while i < len {
        store(error_buffer + i + 2, U8 input[i])
        i += 1
    }
}


var cycle = -1
var last_command_id = U64 0
var last_level_manual_input = U64 0
var time_component_last = U64 0

def reset_sim() None {

    time_component_last = U64 0

    set_error("")

    global_seed = Seed (get_command(ctl_test) + 1) // 0 can't be seed

    last_level_manual_input = 0
    set_setting(sim_cycle, #U64_HIGH) // -1
    set_setting(sim_short_circuit_component_id_1, U64 0)
    set_setting(sim_short_circuit_component_id_2, U64 0)
    set_setting(sim_test_result, U64 pass)
    cycle = -1

  
    memory_clear(#SIMULATION_KEYBOARD_CHARACTER, 8192)
    memory_clear(#SIMULATION_KEYBOARD_COORDINATE, 8192)
    memory_clear(#SIMULATION_STATE, 705)
    memory_copy(#RESET_DATA_8272137354285170169 - 2048, #DATA_8272137354285170169 - 2048, 16781312)
    memory_clear(#DATA_2711086732312417723 - 2048, 4352)
    memory_copy(#RESET_DATA_2711086732312417723 - 2048, #DATA_2711086732312417723 - 2048, 4352)


}

