            }

    



            if in_scope("check_output") {
                let result = check_output(cycle + 1, level_input, level_output)
                handle_test_result(result)
            }

            
            cycle += 1 // Do this late as it signals to the front end that it can update

        }

        set_setting(sim_cycle, U64 cycle)

        let time_now = get_time()

        let time_diff = U64 (time_now - last_time)

        nanos_per_cycle = time_diff / U64 burst_cycles

        if time_now - last_time > 33.ms() {

            // Burst took too long
            burst_cycles = max(1, burst_cycles - 1)

        } else {

            // Burst was too fast
            burst_cycles = burst_cycles + 1

        }

        #if in_scope("on_ui_update"){

            on_ui_update(level_input, level_output)

        }

        last_time = time_now


        def get_target_cycle(time_now: Time) U64 {
            let time_diff = U64 (time_now - original_start_time)
            return orig_start_cycle + ((time_diff / 1000000) * speed) / 1000000 // Double divide to prevent overflow
        }

        var run_target_cycle = get_target_cycle(time_now)

        // Sleep any ahead of time away
        while cycle > Int run_target_cycle && get_command(ctl_command_id) == last_command_id {

            sleep(1.ms())
            cycle -= 1
            mode_refresh()
            cycle += 1

            run_target_cycle = get_target_cycle(get_time())

        }

    }

}

var manual_input_seen = false

run_sim: while true {

    reset_sim()

    
    const #OP_IO  = 0
    const #OP_ALU = 1
    const #OP_JMP = 2
    const #OP_RAM = 3
    
    const #MAX_RAM = U32 11000
    const #MAX_SSD = U32 1000
    
    var counter   = U32 0
    var registers = array(<U32>, 16)
    var ram       = array(<U8>, #MAX_RAM)
    var ssd       = array(<U8>, #MAX_SSD)
    var saved_time = 0
    var screen_setting = array(<Int>, 8)
    screen_setting[2] = 16777200
    
    add_keyboard_value(true, U8 0xff)
    
    def flag_result(a: U32, b: U32) U32 {
    
        let equal = U32 (a == b)
        let uless = U32 (U32 a < U32 b) & 1
        let sless = U32 (S32 a < S32 b) & 1
    
        return (sless << 2) | (uless << 1) | equal
    
    }
    
    def retire_instruction(instruction: Int, input: Int, output_enabled: Bool, output_value: Int) Bool {
    
        let mode            = (instruction >> 29) & 0b11
        let opcode          = (instruction >> 24) & 0b1111
        let dest            = (instruction >> 20) & 0b1111
        let a               = (instruction >> 16) & 0b1111
        let b               = (instruction >> 8) & 0b1111
        let immediate       = (instruction >> 28) & 1 != 0
        let immediate_value =  U32 (instruction & 0xffff)
    
        let a_value = registers[a]
        let b_value = immediate ? immediate_value : registers[b]
    
        switch mode
    
            case #OP_IO {
    
                const #NOP      = 0
                const #INPUT    = 1
                const #OUTPUT   = 2
                const #KEYBOARD = 3
                const #SCREEN   = 4
                const #TIME_0   = 5
                const #TIME_1   = 6
                const #COUNTER  = 7
    
                switch opcode & 0xf
                    case #INPUT    { registers[dest] = U32 input }
                    case #OUTPUT   {
                        let expected_output = Int b_value
    
                        if !output_enabled {
    
                            set_error(`输出端应处于激活状态。`)
                            return true
                        }
    
                        if output_value != expected_output {
    
                            set_error(`预期的输出为 {expected_output}，但当前输出为 {output_value}。`)
                            return true
    
                        }
    
                    }
                    case #KEYBOARD { registers[dest] = 0x01ff }
                    case #SCREEN   { screen_setting[a_value] = Int b_value }
                    case #TIME_0   {
                        saved_time = get_last_time()
                        registers[dest] = U32 saved_time
                    }
                    case #TIME_1   {
                        registers[dest] = U32 (saved_time >> 32)
    
                        if registers[dest] != U32 get_ram_value("Register File", dest * 4, <U32>) {
                            set_error(`你不应该在两条 time_0 指令之间请求访问系统时间。`)
                            return true
                        }
                    }
                    case #COUNTER  { registers[dest] = counter }
    
                counter += 4
    
            }
    
            case #OP_ALU {
    
                counter += 4
    
                var result = U32 0
    
                switch opcode
                    case 0  { result = ~(a_value &  b_value) }
                    case 1  { result =   a_value |  b_value }
                    case 2  { result =   a_value &  b_value }
                    case 3  { result = ~(a_value |  b_value) }
                    case 4  { result =   a_value +  b_value }
                    case 5  { result =   a_value -  b_value }
                    case 6  { result =   a_value ^  b_value }
                    case 7  { result =   a_value << b_value }
                    case 8  { result =   a_value >> b_value }
                    case 9  { result =  U32 asr(S32 a_value, S32 b_value) }
                    case 10 { result =  flag_result(a_value, b_value) }
    
                registers[dest] = result & 0xffff_ffff
    
            }
    
            case #OP_JMP {
    
                let flags   = Int a_value & 0b111
                let matched = (opcode & flags) > 0
                let met     = matched != ((opcode & 0b1000) > 0)
    
                if met {
    
                    counter = b_value
    
                } else {
    
                    counter += 4
    
                }
    
            }
    
            case #OP_RAM {
                counter += 4
    
                const #LOAD_8    = 0b0000
                const #LOAD_16   = 0b0001
                const #LOAD_32   = 0b0010
                const #PLOAD     = 0b0011
                const #STORE_8   = 0b0100
                const #STORE_16  = 0b0101
                const #STORE_32  = 0b0110
                const #PSTORE    = 0b0111
    
                switch opcode
    
                    case #LOAD_8{
    
                        if b_value < #MAX_RAM - 1 {
    
                            registers[dest] = U32 ram[b_value]
    
                        }
    
                    }
    
                    case #LOAD_16 {
    
                        if b_value < #MAX_RAM - 2 {
    
                            registers[dest] = (U32 ram[b_value] << 8) | (U32 ram[b_value + 1])
    
                        }
    
                    }
    
                    case #LOAD_32 {
    
                        if b_value < #MAX_RAM - 4 {
    
                            registers[dest] = (U32 ram[b_value] << 24) | (U32 ram[b_value + 1] << 16) | (U32 ram[b_value + 2] << 8) | (U32 ram[b_value + 3])
    
                        }
    
                    }
    
                    case #STORE_8 {
    
                        if b_value < #MAX_RAM - 1 {
    
                            ram[b_value + 0] = U8 a_value
    
                        }
    
                    }
    
                    case #STORE_16 {
    
                        if b_value < #MAX_RAM - 2 {
    
                            ram[b_value + 1] = U8 a_value
                            ram[b_value + 0] = U8 (a_value >> 8)
    
                        }
    
                    }
    
                    case #STORE_32 {
    
                        if b_value < #MAX_RAM - 4 {
    
                            ram[b_value + 3] = U8 a_value
                            ram[b_value + 2] = U8 (a_value >> 8)
                            ram[b_value + 1] = U8 (a_value >> 16)
                            ram[b_value + 0] = U8 (a_value >> 24)
    
                        }
    
                    }
    
                    case #PLOAD {
    
                        if b_value < #MAX_SSD - 4 {
    
                            registers[dest] = (U32 ssd[b_value] << 24) | (U32 ssd[b_value + 1] << 16) | (U32 ssd[b_value + 2] << 8) | (U32 ssd[b_value + 3])
    
                        }
    
                    }
    
                    case #PSTORE {
    
                        if b_value < #MAX_SSD - 4 {
    
                            ssd[b_value + 3] = U8 a_value
                            ssd[b_value + 2] = U8 (a_value >> 8)
                            ssd[b_value + 1] = U8 (a_value >> 16)
                            ssd[b_value + 0] = U8 (a_value >> 24)
    
                        }
    
                    }
    
    
            }
    
        registers[0] = 0
    
    }
    
    def get_input(cycle: Int) Input {
    
        if cycle < 0xff {
    
            return Input {input: U32 random(0xff)}
    
        } else {
    
            return Input {input: U32 random(0xffff_ffff)}
    
        }
    
    }
    
    def check_output(cycle: Int, input: Input, output: Output) TestResult {
    
        let actual_counter = get_load_port_input("Instruction")
    
        if U32 actual_counter != counter {
    
            ui_set_instruction(0, 0, 0)
            let expected_value = counter
            set_error(`你应该从主存地址 {expected_value} 处读取下一条指令，但当前的取指地址为 {actual_counter}。请检查你在上一周期是否正确更新了程序计数器的值。`)
            return fail
    
        }
    
        var instruction = get_ram_value("Main Memory", Int counter, <U32>)
        ui_set_instruction(0, Int instruction, Int counter)
    
        let error = retire_instruction(Int instruction, Int input.input, output.output_enabled, Int output.output)
    
        if error {
    
            return fail
    
        }
    
        {
    
            var reg = 0
            while reg < 16 {
    
                let value = U32 get_ram_value("Register File", reg * 4, <U32>)
    
                if value != registers[reg] {
    
                    if reg == 0 {
    
                        set_error(`寄存器'zr'（元件'Register File'的零地址处）的值应该始终为 0。`)
    
                    } else {
    
                        var register = ""
                        switch reg
                            case 14 { register = "'sp'" }
                            case 15 { register = "'flags'" }
                            default { register = `r{reg}`}
    
                        let address = reg * 4
                        let expected_value = "0x" + hex(8, Int registers[reg])
                        let actual_value = "0x" + hex(8, Int value)
                        set_error(`寄存器 {register}（元件'Register File'的地址 {address} 处）的值应为 {expected_value}，而非 {actual_value}。`)
    
                    }
                    return fail
    
                }
    
                reg += 1
    
            }
        }
    
    
        {
            // Tests only use addresses between 10k and 11k to speed up simulation
    
            var i = 10000
    
            while i < 11000 {
                let value = get_ram_value("Main Memory", i, <U8>)
                if ram[i] != value {
                    let expected_value = ram[i]
                    set_error(`主存地址 {i} 处的值应为 {expected_value}，而非 {value}。`)
                    return fail
                }
                i += 1
            }
        }
    
        {
            // Tests only the first 1k
    
            var i = 0
    
            while i < 1000 {
                let value = get_ram_value("Persistent Memory", i, <U8>)
                if ssd[i] != value {
                    let expected_value = ssd[i]
                    set_error(`外存地址 {i} 处的值应为 {expected_value}，而非 {value}。`)
                    return fail
                }
                i += 1
            }
        }
    
        if cycle > 0xfff {
            return win
        }
    
    }
    
    while true {

        mode_refresh()

        #if in_scope("on_ui_update"){

            on_ui_update(level_input, level_output)

        }

        while get_command(ctl_command_id) == last_command_id {

            #if in_scope("on_manual_input"){

                if last_level_manual_input != get_command(ctl_level_manual_input_id) {

                    last_level_manual_input = get_command(ctl_level_manual_input_id)
                    on_manual_input(Int get_command(ctl_level_manual_input))
                    manual_input_seen = true

                }

            }

            sleep(1.ms())

        }

        if manual_input_seen {

            manual_input_seen = false
            break

        }

        last_command_id = get_command(ctl_command_id) // Read this before the command in case of race condition
        set_setting(sim_last_command_id, last_command_id)
        var command = SimCommand get_command(ctl_command)

        switch command

            case run {

                var target_cycle = Int get_setting(sim_target_cycle)

                set_setting(sim_running, U64 1)
                mode_run(target_cycle)
                set_setting(sim_running, U64 0)

            }

            case refresh {}

            case mode_reset {

                var i = 0
                while i < 1024 {
                    input_replay[i] = ctl_input_replay_reset[i]
                    i += 1
                }

                break

            }

            case quit_simulation {

                break run_sim // We need to break out instead of thread_exit() to make sure everything is cleaned up

            }

    }

}

