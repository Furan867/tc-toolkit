def get_ram_value(label: Str, address: Int, size: @Size) @Size {
    if label == 'PC' { return load(type_of(size), #DATA_7593716000034673336 + (65536 - ((size(size) + 7) / 8)) - address)) } 
    if label == 'Register' { return load(type_of(size), #DATA_695063444483381813 + (128 - ((size(size) + 7) / 8)) - address)) } 
    if label == 'RAM' { return load(type_of(size), #DATA_7200939462095588078 + (65536 - ((size(size) + 7) / 8)) - address)) } 
    if label == 'CSR' { return load(type_of(size), #DATA_4820774215871498540 + (16384 - ((size(size) + 7) / 8)) - address)) } 
}
def set_ram_value(label: Str, offset: Int, value: @Type) None {
    if label == 'PC' { store(#DATA_7593716000034673336 + 65536 - offset - (size(value) + 7) / 8, value) }
    if label == 'Register' { store(#DATA_695063444483381813 + 128 - offset - (size(value) + 7) / 8, value) }
    if label == 'RAM' { store(#DATA_7200939462095588078 + 65536 - offset - (size(value) + 7) / 8, value) }
    if label == 'CSR' { store(#DATA_4820774215871498540 + 16384 - offset - (size(value) + 7) / 8, value) }
}

const #CYCLE_PAST_FAIL = 0
def max(a: TestResult, b: TestResult) TestResult {
    return TestResult max(U64 a, U64 b)
}

def set_error(input: Str) None {

    let len = input.len()

    store(error_buffer, U16 len)

    var i = 0
    while i < len {
        store(error_buffer + i + 2, U8 input[i])
        i += 1
    }
}


var cycle = -1
var last_command_id = U64 0
var last_level_manual_input = U64 0
var time_component_last = U64 0

def reset_sim() None {

    time_component_last = U64 0

    set_error("")

    global_seed = Seed (get_command(ctl_test) + 1) // 0 can't be seed

    last_level_manual_input = 0
    set_setting(sim_cycle, #U64_HIGH) // -1
    set_setting(sim_short_circuit_component_id_1, U64 0)
    set_setting(sim_short_circuit_component_id_2, U64 0)
    set_setting(sim_test_result, U64 pass)
    cycle = -1

  
    memory_clear(#SIMULATION_KEYBOARD_CHARACTER, 8192)
    memory_clear(#SIMULATION_KEYBOARD_COORDINATE, 8192)
    memory_clear(#SIMULATION_STATE, 2412)
    memory_copy(#RESET_DATA_7593716000034673336 - 2048, #DATA_7593716000034673336 - 2048, 69632)
    memory_clear(#DATA_695063444483381813 - 2048, 4224)
    memory_copy(#RESET_DATA_695063444483381813 - 2048, #DATA_695063444483381813 - 2048, 4224)
    memory_clear(#DATA_7200939462095588078 - 2048, 69632)
    memory_copy(#RESET_DATA_7200939462095588078 - 2048, #DATA_7200939462095588078 - 2048, 69632)
    memory_clear(#DATA_4820774215871498540 - 2048, 20480)
    memory_copy(#RESET_DATA_4820774215871498540 - 2048, #DATA_4820774215871498540 - 2048, 20480)


}

