def get_ram_value(label: Str, address: Int, size: @Size) @Size {
    if label == 'RAM (4Kb)' { return load(type_of(size), #DATA_9069292848098966978 + address) } 
    if label == 'Register file' { return load(type_of(size), #DATA_165130996389120186 + address) } 
    if label == 'Disk' { return load(type_of(size), #DATA_5118628084891258796 + address) } 
    if label == 'display' { return load(type_of(size), #DATA_6257934837948485986 + address) } 
}
def set_ram_value(label: Str, offset: Int, value: @Type) None {
    if label == 'RAM (4Kb)' { store(#DATA_9069292848098966978 + offset, value) }
    if label == 'Register file' { store(#DATA_165130996389120186 + offset, value) }
    if label == 'Disk' { store(#DATA_5118628084891258796 + offset, value) }
    if label == 'display' { store(#DATA_6257934837948485986 + offset, value) }
}

const #CYCLE_PAST_FAIL = 0
def max(a: TestResult, b: TestResult) TestResult {
    return TestResult max(U64 a, U64 b)
}

def set_error(input: Str) None {

    let len = input.len()

    store(error_buffer, U16 len)

    var i = 0
    while i < len {
        store(error_buffer + i + 2, U8 input[i])
        i += 1
    }
}


var cycle = -1
var last_command_id = U64 0
var last_level_manual_input = U64 0
var time_component_last = U64 0

def reset_sim() None {

    time_component_last = U64 0

    set_error("")

    global_seed = Seed (get_command(ctl_test) + 1) // 0 can't be seed

    last_level_manual_input = 0
    set_setting(sim_cycle, #U64_HIGH) // -1
    set_setting(sim_short_circuit_component_id_1, U64 0)
    set_setting(sim_short_circuit_component_id_2, U64 0)
    set_setting(sim_test_result, U64 pass)
    cycle = -1

  
    memory_clear(#SIMULATION_KEYBOARD_CHARACTER, 8192)
    memory_clear(#SIMULATION_KEYBOARD_COORDINATE, 8192)
    memory_clear(#SIMULATION_STATE, 3903)
    memory_copy(#RESET_DATA_9069292848098966978 - 2048, #DATA_9069292848098966978 - 2048, 8192)
    memory_clear(#DATA_165130996389120186 - 2048, 4224)
    memory_copy(#RESET_DATA_165130996389120186 - 2048, #DATA_165130996389120186 - 2048, 4224)
    memory_clear(#DATA_5118628084891258796 - 2048, 5120)
    memory_copy(#RESET_DATA_5118628084891258796 - 2048, #DATA_5118628084891258796 - 2048, 5120)
    store(Ptr 2416623029771, 0xfffff0)
    memory_clear(#DATA_6257934837948485986 - 2048, 69632)
    memory_copy(#RESET_DATA_6257934837948485986 - 2048, #DATA_6257934837948485986 - 2048, 69632)


}

