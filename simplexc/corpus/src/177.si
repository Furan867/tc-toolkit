            var count_1 = load(<U16>, #SETTINGS_9069292848098966978)
            var start_1 = #SETTINGS_9069292848098966978 + 2
            var finish_1 = start_1 + Int (count_1 * 2)
            while Int start_1 < Int finish_1 {
                if Int load(<U16>, start_1) == logic_idx_1 {
                    halt()
                    break
                }
                start_1 += 2
            }

    
