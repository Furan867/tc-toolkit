def get_ram_value(label: Str, address: Int, size: @Size) @Size {
    if label == '' { return load(type_of(size), #DATA_327787438259478877 + address) } 
    if label == '' { return load(type_of(size), #DATA_1732684347185311229 + address) } 
    if label == '' { return load(type_of(size), #DATA_4965524332314579751 + address) } 
}
def set_ram_value(label: Str, offset: Int, value: @Type) None {
    if label == '' { store(#DATA_327787438259478877 + offset, value) }
    if label == '' { store(#DATA_1732684347185311229 + offset, value) }
    if label == '' { store(#DATA_4965524332314579751 + offset, value) }
}

const #CYCLE_PAST_FAIL = 0
def max(a: TestResult, b: TestResult) TestResult {
    return TestResult max(U64 a, U64 b)
}

def set_error(input: Str) None {

    let len = input.len()

    store(error_buffer, U16 len)

    var i = 0
    while i < len {
        store(error_buffer + i + 2, U8 input[i])
        i += 1
    }
}


var cycle = -1
var last_command_id = U64 0
var last_level_manual_input = U64 0
var time_component_last = U64 0

def reset_sim() None {

    time_component_last = U64 0

    set_error("")

    global_seed = Seed (get_command(ctl_test) + 1) // 0 can't be seed

    last_level_manual_input = 0
    set_setting(sim_cycle, #U64_HIGH) // -1
    set_setting(sim_short_circuit_component_id_1, U64 0)
    set_setting(sim_short_circuit_component_id_2, U64 0)
    set_setting(sim_test_result, U64 pass)
    cycle = -1

  
    memory_clear(#SIMULATION_KEYBOARD_CHARACTER, 8192)
    memory_clear(#SIMULATION_KEYBOARD_COORDINATE, 8192)
    memory_clear(#SIMULATION_STATE, 3287)
    store(Ptr 2416623029004, 0xfffff0)
    memory_copy(#RESET_DATA_327787438259478877 - 2048, #DATA_327787438259478877 - 2048, 67112960)
    memory_clear(#DATA_1732684347185311229 - 2048, 4352)
    memory_copy(#RESET_DATA_1732684347185311229 - 2048, #DATA_1732684347185311229 - 2048, 4352)
    store(Ptr 2416623029172, 0xfffff0)
    memory_clear(#DATA_4965524332314579751 - 2048, 4352)
    memory_copy(#RESET_DATA_4965524332314579751 - 2048, #DATA_4965524332314579751 - 2048, 4352)


}

