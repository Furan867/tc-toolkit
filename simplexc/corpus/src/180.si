def get_ram_value(label: Str, address: Int, size: @Size) @Size {
    if label == '内存' { return load(type_of(size), #DATA_7069020504170261741 + address) } 
    if label == '寄存器堆' { return load(type_of(size), #DATA_4620396928043218538 + (128 - ((size(size) + 7) / 8)) - address)) } 
    if label == '显存' { return load(type_of(size), #DATA_7585293127307814633 + address) } 
    if label == '设备寄存器' { return load(type_of(size), #DATA_1757052846952780449 + address) } 
}
def set_ram_value(label: Str, offset: Int, value: @Type) None {
    if label == '内存' { store(#DATA_7069020504170261741 + offset, value) }
    if label == '寄存器堆' { store(#DATA_4620396928043218538 + 128 - offset - (size(value) + 7) / 8, value) }
    if label == '显存' { store(#DATA_7585293127307814633 + offset, value) }
    if label == '设备寄存器' { store(#DATA_1757052846952780449 + offset, value) }
}

const #CYCLE_PAST_FAIL = 0
def max(a: TestResult, b: TestResult) TestResult {
    return TestResult max(U64 a, U64 b)
}

def set_error(input: Str) None {

    let len = input.len()

    store(error_buffer, U16 len)

    var i = 0
    while i < len {
        store(error_buffer + i + 2, U8 input[i])
        i += 1
    }
}


var cycle = -1
var last_command_id = U64 0
var last_level_manual_input = U64 0
var time_component_last = U64 0

def reset_sim() None {

    time_component_last = U64 0

    set_error("")

    global_seed = Seed (get_command(ctl_test) + 1) // 0 can't be seed

    last_level_manual_input = 0
    set_setting(sim_cycle, #U64_HIGH) // -1
    set_setting(sim_short_circuit_component_id_1, U64 0)
    set_setting(sim_short_circuit_component_id_2, U64 0)
    set_setting(sim_test_result, U64 pass)
    cycle = -1

  
    memory_clear(#SIMULATION_KEYBOARD_CHARACTER, 8192)
    memory_clear(#SIMULATION_KEYBOARD_COORDINATE, 8192)
    memory_clear(#SIMULATION_STATE, 3030)
    memory_copy(#RESET_DATA_7069020504170261741 - 2048, #DATA_7069020504170261741 - 2048, 134221824)
    memory_clear(#DATA_4620396928043218538 - 2048, 4224)
    memory_copy(#RESET_DATA_4620396928043218538 - 2048, #DATA_4620396928043218538 - 2048, 4224)
    store(Ptr 2416623028791, 0xfffff0)
    store(Ptr 2416623028903, 0xfffff0)
    memory_clear(#DATA_7585293127307814633 - 2048, 8392704)
    memory_copy(#RESET_DATA_7585293127307814633 - 2048, #DATA_7585293127307814633 - 2048, 8392704)
    memory_copy(#RESET_DATA_1757052846952780449 - 2048, #DATA_1757052846952780449 - 2048, 5120)


}

